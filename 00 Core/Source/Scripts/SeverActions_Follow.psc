Event OnInit()
    Debug.Trace("[SeverActions_Follow] Initialized")
    RegisterForModEvent("SeverActionsNative_SandboxCleanup", "OnNativeSandboxCleanup")
    RegisterForModEvent("SeverActions_SafeInteriorReEval", "OnSafeInteriorReEval")
    RegisterForModEvent("SeverActions_SafeInteriorReassert", "OnSafeInteriorReassert")
    RegisterForModEvent("SeverActions_SafeInteriorRelease", "OnSafeInteriorRelease")
    RegisterForModEvent("SeverActions_CampMuster", "OnCampMusterEvent")
    RegisterForModEvent("SeverActions_CampMemberSeen", "OnCampMemberSeen")
    RegisterForModEvent("SeverActions_CasualFollowRecycle", "OnCasualFollowRecycle")
    RegisterForModEvent("SeverActions_CampMemberDied", "OnCampMemberDied")
    RegisterForModEvent("SeverActions_CampReleased", "OnCampReleased")
EndEvent

; Resolve which sandbox package to use for auto safe-interior. Prefers the distinct
; SafeInteriorSandboxPackage (Phase 5 Fix D) so users can visually tell the manual
; wait sandbox and the auto safe-interior sandbox apart. Falls back to the shared
; SandboxPackage when SafeInteriorSandboxPackage isn't assigned in CK.
Package Function GetSafeInteriorPackage()
    If SafeInteriorSandboxPackage
        Return SafeInteriorSandboxPackage
    EndIf
    Return SandboxPackage
EndFunction

Event OnSkyrimNetPackageRemoved(Form akSender, Form akPackage)
    {SkyrimNet removed a package from an actor. Re-verify rather than trusting
     the passed Package form: comparing forms would mean resolving SkyrimNet's
     FollowPlayer package by name/EditorID, and HasPackage answers the real
     question directly - does SkyrimNet still consider this actor to be
     following? Cheap, and immune to whatever the removed package was.}
    Actor akActor = akSender as Actor
    If !akActor
        Return
    EndIf
    VerifyCasualFollowPackage(akActor)
EndEvent

Bool Function VerifyCasualFollowPackage(Actor akActor)
    {Clear hasFollowPkg when SkyrimNet no longer has a FollowPlayer package on
     this actor. Returns TRUE if the flag was stale and got cleared.

     ONLY touches casual followers - a registered companion's follow state is
     owned by the roster, not by SkyrimNet's package list, and track-only
     followers (NFF / custom AI) legitimately have no SkyrimNet package at all.
     Clearing either of those here would break them.}
    If !akActor
        Return false
    EndIf
    If SeverActionsNativeExt.Native_GetIsFollower(akActor)
        Return false
    EndIf
    If !SeverActionsNative.Native_GetHasFollowPkg(akActor)
        Return false
    EndIf
    ; Pool-seated casual (the mechanism since the pool migration) — healthy;
    ; the alias package needs no SkyrimNet registration to be real.
    If IsInFollowerSlot(akActor)
        Return false
    EndIf
    If SkyrimNetApi.HasPackage(akActor, "FollowPlayer") > 0
        Return false
    EndIf
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)
    Debug.Trace("[SeverActions_Follow] Cleared stale follow flag on " + akActor.GetDisplayName()         + " - SkyrimNet has no FollowPlayer package; they will no longer be pulled through load doors")
    Return true
EndFunction

Int Function VerifyCasualFollowPackages()
    {Sweep every casual follower and clear the ones whose SkyrimNet package is
     gone. Returns how many were healed.

     This is the half that fixes EXISTING saves: the OnPackageRemoved listener
     prevents new drift, but a flag that went stale before the listener existed
     is only fixable by re-checking. Cheap - the casual set is small, and this
     runs on load, not per frame.}
    Actor[] casuals = SeverActionsNativeExt.Native_GetCasualFollowers()
    If !casuals || casuals.Length == 0
        Return 0
    EndIf
    Int cleared = 0
    Int i = 0
    Int residue = 0
    While i < casuals.Length
        If VerifyCasualFollowPackage(casuals[i])
            cleared += 1
        ElseIf casuals[i] && !SeverActionsNativeExt.Native_GetIsFollower(casuals[i])
            If IsInFollowerSlot(casuals[i])
                ; Pool-seated casuals must re-register with OrphanCleanup on
                ; EVERY load (the registry is cleared at kPostLoadGame) or the
                ; follow LinkedRef is stripped ~5s in and they wander off.
                SeverActionsNative.OrphanCleanup_RegisterFollower(casuals[i])
            ElseIf SkyrimNetApi.HasPackage(casuals[i], "FollowPlayer") > 0
                ; Legacy casual (pre-pool zip) still riding the SkyrimNet
                ; override — migrate onto the pool so they stop dropping at
                ; load doors. One mechanism only after this.
                If SeverActions_FollowerFollowKW
                    SeverActionsNative.LinkedRef_Set(casuals[i], Game.GetPlayer(), SeverActions_FollowerFollowKW)
                EndIf
                AssignFollowerSlot(casuals[i])
                SeverActionsNative.OrphanCleanup_RegisterFollower(casuals[i])
                SkyrimNetApi.UnregisterPackage(casuals[i], "FollowPlayer")
                casuals[i].EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Migrated casual follower " + casuals[i].GetDisplayName() + " onto the follow pool")
            EndIf
        EndIf
        ; Residue heal for afflicted saves: rank -1 = a stale
        ; RemoveFromFaction leftover that reads as WAITING to rank-blind
        ; checks (legit waiting = rank 0, untouched). NOTE: vanilla
        ; GetFactionRank ALSO returns -1 for a genuine non-member (its
        ; documented contract; there is no -2 - an earlier comment here
        ; claimed one), so this branch can match a never-member too - but
        ; Faction_RemoveClean is a harmless no-op when there is nothing to
        ; erase, so healing on -1 is safe either way.
        If SeverActions_WaitingFaction && casuals[i] && casuals[i].GetFactionRank(SeverActions_WaitingFaction) == -1
            SeverActionsNativeExt2.Faction_RemoveClean(casuals[i], SeverActions_WaitingFaction)
            residue += 1
        EndIf
        i += 1
    EndWhile
    If residue > 0
        Debug.Trace("[SeverActions_Follow] VerifyCasualFollowPackages: erased " + residue + " stale waiting-faction residue(s)")
    EndIf
    If cleared > 0
        Debug.Trace("[SeverActions_Follow] VerifyCasualFollowPackages: cleared " + cleared             + " stale follow flag(s) of " + casuals.Length + " casual follower(s)")
    EndIf
    Return cleared
EndFunction

; Called on game load to re-register events and restore state
Function Maintenance()
    RegisterForModEvent("SeverActionsNative_SandboxCleanup", "OnNativeSandboxCleanup")
    RegisterForModEvent("SeverActions_ExternalWaitAdopt", "OnExternalWaitAdopt")
    RegisterForModEvent("SeverActions_SafeInteriorChanged", "OnSafeInteriorChanged")
    RegisterForModEvent("SeverActions_SafeInteriorToggle", "OnSafeInteriorToggle")
    RegisterForModEvent("SeverActions_PauseOnOpenToggle",  "OnPauseOnOpenToggle")
    RegisterForModEvent("SeverActions_TravelPopupToggle",  "OnTravelPopupToggle")
    RegisterForModEvent("SeverActions_TravelPopupFollowersOnly", "OnTravelPopupFollowersOnly")
    RegisterForModEvent("SeverActions_LLMTrespassToggle",  "OnLLMTrespassToggle")
    RegisterForModEvent("SeverActions_FriendlyFireToggle", "OnFriendlyFireToggle")
    RegisterForModEvent("SeverActions_YieldPromptToggle",  "OnYieldPromptToggle")
    ; Phase 5 Fix C — deferred safe-interior re-evaluation: C++ fires this ~500ms
    ; after the initial enter event so the engine picks up our override even if the
    ; first EvaluatePackage raced with a cell transition / AI busy state.
    RegisterForModEvent("SeverActions_SafeInteriorReEval", "OnSafeInteriorReEval")
    ; Self-heal: C++ fires this when it finds an active sandboxing follower
    ; stranded on a runtime FF/FE fallback (the override lost the eval or a
    ; cell transition/load knocked it off). Unlike the re-eval above, the
    ; handler RE-ADDS the override — a bare EvaluatePackage was proven not to
    ; recover them (field 2026-08-30).
    RegisterForModEvent("SeverActions_SafeInteriorReassert", "OnSafeInteriorReassert")
    ; Reclaim reconciliation: C++ fires this when a TRACK-ONLY sandboxing follower
    ; is found being driven by her own framework's follow package — we let go and
    ; strip our lingering override (no teleport/re-drive). The mirror of Reassert.
    RegisterForModEvent("SeverActions_SafeInteriorRelease", "OnSafeInteriorRelease")
    ; SkyrimNet tells us when it takes a package OFF an actor. Our hasFollowPkg
    ; flag is set when WE call RegisterPackage and cleared on StopFollowing /
    ; WaitHere - so any removal by another route (SkyrimNet's own cleanup,
    ; ClearAllPackages, another mod, an interrupted script) used to leave the
    ; flag set forever, and cell catch-up kept dragging that NPC around. This
    ; closes the loop at the source.
    RegisterForModEvent("SkyrimNet_OnPackageRemoved", "OnSkyrimNetPackageRemoved")
    ; Camp war-band muster (Phase 3) - fired by the PrismaUI handler (queued
    ; to menu close, when the game is unpaused) and by Camp_Renounce's
    ; unwind. strArg = signed-decimal camp location FormID, numArg 1 = rally
    ; / 0 = send home.
    RegisterForModEvent("SeverActions_CampMuster", "OnCampMusterEvent")
    RegisterForModEvent("SeverActions_CampMemberSeen", "OnCampMemberSeen")
    RegisterForModEvent("SeverActions_CasualFollowRecycle", "OnCasualFollowRecycle")
    RegisterForModEvent("SeverActions_CampMemberDied", "OnCampMemberDied")
    RegisterForModEvent("SeverActions_CampReleased", "OnCampReleased")
    ; Retainer left service (dismissed / deserted / hostile) — native pings us
    ; per stale holder from the venture heartbeat; we free that alias so the
    ; ex-retainer can despawn/respawn normally again. sender = the actor.
    RegisterForModEvent("SeverActions_RetainerUnpersist", "OnRetainerUnpersist")
    ; One muster-pump kick per load: resumes outstanding travel ETAs AND the
    ; war-band catch-up for arrived members (the pump runs for the muster's
    ; whole life). With no seated members it runs one quiet scan and goes
    ; back to sleep.
    RegisterForSingleUpdateGameTime(0.1)
    ; Persistence-pool janitor, once per load: frees aliases whose holders
    ; no longer belong to a sworn camp (released while the listener was
    ; dead, confirmed corpses, stale rows).
    SweepCampPersistPool()
    ; Same janitor for the retainer pool: free aliases whose holder is no longer
    ; an active retainer (dismissed/deserted across a save boundary). The
    ; heartbeat ModEvent handles mid-session frees; this is the load-time belt.
    SweepRetainerPersistPool()

    ; Heal any flag that ALREADY went stale. The listener above only prevents
    ; NEW drift - it can do nothing about saves where the flag is wrong today,
    ; which is exactly the reported bug. Runs once per load.
    VerifyCasualFollowPackages()

    ; Restore safe interior sandbox setting from StorageUtil → push to C++
    Quest SeverActionsQuest = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as Quest
    If SeverActionsQuest
        ; Phase 10 — default to DISABLED (0) if key never written. The feature
        ; races with Skyrim's door-transition timing in ways that cause
        ; FF runtime fallback packages and exit stickiness. Users who want it
        ; can enable via PrismaUI. Existing users who had it on keep their
        ; setting — the StorageUtil key persists across game loads.
        Bool savedEnabled = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_SafeInteriorEnabled", 0) == 1
        SeverActionsNativeExt.SituationMonitor_SetSafeInteriorEnabled(savedEnabled)
        Debug.Trace("[SeverActions_Follow] Restored safe interior sandbox: " + savedEnabled)

        ; Restore PrismaUI pause-on-open setting. Default 1 (paused) preserves legacy
        ; behavior — only users who have explicitly disabled it see the unpaused path.
        Bool savedPauseOnOpen = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_PauseOnOpen", 1) == 1
        SeverActionsNative.PrismaUI_SetPauseOnOpen(savedPauseOnOpen)
        Debug.Trace("[SeverActions_Follow] Restored PrismaUI pause on open: " + savedPauseOnOpen)

        ; Restore the travel-destination popup toggle. Default 1 (show popup)
        ; preserves legacy behavior; users who turned it off keep their 0.
        Bool savedTravelPopup = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_TravelPopupEnabled", 1) == 1
        SeverActionsNative.PrismaUI_SetTravelPopupEnabled(savedTravelPopup)
        Debug.Trace("[SeverActions_Follow] Restored travel popup enabled: " + savedTravelPopup)

        ; Restore the followers-only popup scope. Default 0 (popup for every
        ; traveler) preserves legacy behavior.
        Bool savedPopupScope = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_TravelPopupFollowersOnly", 0) == 1
        SeverActionsNative.PrismaUI_SetTravelPopupFollowersOnly(savedPopupScope)
        Debug.Trace("[SeverActions_Follow] Restored travel popup followers-only: " + savedPopupScope)

        ; Restore LLM-driven trespass. Default 1 (on) - suppress the vanilla
        ; warn-follow loop and let the confrontation play out in dialogue.
        Bool savedLLMTrespass = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_LLMTrespassEnabled", 1) == 1
        SeverActionsNativeExt.Native_Trespass_SetLLMMode(savedLLMTrespass)
        Debug.Trace("[SeverActions_Follow] Restored LLM trespass mode: " + savedLLMTrespass)

        ; Restore the yield/surrender prompt-exposure toggle. Stored on None
        ; (global) because the 0160 combat prompt reads it via papyrus_util
        ; GetIntValue with actor 0. Default 1 (on) preserves legacy behavior.
        Bool savedYieldPrompt = StorageUtil.GetIntValue(None, "SeverActions_YieldPromptEnabled", 1) == 1
        SeverActionsNative.PrismaUI_SetYieldPromptEnabled(savedYieldPrompt)
        Debug.Trace("[SeverActions_Follow] Restored yield prompt exposure: " + savedYieldPrompt)

        ; Restore follower friendly-fire prevention. Default 1 (enabled) —
        ; users who have explicitly disabled it keep their 0 in StorageUtil;
        ; everyone else gets protection on by default. When on, also re-apply
        ; the raised ally-hit thresholds since game settings reset to ESP/INI
        ; defaults on load and we can't cosave them.
        Bool savedFriendlyFire = StorageUtil.GetIntValue(SeverActionsQuest, "SeverActions_PreventFollowerFF", 1) == 1
        SeverActionsNative.FriendlyFireMonitor_SetEnabled(savedFriendlyFire)
        If savedFriendlyFire
            Game.SetGameSettingInt("iAllyHitCombatAllowed", 100)
            Game.SetGameSettingInt("iAllyHitNonCombatAllowed", 50)
        EndIf
        Debug.Trace("[SeverActions_Follow] Restored follower friendly-fire prevention: " + savedFriendlyFire)
    EndIf

    ; Phase 11 — reconcile stranded safe-interior sandbox on load. The package
    ; override + the SeverActions_InSafeInteriorSandbox flag both persist in the
    ; save, but the native SituationMonitor's inSafeInterior state is transient
    ; (empty after a fresh launch), so a follower who was auto-sandboxing at save
    ; time — or whose package never got cleaned up because the feature was later
    ; disabled — is left stuck with no native transition left to fire the exit.
    ; Walk the roster and force the exit for anyone still flagged;
    ; ExitSafeInteriorSandbox self-gates on the flag, so unflagged followers no-op.
    Actor[] reconFollowers = SeverActionsNative.Native_GetAllTrackedFollowers()
    Int reconIdx = 0
    While reconIdx < reconFollowers.Length
        ExitSafeInteriorSandbox(reconFollowers[reconIdx])
        reconIdx += 1
    EndWhile
EndFunction

; =============================================================================
; SANDBOX STATE HELPERS
; Native FollowerDataStore.isSandboxing is the source of truth, replacing the
; broken SkyrimNetApi.HasPackage("Sandbox"): "Sandbox" isn't in SkyrimNet's
; PackageFormCache, so RegisterPackage always fails and HasPackage returns false.
; =============================================================================

Bool Function IsSandboxing(Actor akActor)
    {Phase 4B: FollowerDataStore.isSandboxing is the source of truth.}
    return akActor && SeverActionsNativeExt.Native_GetSandboxing(akActor)
EndFunction

Function SetSandboxFlag(Actor akActor, Bool active)
    If akActor
        SeverActionsNative.Native_SetSandboxing(akActor, active)
    EndIf
EndFunction

; =============================================================================
; NATIVE SANDBOX CLEANUP EVENT HANDLER
; Called by native SandboxManager when player changes cells or moves too far
; =============================================================================

Event OnNativeSandboxCleanup(string eventName, string strArg, float numArg, Form sender)
    Actor akActor = sender as Actor
    if !akActor
        akActor = Game.GetFormEx(numArg as int) as Actor
    endif

    if !akActor
        return
    endif

    ; Only handle actors that are sandboxing through our system
    if !IsSandboxing(akActor)
        return
    endif

    Debug.Trace("[SeverActions_Follow] Native sandbox cleanup for: " + akActor.GetDisplayName())

    ; Clear waiting state FIRST — so the follow package becomes eligible
    ; before the sandbox override is removed, preventing FF-prefix runtime sandbox.
    akActor.SetAV("WaitingForPlayer", 0)
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Clear sandbox state
    SetSandboxFlag(akActor, false)

    ; Now safe to remove sandbox package
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Back to actively following — AI resumes follow naturally, no forced eval.
    ; Only when a follow actually exists to resume: a dismissed/homed NPC gets
    ; no follow package, and a stale flag silently freezes their work schedule
    ; (issue #14 regression — the schedule guards read this faction).
    If IsInFollowerSlot(akActor) || SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
        SetActivelyFollowing(akActor, true)
    EndIf

    ; Schedule alias pools: sandbox control ended — refill the NPC's schedule
    ; alias when they're actually dismissed/homed. Reconcile's internal guards
    ; make this a no-op when follow just resumed above.
    SeverActions_FollowerManager fmCleanup = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmCleanup
        fmCleanup.RefillSchedAliasesAfterStop(akActor)
    EndIf

    Debug.Notification(akActor.GetDisplayName() + " stopped relaxing.")
    RegisterFollowStateEvent(akActor, "follower_relax_stopped", akActor.GetDisplayName() + " stops relaxing and catches up with " + Game.GetPlayer().GetDisplayName() + ".")
EndEvent

; =============================================================================
; SAFE INTERIOR AUTO-SANDBOX
; Fired by native SituationMonitor when a following companion enters/exits
; a safe interior (inn, home, shop, temple, town interior).
; =============================================================================

Event OnSafeInteriorChanged(String eventName, String strArg, Float numArg, Form sender)
    ; strArg format: "enter|0xFormID" or "exit|0xFormID"
    Int pipePos = StringUtil.Find(strArg, "|")
    If pipePos < 0
        Return
    EndIf

    String changeType = StringUtil.Substring(strArg, 0, pipePos)
    ; Resolve the actor from the SENDER form, NOT the hex strArg. Game.GetForm
    ; returns None for a FormID past 0x7FFFFFFF (a high load-order index, e.g.
    ; Rin 0xC311C096) - Papyrus's signed Int overflows - which silently no-op'd
    ; the enter for every high-index follower. Native now passes the actor as
    ; sender; keep a Game.GetFormEx (full-range, unlike Game.GetForm) fallback
    ; off the strArg for safety.
    Actor akActor = sender as Actor
    If !akActor
        String formIdStr = StringUtil.Substring(strArg, pipePos + 1)
        akActor = Game.GetFormEx(SeverActionsNative.HexToInt(formIdStr)) as Actor
    EndIf
    If !akActor
        Return
    EndIf

    ; Don't override manual sandbox/wait commands or home-sandboxing NPCs
    If akActor.GetAV("WaitingForPlayer") > 0
        Return
    EndIf
    ; Skip dismissed NPCs sandboxing at home — they're not active followers,
    ; the safe interior system shouldn't touch their home sandbox package.
    ; Active followers with homes assigned should still get safe interior sandbox.
    If SeverActionsNative.Native_GetHomeMarkerSlot(akActor) >= 0
        SeverActions_FollowerManager fm = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
        If fm && !fm.IsRegisteredFollower(akActor)
            Return
        EndIf
    EndIf

    If changeType == "enter"
        ; Track-only followers (NFF / DLC / CustomAI) ARE allowed to safe-
        ; interior sandbox — the enter only lays a temporary high-priority
        ; override, which the exit cleanly removes. The one thing that would
        ; fight their framework is re-driving them with SA follow on the way
        ; OUT, so that is branched in ExitSafeInteriorSandbox, not blocked here.
        Package interiorPkg = GetSafeInteriorPackage()
        If interiorPkg && !IsSandboxing(akActor)
            ; Phase 5 Fix A — match manual Sandbox() ordering so casual followers'
            ; SkyrimNet package doesn't race with our override (SkyrimNet's hook
            ; returns its own FollowPlayer regardless of PO3 priority, causing
            ; the FE/FF fallback when the follower is in a door transition).
            ;
            ; Apply override FIRST so there's always a valid high-priority package.
            ; 4th arg 0 = no AI reset — gentler transition. Combined with the
            ; EvaluatePackage below, the AI picks up the new override without
            ; the procedural-state churn that flag=1 caused.
            ActorUtil.AddPackageOverride(akActor, interiorPkg, SafeInteriorSandboxPriority, 0)

            ; Kill the SkyrimNet FollowPlayer registration for casual followers.
            ; Safe no-op for companions (they use CK alias package, not SkyrimNet).
            SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

            ; Kill the CK alias follow package's eligibility condition
            ; (SeverActions_FollowPlayerPackage gates on WaitingForPlayer == 0).
            ;
            ; TRACK-ONLY followers (NFF / DLC / CustomAI like Rin) do NOT ride
            ; SA's CK alias follow — their OWN framework drives follow, and that
            ; framework's follow package ALSO gates on WaitingForPlayer == 0.
            ; Setting WFP=1 for them collaterally disables their framework follow,
            ; so if the priority-100 sandbox override ever loses its tie against a
            ; framework that re-asserts its own package (NFF), the engine has NO
            ; eligible follow left and drops them onto a PINNING runtime FF/FE
            ; fallback — the intermittent "stuck without the sandbox package"
            ; field report. Leaving WFP=0 keeps their framework follow eligible as
            ; a harmless fallback: the override still relaxes them when it wins,
            ; and a lost contest degrades to framework-follow instead of a pin.
            ; The relax comes from the override, never from WFP, so skipping the
            ; write does not affect sandboxing. (SA-owned followers still need it
            ; to suppress the CK alias follow SA itself drives.)
            SeverActions_FollowerManager fmEnter = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
            If !(fmEnter && fmEnter.IsTrackOnlyFollower(akActor))
                akActor.SetAV("WaitingForPlayer", 1)
            EndIf

            SetSandboxFlag(akActor, true)
            StorageUtil.SetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 1)
            SeverActionsNative.Native_SetSandboxing(akActor, true)
            SetActivelyFollowing(akActor, false)

            ; Add the waiting faction so other mods (IntelEngine, etc.) treat
            ; a safe-interior-sandboxing follower the same way they treat a
            ; manually waiting one — consistent external signal.
            If SeverActions_WaitingFaction
                akActor.AddToFaction(SeverActions_WaitingFaction)
            EndIf

            akActor.EvaluatePackage()
            Debug.Trace("[SeverActions_Follow] Safe interior sandbox: " + akActor.GetDisplayName() + " is relaxing")
        EndIf
    ElseIf changeType == "exit"
        ExitSafeInteriorSandbox(akActor)
    EndIf
EndEvent

Function ExitSafeInteriorSandbox(Actor akActor)
    {Tear down an active safe-interior auto-sandbox: remove the package
    override(s), restore follow eligibility, teleport to the player, and
    re-evaluate. No-op when the actor isn't currently flagged
    SeverActions_InSafeInteriorSandbox, so it's safe to call speculatively —
    e.g. the on-load reconcile in Maintenance() that walks the whole roster.}
    If akActor
        If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) == 1
            StorageUtil.UnsetIntValue(akActor, "SeverActions_InSafeInteriorSandbox")
            SetSandboxFlag(akActor, false)
            SeverActionsNative.Native_SetSandboxing(akActor, false)

            ; Phase 7 — aggressive multi-remove.
            ; User testing of Phase 6 found that `resetai` on a stuck companion
            ; returns them to the sandbox package and they walk back inside.
            ; That means the sandbox override is STILL on the actor after a
            ; single RemovePackageOverride — either because the enter path
            ; fired multiple times (SituationMonitor flap across door threshold),
            ; or the engine's ExtraPackage state held on to the reference past
            ; the first removal, or some other cause we haven't yet isolated.
            ;
            ; Calling RemovePackageOverride multiple times is cheap, safe (no-op
            ; when already removed), and covers all the failure modes: we do
            ; both package variants, multiple iterations, so any lingering stack
            ; is gone by the time we hand control back to the AI.
            Int removeIter = 0
            While removeIter < 5
                If SafeInteriorSandboxPackage
                    ActorUtil.RemovePackageOverride(akActor, SafeInteriorSandboxPackage)
                EndIf
                If SandboxPackage
                    ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
                EndIf
                removeIter += 1
            EndWhile

            ; Clear WaitingForPlayer FIRST so the CK alias follow package's
            ; condition becomes valid before we re-register SkyrimNet follow,
            ; preventing an engine fallback in the gap.
            akActor.SetAV("WaitingForPlayer", 0)

            ; Remove waiting faction
            If SeverActions_WaitingFaction
                ClearWaitingFaction(akActor)
            EndIf

            ; Restore follow. A follower another framework owns (NFF / DLC /
            ; CustomAI) must NOT be re-driven by SA/SkyrimNet — that is exactly
            ; the "don't fight the framework" hazard. We only RELEASE our
            ; override (done in the multi-remove above), clear our own state
            ; (WaitingForPlayer / faction, above), teleport them out and
            ; re-evaluate so THEIR follow package resumes. SA-owned followers
            ; get the full re-registration below as before.
            SeverActions_FollowerManager fmExit = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
            If fmExit && fmExit.IsTrackOnlyFollower(akActor)
                akActor.MoveTo(Game.GetPlayer())
                akActor.EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended (track-only release): " + akActor.GetDisplayName() + " — override removed, owning framework resumes")
            Else
                ; Re-register SkyrimNet follow for casual followers only.
                ; Companions use CK alias and don't need re-registration.
                If !IsInFollowerSlot(akActor)
                    SkyrimNetApi.RegisterPackage(akActor, "FollowPlayer", FollowPackagePriority, 0, true)
                Else
                    ; Phase 8 Fix B — companion-specific re-assertion.
                    ; User reported that even after Phase 7's multi-remove + resetAI,
                    ; the companion could still walk back to the home because the
                    ; SandboxPackage was STILL on them — and `SetCompanion` action
                    ; was the only thing that reliably recovered them.
                    ;
                    ; SetCompanion does two things our exit path wasn't doing:
                    ; re-setting the FollowerFollowKW LinkedRef to player, and
                    ; re-registering OrphanCleanup_RegisterFollower. Both are
                    ; defensive — but both matter because safe-interior enter/exit
                    ; cycles can leave the CK alias follow package without a valid
                    ; LinkedRef target, making it non-eligible. Re-setting forces
                    ; the alias package into eligibility just like SetCompanion does.
                    If SeverActions_FollowerFollowKW
                        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
                    EndIf
                    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
                EndIf

                SetActivelyFollowing(akActor, true)
                ; Teleport to player so they don't get stuck inside the house
                akActor.MoveTo(Game.GetPlayer())

                ; Phase 7 — escalating re-eval chain (immediate + 500ms + 1000ms resetAI).
                ; The follower is teleported-adjacent to the player at this point
                ; and not in combat (they were safe-interior sandboxing), so the
                ; AI-clearing side effects of resetAI are harmless here. Shorter
                ; resetAI delay than the home-sandbox paths (1000 vs 1500) because
                ; the companion is still local and user expects quick resume.
                SeverActionsNative.EscalatedReEvaluate(akActor, 1000)

                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended: " + akActor.GetDisplayName() + " teleported to player and resumes following")
            EndIf
        EndIf
    EndIf
EndFunction

Function StripSafeInteriorForFollow(Actor akActor)
    {Light teardown of the safe-interior auto-sandbox for follow-start paths
     (recruit / companion-follow via FollowerManager.StripSandboxesForFollow).
     Drops the flag, the package overrides, and the waiting faction so the
     caller's own follow start takes over. Unlike ExitSafeInteriorSandbox this
     does NOT teleport to the player or re-register a follow package — the
     caller is about to do that. No-op when the actor isn't flagged
     SeverActions_InSafeInteriorSandbox, so it's safe to call speculatively.}
    If !akActor
        Return
    EndIf
    Bool wasFlagged = StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) == 1

    ; Remove the priority-100 safe-interior override UNCONDITIONALLY — not only
    ; when the flag reads 1. If the flag ever desyncs from the actual override
    ; (the Phase-7 failure class: resetai returns them to the sandbox because the
    ; override is still on the actor), a flag-gated strip silently leaves the
    ; override in place, outranking the follow package (95) and the framework, and
    ; then NO entry point — action, wheel, or hotkey — can pull them out. Removing
    ; it regardless guarantees a 'come with me' always breaks them out, on the
    ; SA-driven and track-only paths alike. Multi-remove mirrors
    ; ExitSafeInteriorSandbox (a single RemovePackageOverride proved unreliable
    ; there). Only the safe-interior + generic sandbox packages are touched; the
    ; home / work / furniture sandboxes use different packages and are left alone.
    Int removeIter = 0
    While removeIter < 5
        If SafeInteriorSandboxPackage
            ActorUtil.RemovePackageOverride(akActor, SafeInteriorSandboxPackage)
        EndIf
        If SandboxPackage
            ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
        EndIf
        removeIter += 1
    EndWhile

    ; State cleanup only when we were actually flagged relaxing.
    If wasFlagged
        StorageUtil.UnsetIntValue(akActor, "SeverActions_InSafeInteriorSandbox")
        SetSandboxFlag(akActor, false)
        SeverActionsNative.Native_SetSandboxing(akActor, false)
        akActor.SetAV("WaitingForPlayer", 0)
        If SeverActions_WaitingFaction
            ClearWaitingFaction(akActor)
        EndIf
        Debug.Trace("[SeverActions_Follow] Safe interior sandbox stripped for follow start: " + akActor.GetDisplayName())
    EndIf

    ; Re-evaluate so the override removal takes effect immediately — required in
    ; the desync case (override removed above but no flag), where skipping the
    ; re-eval would leave the stale override selected until the next tick. Cheap:
    ; this runs on an explicit follow command, never on a heartbeat.
    akActor.EvaluatePackage()
EndFunction

; Phase 5 Fix C — deferred re-evaluation handler.
; C++ SituationMonitor fires SeverActions_SafeInteriorReEval ~500ms after
; ApplySafeInteriorSandboxNative so the engine picks up our override even if
; the first EvaluatePackage raced with a cell transition or AI busy state.
Event OnSafeInteriorReEval(String eventName, String strArg, Float numArg, Form sender)
    ; sender always carries the actor (native returns early when the lookup
    ; fails); numArg is deliberately 0 — a float FormID corrupts above 2^24.
    Actor akActor = sender as Actor
    If !akActor
        Return
    EndIf
    ; Only re-eval if this actor is still flagged as safe-interior sandboxing.
    ; Covers the case where the player exits during the 500ms delay — we don't
    ; want to force a re-eval on someone who is now mid-exit-teleport.
    If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
        Return
    EndIf
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] Safe interior deferred re-eval: " + akActor.GetDisplayName())
EndEvent

Event OnSafeInteriorReassert(String eventName, String strArg, Float numArg, Form sender)
    {Self-heal: an active follower we consider safe-interior sandboxing was found
     stranded on a runtime FF/FE fallback — the priority-100 override lost the
     first EvaluatePackage, or a cell transition / load knocked it off, and
     FollowDriftMonitor may have stood down on the actor. Re-ADD the override.
     Field 2026-08-30 proved a bare EvaluatePackage (OnSafeInteriorReEval) does
     NOT recover them: Jenassa sat on the fallback 21s through it, and only a
     re-add fixed her. sender carries the actor (native returns early on a failed
     lookup); numArg is 0 — a float FormID corrupts above 2^24.}
    Actor akActor = sender as Actor
    If !akActor || akActor.IsDead()
        Return
    EndIf
    ; Only re-assert someone still flagged safe-interior sandboxing — the same
    ; gate OnSafeInteriorReEval uses, so a mid-exit actor is left alone.
    If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
        Return
    EndIf
    Package interiorPkg = GetSafeInteriorPackage()
    If interiorPkg
        ; Re-seat the override. WaitingForPlayer / faction / flags were set on
        ; enter and are still correct — the fallback came from the override
        ; losing selection, not from those — so we don't touch them. 4th arg
        ; 0 = no AI reset (gentler, matches the enter path).
        ActorUtil.AddPackageOverride(akActor, interiorPkg, SafeInteriorSandboxPriority, 0)
        akActor.EvaluatePackage()
        Debug.Trace("[SeverActions_Follow] Safe interior sandbox RE-ASSERTED off FF fallback: " + akActor.GetDisplayName())
    EndIf
EndEvent

Event OnSafeInteriorRelease(String eventName, String strArg, Float numArg, Form sender)
    {Reclaim reconciliation (the mirror of OnSafeInteriorReassert — let go instead
     of re-seat): SandboxHealTick found this TRACK-ONLY follower being DRIVEN by
     her own framework's follow package, so the relax override lost and her
     external AI has reclaimed her. Native has already cleared our native flags +
     armed a standdown; here we strip the lingering priority-100 override so it
     can't outrank her framework later, WITHOUT teleporting or re-driving her —
     her framework's follow is already active and simply continues (the
     don't-fight-the-framework rule). StripSafeInteriorForFollow does exactly that
     and self-gates on the InSafeInteriorSandbox flag, so it's a safe no-op if she
     was already released. sender carries the actor; numArg is 0 (float FormID
     corrupts above 2^24).}
    Actor akActor = sender as Actor
    If !akActor
        Return
    EndIf
    StripSafeInteriorForFollow(akActor)
EndEvent

