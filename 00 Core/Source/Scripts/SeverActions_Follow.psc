Event OnCasualFollowRecycle(String eventName, String strArg, Float numArg, Form sender)
    {Cell catchup just moved a CASUAL follower to the player. Across a load
     door SkyrimNet's FollowPlayer can stay registered yet stop being served;
     re-cycling the registration relinks its hook. Idempotent, and never
     resurrects a stopped follow (only a registered package is cycled).}
    Actor m = sender as Actor
    If !m || m.IsDead()
        Return
    EndIf
    ; Pool-seated: the alias package re-applies on cell load; just nudge.
    If IsInFollowerSlot(m)
        m.EvaluatePackage()
        Return
    EndIf
    If !SkyrimNetApi.HasPackage(m, "FollowPlayer")
        Return
    EndIf
    SkyrimNetApi.UnregisterPackage(m, "FollowPlayer")
    SkyrimNetApi.RegisterPackage(m, "FollowPlayer", FollowPackagePriority, 0, true)
    m.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] CasualFollowRecycle: relinked FollowPlayer for " + m.GetDisplayName())
EndEvent

