; =============================================================================
; SAVE/LOAD PERSISTENCE (Companions only)
; =============================================================================

Function ReapplyFollowTracking(Actor[] followers)
    {Load re-apply for the roster (FollowerManager.RunDeferredMaintenance).
     Alias packages persist natively; this re-sets the follow LinkedRef and
     OrphanCleanup entry, the wait sandbox, the ActivelyFollowing tag and the
     native follow flag, and takes the flag and LinkedRef off a hands-off
     follower. Never registers a SkyrimNet package.}
    Actor player = Game.GetPlayer()
    Int i = 0
    While i < followers.Length
        Actor akActor = followers[i]
        Bool skipReapply = false
        If akActor && !akActor.IsDead()
            ; Hands-off (track-only, or anyone in Tracking mode, D45): never set
            ; SA's LinkedRef / OrphanCleanup entry / hasFollowPkg, and clear a stale
            ; flag (it re-arms FollowDriftMonitor, CellCatchup and SandboxManager
            ; against them) or LinkedRef, every load. No EvaluatePackage: their
            ; framework owns their packages.
            If SeverActions_ModuleBase.IsFollowHandsOff(akActor)
                skipReapply = true
                SeverActionsNative.Native_SetPackageState(akActor, false, false, false)
                If SeverActions_FollowerFollowKW && akActor.GetLinkedRef(SeverActions_FollowerFollowKW) != None
                    SeverActionsNative.LinkedRef_Clear(akActor, SeverActions_FollowerFollowKW)
                EndIf
                Debug.Trace("[SeverActions_Follow] ReapplyFollowTracking: skipped hands-off " + akActor.GetDisplayName() + " (owned elsewhere, or Tracking mode - SA leads nobody)")
            ; Mid-travel: Travel's load recovery owns them.
            ElseIf SeverActionsNativeExt2.Native_GetTravelState(akActor) != ""
                skipReapply = true
                Debug.Trace("[SeverActions_Follow] ReapplyFollowTracking: skipped mid-travel " + akActor.GetDisplayName())
            EndIf
        EndIf
        If akActor && !akActor.IsDead() && !skipReapply
            ; A seated follower must not also hold SkyrimNet's FollowPlayer (AI
            ; flicker).
            If IsInFollowerSlot(akActor) && SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
                SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
                Debug.Trace("[SeverActions_Follow] Cleaned stale SkyrimNet FollowPlayer from companion: " + akActor.GetDisplayName())
            EndIf

            ; Re-set every load: the cosave restore does not refresh the row's
            ; 30-day prune stamp.
            If SeverActions_FollowerFollowKW
                SeverActionsNative.LinkedRef_Set(akActor, player, SeverActions_FollowerFollowKW)
                ; OrphanCleanup's registry is cleared at every kPostLoadGame; with
                ; the scanner on (orphanCleanupEnabled) an unregistered holder's
                ; LinkedRef is stripped ~5s after load.
                SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
            EndIf

            ; Either signal means waiting: external AI (Serana's DLC scripts) can
            ; zero WaitingForPlayer, but only SA clears the native sandboxing flag.
            Bool isWaiting = akActor.GetAV("WaitingForPlayer") > 0 || IsSandboxing(akActor)
            ; 4th arg 0 = no AI reset; the EvaluatePackage below picks it up.
            If isWaiting && SandboxPackage
                ActorUtil.AddPackageOverride(akActor, GetWaitSandboxPackage(), SandboxPackagePriority, 0)
                SetSandboxFlag(akActor, true)
            EndIf

            SetActivelyFollowing(akActor, !isWaiting)

            ; Native follow flag (drift monitor, cell catchup, UI badge)
            SeverActionsNative.Native_SetPackageState(akActor, !isWaiting, false, false)

            ; A re-evaluation mid-sit stands a furniture user up, and the use package
            ; outranks follow anyway: their follow picks up when they stand.
            If !SeverActions_FurnitureLib.IsUsing(akActor)
                akActor.EvaluatePackage()
            EndIf
            Debug.Trace("[SeverActions_Follow] Reapplied companion follow tracking for: " + akActor.GetDisplayName() + " (waiting=" + isWaiting + ")")
        EndIf
        i += 1
    EndWhile
EndFunction

; =============================================================================
; CASUAL FOLLOW — pool-seated (guards, random NPCs, temporary)
; Called by startfollowing.yaml / stopfollowing.yaml
; =============================================================================
; Cancel a journey or wait through the travelcore provider
; (SeverActions_ModuleBase.CallBool("travelcore", "cancelJourney", ...)), never a
; SeverActions_Travel / TravelCore cast: neither is in followers' closure (DR2),
; and a journey can run without the travel module.

Function SetFollowDistance(Actor akActor, String distance)
    {Per-follower trailing distance. "close"/"near"/"tight" adds
     CloseFollowFaction, which gates SeverActions_FollowPlayerClose (~150-200u)
     above the standard package (~500-600u) on every follow alias; anything
     else removes it. The faction persists in the save, so the choice survives
     reload and dismiss/re-recruit. Called by the UI's setFollowDistance verb.}
    if !akActor
        return
    endif
    Faction closeFac = Game.GetFormFromFile(0x16567B, "SeverActions.esp") as Faction
    if !closeFac
        Debug.Trace("[SeverActions_Follow] SetFollowDistance: CloseFollowFaction missing (old ESP?)")
        return
    endif
    String d = SeverActionsNative.StringToLower(distance)
    Bool wantClose = StringUtil.Find(d, "close") >= 0 || StringUtil.Find(d, "near") >= 0 || StringUtil.Find(d, "tight") >= 0
    if wantClose
        if !akActor.IsInFaction(closeFac)
            akActor.AddToFaction(closeFac)
        endif
        SkyrimNetApi.RegisterEvent("follow_distance", \
            akActor.GetDisplayName() + " will now stay close at " + Game.GetPlayer().GetDisplayName() + "'s side while following.", akActor, None)
        Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.willFollowClose", ("" + akActor.GetDisplayName())))
    else
        if akActor.IsInFaction(closeFac)
            akActor.RemoveFromFaction(closeFac)
        endif
        SkyrimNetApi.RegisterEvent("follow_distance", \
            akActor.GetDisplayName() + " will now follow at a normal distance, giving " + Game.GetPlayer().GetDisplayName() + " room.", akActor, None)
        Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.willFollowAtNormal", ("" + akActor.GetDisplayName())))
    endif
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] SetFollowDistance: " + akActor.GetDisplayName() + " close=" + wantClose)
EndFunction

Function StartFollowing(Actor akActor)
    {Temporary (casual) follow for any NPC, with no roster entry: a follow-pool
     seat plus the FollowerFollowKW LinkedRef, the same mechanism as companions.}
    if !akActor || akActor.IsDead()
        return
    endif

    ; The Final Audit is unrecruitable by design (same guard as RegisterFollower).
    if SeverActionsNativeExt2.Venture_Audit_IsCollector(akActor)
        SkyrimNetApi.RegisterEvent("follower_recruit_failed",             akActor.GetDisplayName() + " serves the Imperial Treasury alone - the Final Audit follows no one. Whatever business " + Game.GetPlayer().GetDisplayName() + " has with them can be conducted right where they stand.",             akActor, None)
        return
    endif

    SeverActions_FollowerManager fmTO = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager

    ; Hands off: another framework owns them, or Tracking mode, where SA leads
    ; nobody (D45). Never register our package or set hasFollowPkg on them (the
    ; flag re-enables the native follow monitors). The Tracking-only case must
    ; say so (notification below): a silent return leaves the wheel's follow
    ; button doing nothing.
    If SeverActions_ModuleBase.IsFollowHandsOff(akActor)
        ; Take no ownership, but release what SA holds: its sandbox overrides
        ; outrank the owner's follow package and the waiting faction still reads
        ; as waiting (see ClearWaitingFaction), so the NPC would stay put.
        fmTO.StripSandboxesForFollow(akActor)
        fmTO.ClearWorkSandboxForFollow(akActor)
        ClearWaitingFaction(akActor)
        ; End any journey or wait too (0.0: no follower restore, the owner drives them).
        SeverActions_ModuleBase.CallBool("travelcore", "cancelJourney", akActor, None, "", 0.0)
        If SeverActionsNativeExt2.Native_IsNFFInstalled() && SeverActions_NFFLib.NFFResume(akActor)
            ; NFF owns them and has its own wait state - release it there, or a
            ; follower the player parked through us could never be un-parked.
            Debug.Trace("[SeverActions_Follow] StartFollowing: released " + akActor.GetDisplayName() + " through NFF")
        Else
            akActor.SetAV("WaitingForPlayer", 0)
            akActor.EvaluatePackage()
            If SeverActionsNativeExt2.Native_IsTrackOnlyFollower(akActor)
                Debug.Trace("[SeverActions_Follow] StartFollowing: " + akActor.GetDisplayName() + " is track-only - deferred to their own framework")
            Else
                ; Nobody owns them, so this is Tracking mode (D45): say so.
                Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.trackingModeDoesNotDrive", ("" + akActor.GetDisplayName())))
                Debug.Trace("[SeverActions_Follow] StartFollowing: Tracking mode - SA leads nobody, " + akActor.GetDisplayName() + " stays put (D45)")
            EndIf
        EndIf
        Return
    EndIf

    ; Tell listeners the player called this actor over (e.g. Hearth releases a
    ; camp-pinned follower); strArg is the verb. A ModEvent delivers exactly the
    ; pushed args, so push all four in the handler's order: eventName, strArg,
    ; numArg, sender.
    int followEvt = ModEvent.Create("SeverActions_FollowerCalledByPlayer")
    if followEvt
        ModEvent.PushString(followEvt, "SeverActions_FollowerCalledByPlayer")
        ModEvent.PushString(followEvt, "follow")
        ModEvent.PushFloat(followEvt, 0.0)
        ModEvent.PushForm(followEvt, akActor)
        ModEvent.Send(followEvt)
    endif

    ; End any journey or wait, so its arrival override (e.g. Hearth's
    ; CampSandboxPackage) can't outrank the follow below. 0.0 = no follower
    ; restore (we apply follow ourselves); a no-op when not traveling.
    SeverActions_ModuleBase.CallBool("travelcore", "cancelJourney", akActor, None, "", 0.0)

    ; Clear WaitingForPlayer FIRST: the follow packages gate on it == 0, and in
    ; the gap before follow applies the engine creates an FF-prefix runtime sandbox.
    akActor.SetAV("WaitingForPlayer", 0)

    ; Leave a safe-interior auto-sandbox (priority 100 outranks the pool's 95)
    ; and teleport to the player; a no-op unless flagged.
    ExitSafeInteriorSandbox(akActor)

    ; Not gated on IsSandboxing: if the flag was lost (save/load, timing) a gated
    ; removal would leave the override on forever. No-ops when nothing is active.
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    RemoveWaitSandboxPackages(akActor)

    ; Drop the work-sandbox override (110) so it can't outrank the pool follow
    ; (95), as recruit does. The work assignment stays: the schedule gates on
    ; ActivelyFollowing and re-applies work once StopFollowing clears it.
    SeverActions_FollowerManager fmWork = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    if fmWork
        fmWork.ClearWorkSandboxForFollow(akActor)
        ; Home / play / furniture / safe-interior sandboxes go too.
        fmWork.StripSandboxesForFollow(akActor)
    endif

    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Seat in the pool: its alias packages re-apply on cell load, while a
    ; SkyrimNet FollowPlayer override stops being served past a load door. No
    ; RegisterPackage: one mechanism drives follow, or the AI flickers.
    If SeverActions_FollowerFollowKW
        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
    Else
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerFollowKW not set!")
    EndIf
    AssignFollowerSlot(akActor)
    ; Register with OrphanCleanup: with the scanner on (orphanCleanupEnabled) it
    ; strips an unregistered holder's LinkedRef (its registry clears on load;
    ; VerifyCasualFollowPackages re-registers seated casuals).
    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
    SeverActionsNative.Native_SetPackageState(akActor, true, false, false)
    akActor.EvaluatePackage()

    ; ENGAGED tag in prompts.
    SetActivelyFollowing(akActor, true)

    Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.isNowFollowingYou", ("" + akActor.GetDisplayName())))
EndFunction

Function StopFollowing(Actor akActor)
    {Stop casual following: free the pool seat and LinkedRef, and any legacy
     SkyrimNet FollowPlayer registration.}
    if !akActor
        return
    endif

    ; Sandbox teardown, ungated.
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    RemoveWaitSandboxPackages(akActor)

    ; Never a registered companion's seat: CompanionStopFollowing owns theirs,
    ; and the LLM can fire this verb at anyone.
    If !SeverActionsNativeExt.Native_GetIsFollower(akActor)
        ClearFollowerSlot(akActor)
        SeverActionsNative.OrphanCleanup_UnregisterFollower(akActor)
        If SeverActions_FollowerFollowKW
            SeverActionsNative.LinkedRef_Clear(akActor, SeverActions_FollowerFollowKW)
        EndIf
    EndIf
    ; A legacy casual's SkyrimNet FollowPlayer (a no-op otherwise; SkyrimNet
    ; re-evaluates the package itself).
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)

    SetActivelyFollowing(akActor, false)

    ; Refill a dismissed/homed NPC's schedule alias (no-op if they re-follow).
    SeverActions_FollowerManager fmStop = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmStop
        fmStop.RefillSchedAliasesAfterStop(akActor)
    EndIf

    Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.stoppedFollowingYou", ("" + akActor.GetDisplayName())))
    ; A state line, not history (see RegisterFollowStateEvent). A companion
    ; really walking out is followerleaves.yaml's persistent follower_left_voluntarily.
    RegisterFollowStateEvent(akActor, "follower_left", \
        akActor.GetDisplayName() + " stopped following " + Game.GetPlayer().GetDisplayName())
EndFunction

; =============================================================================
; COMPANION FOLLOW (roster companions; called by FollowerManager)
; =============================================================================

Function CompanionStartFollowing(Actor akActor)
    {Start a roster companion following: the LinkedRef to the player plus a
     follow-pool seat, whose alias packages apply at once.}
    if !akActor || akActor.IsDead()
        return
    endif

    ; WaitingForPlayer FIRST, before the sandbox comes off (see StartFollowing).
    akActor.SetAV("WaitingForPlayer", 0)
    ; Drop the waiting faction Sandbox() added, or prompt selectors read a
    ; following companion as waiting.
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Now the sandbox can come off: follow is already eligible.
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    RemoveWaitSandboxPackages(akActor)

    ; A stale casual FollowPlayer registration (defensive).
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

    If SeverActions_FollowerFollowKW
        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
    Else
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerFollowKW not set!")
    EndIf

    ; A followed companion holds no schedule aliases (no-op pre-migration).
    SeverActions_FollowerManager fmSched = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSched
        fmSched.EmptySchedAliasesForFollow(akActor)
    EndIf

    ; The alias packages apply now and re-apply on cell load. No RegisterPackage.
    AssignFollowerSlot(akActor)

    SetActivelyFollowing(akActor, true)

    ; hasFollowPkg: SA drives this follow (drift monitor, cell catch-up, UI badge).
    SeverActionsNative.Native_SetPackageState(akActor, true, false, false)

    ; See StartFollowing.
    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)

    akActor.EvaluatePackage()
EndFunction

Function CompanionStopFollowing(Actor akActor, Bool evaluateAfter = true)
    {Stop companion following: free the pool seat (its packages go with it)
     and every tracked LinkedRef. Pass evaluateAfter=false when the caller
     applies a new package right after (dismiss -> SendHome): an evaluate with
     no package creates an FF-prefix fallback.}
    if !akActor
        return
    endif

    ; Sandbox teardown, ungated.
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    RemoveWaitSandboxPackages(akActor)

    ClearFollowerSlot(akActor)

    SeverActionsNative.OrphanCleanup_UnregisterFollower(akActor)

    ; ALL tracked LinkedRefs, not just follow: travel, furniture or arrest refs an
    ; interrupted system left would stay in the cosave and restore on load. Each
    ; system still clears its own on completion; this is the final sweep.
    SeverActionsNative.LinkedRef_ClearAll(akActor)
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; A leftover casual FollowPlayer registration.
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

    SetActivelyFollowing(akActor, false)

    ; hasFollowPkg off (see CompanionStartFollowing).
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)

    ; Refill a dismissed/homed NPC's schedule alias (no-op when the caller
    ; re-follows or waits them).
    SeverActions_FollowerManager fmSchedStop = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedStop
        fmSchedStop.RefillSchedAliasesAfterStop(akActor)
    EndIf

    If evaluateAfter
        akActor.EvaluatePackage()
    EndIf
EndFunction

; =============================================================================
; MANUAL WAIT SANDBOX (casual and companion follow)
; =============================================================================

Function Sandbox(Actor akActor)
    if !akActor || akActor.IsDead()
        return
    endif

    if !SandboxPackage
        Debug.Trace("[SeverActions_Follow] Sandbox: No SandboxPackage assigned!")
        return
    endif

    ; Apply the wait package FIRST: setting WaitingForPlayer first drops the
    ; follow package, and the engine fills the gap with an FF-prefix sandbox.
    ; Flags 0 skips the AI reset. GetWaitSandboxPackage picks Wait In Place or
    ; the wide sandbox.
    Package waitPkg = GetWaitSandboxPackage()
    ActorUtil.AddPackageOverride(akActor, waitPkg, SandboxPackagePriority, 0)

    ; Now the follow can drop: the sandbox already covers them.
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
    akActor.SetAV("WaitingForPlayer", 1)

    ; After the WaitingForPlayer write, which is what stops SituationMonitor claiming
    ; them again: a safe-interior relax gives way to this wait.
    YieldSafeInteriorToWait(akActor, waitPkg)

    ; Re-evaluate now: the next vanilla tick can be seconds away, and until then
    ; they keep trailing the player.
    akActor.EvaluatePackage()

    ; Keep hasFollowPkg (no Native_SetPackageState(false)): StopSandbox reads it
    ; to tell SA-managed from track-only. SandboxManager's teleport skips this
    ; actor through isSandboxing, set here (see SANDBOX STATE HELPERS).
    SetSandboxFlag(akActor, true)

    ; Release schedule aliases so the schedule can't pull them away mid-wait.
    SeverActions_FollowerManager fmSchedSbx = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedSbx
        fmSchedSbx.EmptySchedAliasesForFollow(akActor)
    EndIf

    ; No SandboxManager registration: a wait holds until the player resumes
    ; them (StopSandbox).

    SetActivelyFollowing(akActor, false)

    ; Interop signal (see SeverActions_WaitingFaction).
    If SeverActions_WaitingFaction
        akActor.AddToFaction(SeverActions_WaitingFaction)
    EndIf

    RegisterFollowStateEvent(akActor, "follower_relaxing", akActor.GetDisplayName() + " decides to relax and wander around the area.")
EndFunction

Function StopSandbox(Actor akActor)
    if !akActor
        return
    endif

    ; Snapshot before teardown: CompanionWait's track-only recovery calls this
    ; defensively, and the "stopped relaxing" feedback at the end must only
    ; follow a real sandbox.
    Bool wasSandboxing = IsSandboxing(akActor)

    ; WaitingForPlayer FIRST, before the sandbox comes off (see StartFollowing).
    akActor.SetAV("WaitingForPlayer", 0)

    SetSandboxFlag(akActor, false)

    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    SeverActionsNative.UnregisterSandboxUser(akActor)

    ; Both wait variants (see RemoveWaitSandboxPackages).
    RemoveWaitSandboxPackages(akActor)

    ; Re-register FollowPlayer only for a legacy casual SA drives:
    ;   1. IsInFollowerSlot (companions, pool casuals, overflow): their follow
    ;      package re-asserts once WaitingForPlayer clears; FollowPlayer on top
    ;      flickers the AI.
    ;   2. Legacy SkyrimNet casuals (hasFollowPkg, not seated): want it back.
    ;   3. Track-only followers from CompanionWait's recovery (hasFollowPkg
    ;      false): their own mod drives them, and a FollowPlayer here suppressed
    ;      it and left them standing.
    Bool isSAManaged = SeverActionsNative.Native_GetHasFollowPkg(akActor)
    If !IsInFollowerSlot(akActor) && isSAManaged
        SkyrimNetApi.RegisterPackage(akActor, "FollowPlayer", FollowPackagePriority, 0, true)
    EndIf

    ; Re-evaluate now, as in Sandbox (RegisterPackage above is async).
    akActor.EvaluatePackage()

    ; Only when a follow exists to resume: on a dismissed/homed NPC a stale
    ; ActivelyFollowing silently freezes their work schedule.
    If IsInFollowerSlot(akActor) || SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
        SetActivelyFollowing(akActor, true)
    EndIf

    ; Refill a dismissed/homed NPC's schedule alias (no-op when follow resumed).
    SeverActions_FollowerManager fmSchedStopSbx = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedStopSbx
        fmSchedStopSbx.RefillSchedAliasesAfterStop(akActor)
    EndIf

    If wasSandboxing
        Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.stoppedRelaxing", ("" + akActor.GetDisplayName())))
        RegisterFollowStateEvent(akActor, "follower_relax_stopped", akActor.GetDisplayName() + " stops relaxing and is ready to move.")
    EndIf
EndFunction

; =============================================================================
; ELIGIBILITY AND EXTERNAL WAIT
; =============================================================================

; Casual-follow eligibility for FollowerManager's hotkey / wheel follow toggle.

Bool Function StartFollowing_IsEligible(Actor akActor) Global
    if !akActor || akActor.IsDead() || akActor.IsInCombat()
        return false
    endif

    ; Not vanilla followers (CurrentFollowerFaction).
    Faction factionCompanion = Game.GetFormFromFile(0x084D1B, "Skyrim.esm") as Faction
    if factionCompanion && akActor.IsInFaction(factionCompanion)
        return false
    endif

    ; hasPackage: a legacy SkyrimNet casual. isCompanion: IsInFollowerSlot, so
    ; pool casuals count too. Global, so the instance comes from 0x000D62.
    Bool hasPackage = SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
    SeverActions_Follow instance = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_Follow
    Bool isCompanion = instance && instance.IsInFollowerSlot(akActor)
    Bool isWaiting = akActor.GetAV("WaitingForPlayer") > 0
    Bool isSandboxing = SeverActionsNativeExt.Native_GetSandboxing(akActor)

    ; Seated: eligible only while waiting or sandboxing.
    If isCompanion
        return isWaiting || isSandboxing
    EndIf

    ; A legacy casual already following: not eligible.
    if hasPackage && !isWaiting && !isSandboxing
        return false
    endif

    return true
EndFunction

Event OnExternalWaitAdopt(String eventName, String strArg, Float numArg, Form sender)
    {A follower-command mod (Swiftly Order Squad class) parked one of our
     companions with a bare SetAV(WaitingForPlayer, 1). SA's follow packages
     have no wait branch, so they would drop to default AI and walk home:
     apply the real SA wait. FollowDriftMonitor confirms over two scans with a
     60s cooldown per actor; re-validate, as Papyrus may have acted since.}
    Actor akActor = sender as Actor
    If !akActor || akActor.IsDead()
        Return
    EndIf
    If akActor.GetAV("WaitingForPlayer") != 1.0
        Return
    EndIf
    If IsSandboxing(akActor)
        Return
    EndIf
    Debug.Trace("[SeverActions_Follow] Adopting external wait on " + akActor.GetDisplayName() + " (third-party WaitingForPlayer=1)")
    Sandbox(akActor)
EndEvent

; ============================================================================
; SCENE EVENTS
; ============================================================================

Int Property FollowStateTTLMs = 300000 Auto
{How long a follow-state line stays in scene context (ms).}

Function RegisterFollowStateEvent(Actor akActor, String asType, String asText)
    {Following / waiting / relaxing is STATE, not history. Every state line
     shares the eventId follow_state_<fid>, SkyrimNet's REPLACE key, so each
     companion keeps one line saying what they do NOW instead of one per
     transition (the sandbox system flips them constantly).
     FollowerManager.RegisterFollowStateEvent uses the same key; keep the two
     in step. One-off history (a companion walking out, an arrest) stays on
     RegisterEvent / RegisterPersistentEvent.}

    If akActor == None
        Return
    EndIf
    SkyrimNetApi.RegisterShortLivedEvent("follow_state_" + akActor.GetFormID(), \
        asType, asText, "", FollowStateTTLMs, akActor, Game.GetPlayer())
EndFunction

