        If val == 1
            Game.SetGameSettingInt("iAllyHitCombatAllowed", 100)
            Game.SetGameSettingInt("iAllyHitNonCombatAllowed", 50)
        Else
            Game.SetGameSettingInt("iAllyHitCombatAllowed", 3)
            Game.SetGameSettingInt("iAllyHitNonCombatAllowed", 0)
        EndIf
        Debug.Trace("[SeverActions_Follow] Follower friendly-fire prevention persisted: " + val + " (ally hit thresholds adjusted)")
    EndIf
EndEvent

; =============================================================================
; HELPER - Check if actor has follow package
; =============================================================================

Bool Function HasFollowPackage(Actor akActor)
    {Reports whether akActor is ACTIVELY following the player. Named for the
     legacy mechanism (SkyrimNet's "FollowPlayer" package), but since the
     200-alias pool migration follow rides the POOL SEAT — StartFollowing
     seats, StopFollowing frees — and the package is only the pool-exhaustion
     fallback. Checking only the package made the follow HOTKEY and WHEEL
     unable to see an active follower (second press re-started instead of
     stopping — Goncalo report #1).

     MECHANISM-BASED ON PURPOSE — do NOT re-add an ActivelyFollowing faction
     leg here. The first fix for report #1 checked that faction, and the very
     next field test (Brenuin, 2026-08-20) had the membership SURVIVE
     Faction_RemoveClean in StopFollowing: seat freed and LinkedRef cleared
     (both in the logs) yet IsInFaction stayed true, so every later press
     read "following" and routed to StopFollowing forever — the same toggle
     stuck in the OPPOSITE state. The pool seat is the mechanism itself
     (IsInFollowerSlot verifies the cosaved index AND the alias content), so
     it cannot disagree with what the AI is actually doing. The faction is a
     prompt tag, not a state source; SetActivelyFollowing now instruments its
     removal so the survival gets root-caused from tester logs.}
    if !akActor
        return false
    endif
    If IsInFollowerSlot(akActor)
        return true
    EndIf
    return SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
EndFunction

; =============================================================================
; ACTIVELY FOLLOWING FACTION — dynamic state for SkyrimNet prompt integration
; =============================================================================

Function SetActivelyFollowing(Actor akActor, Bool active)
    {Add or remove the SeverActions_ActivelyFollowing faction.
     Called whenever a companion's follow state changes.}
    If !SeverActions_ActivelyFollowing || !akActor
        Return
    EndIf
    If active
        akActor.AddToFaction(SeverActions_ActivelyFollowing)
    Else
        ; TRUE removal - RemoveFromFaction leaves a rank -1 residue that
        ; rank-blind readers still count as membership (see ClearWaitingFaction).
        ; ISSUE #437 PROBE: the return bool is the fork between the two
        ; hypothesis families - TRUE + survival means the entry WAS in the
        ; reference's ExtraFactionChanges and was erased, yet the engine READS
        ; membership elsewhere; FALSE + survival means the engine WRITES the
        ; Papyrus-added membership somewhere GetByType<ExtraFactionChanges>
        ; never sees. Logged in the WARNING below.
        Bool removedClean = SeverActionsNativeExt2.Faction_RemoveClean(akActor, SeverActions_ActivelyFollowing)
        ; FIELD REPORT (Brenuin, 2026-08-20): the membership SURVIVED the
        ; RemoveClean — seat freed + LinkedRef cleared in the same stop, yet
        ; IsInFaction stayed true, wedging the (then faction-based) follow
        ; toggle in the Stop branch. Verify with the rank read and, on a
        ; GENUINE surviving membership, log LOUDLY (so a tester log pins the
        ; native mechanism) and fall back to RemoveFromFaction.
        ; GetFactionRank returns -1 for a non-member (vanilla contract) and 0+
        ; for a real member, so `>= 0` is the survival test — NOT `!= -2`,
        ; which fired on every clean removal (the -1 non-member value) and
        ; re-applied the fallback needlessly (code-review catch). The -1
        ; residue RemoveFromFaction leaves on a real survivor is acceptable:
        ; follow DETECTION is mechanism-based now (HasFollowPackage reads the
        ; pool slot), and SkyrimNet-side readers use get_faction_rank >= 0.
        Int survivedRank = akActor.GetFactionRank(SeverActions_ActivelyFollowing)
        If survivedRank >= 0
            Debug.Trace("[SeverActions_Follow] WARNING: ActivelyFollowing survived Faction_RemoveClean on " + akActor.GetDisplayName() + " (rank " + survivedRank + ", removedClean=" + removedClean + ") - RemoveFromFaction fallback applied")
            akActor.RemoveFromFaction(SeverActions_ActivelyFollowing)
        EndIf
    EndIf
EndFunction

Function ClearWaitingFaction(Actor akActor)
    {TRUE removal of the waiting faction. Papyrus RemoveFromFaction only
     writes rank -1 into the actor's faction overrides, and rank-blind
     consumers (IsInFaction, GetInFaction package conditions, IntelEngine's
     wait check - this faction is our documented interop signal) still read
     that residue as WAITING. Field-proven: casual followers froze at load
     doors carrying waitfaction rank -1 until a manual follow toggle - the
     toggle path that healed them is exactly this true removal.}
    If !akActor || !SeverActions_WaitingFaction
        Return
    EndIf
    SeverActionsNativeExt2.Faction_RemoveClean(akActor, SeverActions_WaitingFaction)
EndFunction

; =============================================================================
; COMPANION ALIAS SLOT MANAGEMENT
; =============================================================================

; =============================================================================
; FOLLOW ALIAS POOL — lazy resolve + cursor (sched-pool patterns)
; =============================================================================

Quest Function GetFollowQuest()
    {Lazy-resolve the 200-alias follow quest (the EnsureSchedQuests pattern:
     never ESP properties, always GetFormFromFile). None while the ESP
     predates the pool — AssignFollowerSlot then falls back to today's
     legacy-slot behavior exactly. Retried on each call until it resolves.}
    If _followQuestResolved
        Return _followQuest
    EndIf
    _followQuest = Game.GetFormFromFile(FOLLOW_QUEST_FORMID, "SeverActions.esp") as Quest
    If !_followQuest
        Debug.Trace("[SeverActions_Follow] FOLLOW ALIAS POOL UNAVAILABLE — SeverActions_FollowQuest failed to resolve from SeverActions.esp (outdated ESP?). Pool seating disabled; legacy 21-slot + overflow follow remains active.")
        Return None
    EndIf
    _followQuestResolved = true
    Return _followQuest
EndFunction

ReferenceAlias Function GetFollowAlias(Int aiIndex)
    If aiIndex < 0 || aiIndex >= FOLLOW_ALIAS_POOL_SIZE
        Return None
    EndIf
    Quest pool = GetFollowQuest()
    If !pool
        Return None
    EndIf
    Return pool.GetNthAlias(aiIndex) as ReferenceAlias
EndFunction

Int Function FindFreeFollowAlias()
    {Rotating-cursor scan for an unoccupied pool alias (the
     FindFreeSchedAlias pattern). -1 = pool exhausted (or pool unavailable).}
    Quest pool = GetFollowQuest()
    If !pool
        Return -1
    EndIf
    Int n = 0
    While n < FOLLOW_ALIAS_POOL_SIZE
        Int idx = _followCursor + n
        If idx >= FOLLOW_ALIAS_POOL_SIZE
            idx -= FOLLOW_ALIAS_POOL_SIZE
        EndIf
        ReferenceAlias al = pool.GetNthAlias(idx) as ReferenceAlias
        If al && al.GetReference() == None
            _followCursor = idx + 1
            If _followCursor >= FOLLOW_ALIAS_POOL_SIZE
                _followCursor = 0
            EndIf
            Return idx
        EndIf
        n += 1
    EndWhile
    Return -1
EndFunction

Function AssignFollowerSlot(Actor akActor)
    {Seat the actor in the 200-alias follow pool — the alias's CK packages
     (Close above V2) auto-apply on ForceRefTo and re-apply natively on cell
     load, closing the overflow route's 3D-unload gap. Legacy CK slot and
     the overflow override pair are treated as transitional states (stripped
     here so exactly one mechanism drives follow); the override pair is
     kept ONLY as the >200 fallback.}
    If !akActor
        Return
    EndIf
    Quest pool = GetFollowQuest()
    If pool
        ; Already-seated fast path: the cosaved index names an alias that
        ; still points at this actor.
        Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
        If held >= 0
            ReferenceAlias heldAl = GetFollowAlias(held)
            If heldAl && heldAl.GetReference() == akActor
                Return
            EndIf
            ; Stale index (alias repurposed under us) — drop the bookkeeping;
            ; SweepFollowAliasesOnLoad owns cross-checking the pool side.
            SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, -1)
        EndIf
        ; Transitional strips: a pre-pool save can hold a legacy slot or the
        ; overflow pair — never let two mechanisms stack (the AI-flicker
        ; lesson from the slot/overflow overlap audit).
        _ClearLegacyFollowerSlot(akActor)
        If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
            RemoveOverflowFollow(akActor)
        EndIf
        Int idx = FindFreeFollowAlias()
        If idx >= 0
            ReferenceAlias al = GetFollowAlias(idx)
            If al
                al.ForceRefTo(akActor)
                SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, idx)
                Debug.Trace("[SeverActions_Follow] Seated " + akActor.GetDisplayName() + " in follow alias " + idx)
                Return
            EndIf
        EndIf
        ; Pool full (>200 followers) — the override pair is the only route
        ; left. Kept exactly as today (Close @55 + V2 @50 + overflow flag).
        ApplyOverflowFollow(akActor)
        Return
    EndIf
    ; ESP predates the pool — today's legacy behavior, unchanged.
    _AssignLegacyFollowerSlot(akActor)
EndFunction

Function _AssignLegacyFollowerSlot(Actor akActor)
    {PRE-POOL path (old ESP without SeverActions_FollowQuest): the 21 CK
     slots, then overflow. New code should never fill a legacy slot — the
     pool is strictly better (self-healing on cell load).}
    If !FollowerSlots
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerSlots array not set - alias follow disabled")
        Return
    EndIf

    ; Check if actor is already in a slot (avoid duplicates)
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            Debug.Trace("[SeverActions_Follow] " + akActor.GetDisplayName() + " already in FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile

    ; Find first empty slot
    i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && !FollowerSlots[i].GetActorRef()
            ; If they were riding the overflow overrides, strip those first -
            ; otherwise the CK alias package AND the PO3 pair run together
            ; (AI flicker) with a stale overflow flag (audit).
            If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
                RemoveOverflowFollow(akActor)
            EndIf
            FollowerSlots[i].ForceRefTo(akActor)
            Debug.Trace("[SeverActions_Follow] Assigned " + akActor.GetDisplayName() + " to FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile

    ; All 21 CK alias slots taken — OVERFLOW: ride the same follow packages
    ; via cosaved PO3 overrides instead. Appending aliases to this quest is
    ; the proven engine-hang trap, so overflow is how the roster scales past
    ; the alias pool. The packages' own conditions do the work (Close's
    ; CloseFollowFaction gate; both yield when WaitingForPlayer != 0), and
    ; FollowDriftMonitor counts them as healthy + re-asserts drift.
    ApplyOverflowFollow(akActor)
EndFunction

Function _ClearLegacyFollowerSlot(Actor akActor)
    {Clear the actor's legacy CK slot if held (silent no-op otherwise —
     the common case post-migration). Transitional helper for the pool era.}
    If !FollowerSlots
        Return
    EndIf
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            FollowerSlots[i].Clear()
            Debug.Trace("[SeverActions_Follow] Cleared " + akActor.GetDisplayName() + " from FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile
EndFunction

Function ApplyOverflowFollow(Actor akActor)
    {Follow via package override for followers beyond the alias pool. Close
     (faction-gated, prio 55) above V2 (prio 50) — both below the sandbox/
     wait overrides (100+) so Wait/relax still wins.}
    Package closePkg = Game.GetFormFromFile(0x0016567C, "SeverActions.esp") as Package
    Package v2Pkg = Game.GetFormFromFile(0x00155C93, "SeverActions.esp") as Package
    If closePkg
        ActorUtil.AddPackageOverride(akActor, closePkg, 55, 1)
    EndIf
    If v2Pkg
        ActorUtil.AddPackageOverride(akActor, v2Pkg, 50, 1)
    EndIf
    StorageUtil.SetIntValue(akActor, "SeverFollow_Overflow", 1)
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] OVERFLOW follow (no free alias slot) applied to " + akActor.GetDisplayName())
EndFunction

Function RemoveOverflowFollow(Actor akActor)
    {Strip the overflow follow overrides. Safe no-op when never applied.}
    If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) != 1
        Return
    EndIf
    Package closePkg = Game.GetFormFromFile(0x0016567C, "SeverActions.esp") as Package
    Package v2Pkg = Game.GetFormFromFile(0x00155C93, "SeverActions.esp") as Package
    If closePkg
        ActorUtil.RemovePackageOverride(akActor, closePkg)
    EndIf
    If v2Pkg
        ActorUtil.RemovePackageOverride(akActor, v2Pkg)
    EndIf
    StorageUtil.UnsetIntValue(akActor, "SeverFollow_Overflow")
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] Overflow follow removed from " + akActor.GetDisplayName())
EndFunction

Function ClearFollowerSlot(Actor akActor)
    {Release the actor's follow alias (pool first), plus the transitional
     legacy slot and overflow pair (silent no-ops post-migration). Removing
     from the alias auto-removes the CK follow packages.}
    If !akActor
        Return
    EndIf
    RemoveOverflowFollow(akActor)
    Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
    If held >= 0
        ReferenceAlias heldAl = GetFollowAlias(held)
        If heldAl && heldAl.GetReference() == akActor
            heldAl.Clear()
        EndIf
        ; Index was stale (alias repurposed under us) — drop the bookkeeping
        ; either way; SweepFollowAliasesOnLoad owns the pool-side check.
        SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, -1)
        Debug.Trace("[SeverActions_Follow] Freed follow alias " + held + " for " + akActor.GetDisplayName())
    Else
        ; Index already -1 (e.g. ClearFollowerData ran before us on a dismiss —
        ; v18 wiped it pre-preserve) — fall back to a pool scan so the alias
        ; can't leak filled and leave the actor following post-dismiss.
        Int scan = 0
        While scan < FOLLOW_ALIAS_POOL_SIZE
            ReferenceAlias scanAl = GetFollowAlias(scan)
            If scanAl && scanAl.GetReference() == akActor
                scanAl.Clear()
                Debug.Trace("[SeverActions_Follow] Freed follow alias " + scan + " for " + akActor.GetDisplayName() + " (pool scan fallback)")
            EndIf
            scan += 1
        EndWhile
    EndIf
    _ClearLegacyFollowerSlot(akActor)
EndFunction

Bool Function IsInFollowerSlot(Actor akActor)
    {Check if an actor's follow is currently driven by ANY of the three
     mechanisms: the 200-alias pool (cosaved index + content verify), a
     legacy CK slot, or the overflow override pair (covers pre-migration
     state). Used to distinguish companions from casual followers
     (SkyrimNet follow).}
    If !akActor
        Return false
    EndIf
    Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
    If held >= 0
        ReferenceAlias heldAl = GetFollowAlias(held)
        If heldAl && heldAl.GetReference() == akActor
            Return true
        EndIf
    EndIf
    If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
        Return true
    EndIf
    If !FollowerSlots
        Return false
    EndIf
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            Return true
        EndIf
        i += 1
    EndWhile
    Return false
EndFunction

; =============================================================================
; FOLLOW POOL — load-time adoption + reconciliation sweep
; =============================================================================

Function SweepFollowAliasesOnLoad(Actor[] followers)
    {Load-time pool reconciliation + one-shot legacy adoption (the
     SweepSchedAliasesOnLoad pattern, for the follow pool).

     MIGRATION half (one-shot, sentinel SeverActions_FollowPoolMigDone):
     pre-pool saves arrive with followers on legacy CK slots or the overflow
     override pair — adopt them into the pool (clear the slot / strip the
     overrides, then seat). The overflow half is why this migration matters:
     those followers' packages dropped on every 3D unload with no
     mid-session re-heal.

     VERIFY half (every load — 200 GetReference calls, the sched sweep does
     600): pool aliases holding deleted/disabled or non-roster actors are
     emptied; duplicate fills resolve to the recorded index; recorded-index
     mismatches re-adopt; stale roster indices drop.

     Runs BEFORE ReapplyFollowTracking so the re-apply pass sees pool state,
     not legacy state.}
    Quest pool = GetFollowQuest()
    If !pool
        Return
    EndIf
    SeverActions_FollowerManager fmSwp = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager

    ; ── Migration half (one-shot) ──
    If StorageUtil.GetIntValue(None, "SeverActions_FollowPoolMigDone", 0) == 0
        Int mi = 0
        While mi < followers.Length
            Actor mf = followers[mi]
            If mf && !mf.IsDead()
                ; Same exemptions as ReapplyFollowTracking: track-only actors
                ; belong to an external framework, and a mid-travel companion
                ; deliberately has no follow apparatus (travel's own load
                ; recovery owns them; they seat when the trip ends).
                Bool migSkip = false
                If fmSwp && fmSwp.IsTrackOnlyFollower(mf)
                    migSkip = true
                ElseIf StorageUtil.GetStringValue(mf, "SeverTravel_State") != ""
                    migSkip = true
                EndIf
                If !migSkip
                    Bool adopted = false
                    If FollowerSlots
                        Int si = 0
                        While si < FollowerSlots.Length
                            If FollowerSlots[si] && FollowerSlots[si].GetActorRef() == mf
                                FollowerSlots[si].Clear()
                                adopted = true
                                Debug.Trace("[SeverActions_Follow] FollowPool migration: " + mf.GetDisplayName() + " adopted from legacy FollowerSlot" + si)
                            EndIf
                            si += 1
                        EndWhile
                    EndIf
                    If StorageUtil.GetIntValue(mf, "SeverFollow_Overflow", 0) == 1
                        RemoveOverflowFollow(mf)
                        adopted = true
                        Debug.Trace("[SeverActions_Follow] FollowPool migration: " + mf.GetDisplayName() + " adopted from overflow overrides")
                    EndIf
                    If adopted
                        AssignFollowerSlot(mf)
                    EndIf
                EndIf
            EndIf
            mi += 1
        EndWhile
        StorageUtil.SetIntValue(None, "SeverActions_FollowPoolMigDone", 1)
        Debug.Trace("[SeverActions_Follow] FollowPool migration pass complete (sentinel set)")
    EndIf

    ; ── Verify half (every load) ──
    ; Pool side: empty orphans; resolve duplicates to the recorded index;
    ; adopt content where the index is missing/stale.
    Int i = 0
    While i < FOLLOW_ALIAS_POOL_SIZE
        ReferenceAlias al = pool.GetNthAlias(i) as ReferenceAlias
        If al
            Actor a = al.GetReference() as Actor
            If a
                If a.IsDeleted() || a.IsDisabled()
                    al.Clear()
                    Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied alias " + i + " (deleted/disabled holder)")
                ElseIf (!fmSwp || !fmSwp.IsRegisteredFollower(a)) && !SeverActionsNative.Native_GetHasFollowPkg(a)
                    ; Stale holder: neither a registered companion NOR a casual
                    ; follower. A pool-seated CASUAL (StartFollowing on a guard /
                    ; random NPC) is a legitimate holder with hasFollowPkg set and
                    ; no roster row - the old companion-only test emptied their
                    ; alias on every load (field report: Narri, 2026-08-22 -
                    ; stripped at the sweep, re-seated seconds later by the
                    ; casual verifier, visible as "stops following on reload").
                    al.Clear()
                    Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied alias " + i + " (holder neither companion nor casual)")
                Else
                    Int claimed = SeverActionsNativeExt.Native_GetFollowAliasIndex(a)
                    If claimed != i
                        If claimed >= 0
                            ReferenceAlias other = GetFollowAlias(claimed)
                            If other && other.GetReference() == a
                                al.Clear()   ; duplicate fill — the recorded one wins
                                Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied duplicate alias " + i + " for " + a.GetDisplayName())
                            Else
                                SeverActionsNativeExt.Native_SetFollowAliasIndex(a, i)   ; recorded index was stale — adopt
                            EndIf
                        Else
                            SeverActionsNativeExt.Native_SetFollowAliasIndex(a, i)   ; adopt
                        EndIf
                    EndIf
                EndIf
            EndIf
        EndIf
        i += 1
    EndWhile
    ; Roster side: drop recorded indices whose alias no longer points at
    ; the follower (the next AssignFollowerSlot re-seats them).
    Int ri = 0
    While ri < followers.Length
        Actor rf = followers[ri]
        If rf
            Int rIdx = SeverActionsNativeExt.Native_GetFollowAliasIndex(rf)
            If rIdx >= 0
                ReferenceAlias ral = GetFollowAlias(rIdx)
                If !ral || ral.GetReference() != rf
                    SeverActionsNativeExt.Native_SetFollowAliasIndex(rf, -1)
                    Debug.Trace("[SeverActions_Follow] FollowPool sweep: dropped stale index " + rIdx + " for " + rf.GetDisplayName())
                EndIf
            EndIf
        EndIf
        ri += 1
    EndWhile
    Debug.Trace("[SeverActions_Follow] FollowPool load sweep complete")
EndFunction

; =============================================================================
; CAMP WAR-BAND MUSTER (Phase 3)
; =============================================================================
; A sworn camp can march with the player as a WAR BAND: every living member
; is seated in the same 200-alias follow pool companions use (the alias's CK
; packages apply natively and re-apply on cell load) and flagged a teammate
; so they join the player's fights. They are NOT companions: no
; FollowerDataStore row, no relationship assessments, no survival tracking -
; and TeammateMonitor explicitly skips camp members, so the teammate flag can
; never onboard them (the roster-pollution class the CellCatchup fix closed).
; Per-member bookkeeping rides StorageUtil (SeverCamp_MusterAlias) exactly
; like the rest of the follow system's runtime state; the camp-level flag
; lives in CampStore (cosave v5). Seating + flags + our StorageUtil marker
; all persist in the save natively, so a mid-raid save/load resumes intact.

Event OnCampMusterEvent(String eventName, String strArg, Float numArg, Form sender)
    Int campId = strArg as Int
    If campId == 0
        Return
    EndIf
    If numArg > 0.5
        MusterCampById(campId)
    Else
        SendCampHomeById(campId)
    EndIf
EndEvent

Function MusterCampById(Int aiCampId)
    {Rally every living member of the camp to the player: seat in the follow
     pool, flag teammate. Nearby members walk over; distant/unloaded ones
     SET OUT and arrive after a distance-honest travel time (the game-time
     pump below) - no instant teleports. TEMPORARY refs leave the form-ID
     map while their cell is detached, so a muster issued from AFAR can only
     reach who resolves - the truce sweep adopts the rest the moment they
     exist again (OnCampMusterAdopt), and the notification says so.}
    Actor player = Game.GetPlayer()
    Actor[] members = SeverActionsNativeExt2.Camp_GetMembers(aiCampId)
    Int enroute = 0
    Int i = 0
    While i < members.Length
        If _MusterOne(members[i], player) == 1
            enroute += 1
        EndIf
        i += 1
    EndWhile
    Int roster = SeverActionsNativeExt2.Camp_RosterCount(aiCampId)
    If roster > members.Length
        Debug.Notification("Word goes out - those in reach are moving; the rest rally when you next come near their camp")
    ElseIf enroute > 0
        Debug.Notification("Word goes out - the camp rallies to you")
    Else
        Debug.Notification("The camp musters to your side")
    EndIf
    ; The pump runs for the muster's whole life now - it completes travel
    ; ETAs AND keeps arrived members with the player (war-band catch-up).
    RegisterForSingleUpdateGameTime(0.1)
    Debug.Trace("[SeverActions_Follow] MusterCampById " + aiCampId + ": reached " + members.Length + " of roster " + roster + " (" + enroute + " en route)")
    SkyrimNetApi.RegisterEvent("camp_mustered", "The sworn camp rallies to " + player.GetDisplayName() + "'s side as a war band - those nearby fall in at once, the rest are on their way", player, None)
EndFunction

Int Function _MusterOne(Actor m, Actor akPlayer)
    {Seat ONE camp member as war band: follow-pool alias + teammate flag +
     the walk-over / set-out-with-ETA branch. Idempotent - re-running on a
     seated member just re-evaluates. Returns -1 skipped (confirmed dead,
     real companion, or pool exhausted), 0 fell in nearby, 1 set out.
     Shared by MusterCampById and the adopt-on-sight path.}
    ; Dead only counts when LOADED - IsDead() false-reports on unloaded
    ; actors (the lifestate gotcha).
    If !m || (m.IsDead() && m.Is3DLoaded())
        Return -1
    EndIf
    ; (Persistence seating is native now - the sweep holds sworn members
    ; the moment they resolve; nothing to do here.)
    ; A member who is already a real companion keeps their own seating -
    ; they are at your side through that system already.
    If SeverActionsNativeExt.Native_GetFollowAliasIndex(m) >= 0
        Return -1
    EndIf
    Int held = StorageUtil.GetIntValue(m, "SeverCamp_MusterAlias", -1)
    Bool needSeat = true
    If held >= 0
        ReferenceAlias heldAl = GetFollowAlias(held)
        If heldAl && heldAl.GetReference() == m
            needSeat = false
        Else
            StorageUtil.UnsetIntValue(m, "SeverCamp_MusterAlias")
        EndIf
    EndIf
    If needSeat
        Int idx = FindFreeFollowAlias()
        If idx < 0
            ; No alias = no follow package = a teammate flag would only
            ; make them drift. Leave them untouched; the adopt sweep can
            ; retry after send-home frees slots.
            Debug.Trace("[SeverActions_Follow] Muster: follow pool exhausted - " + m.GetDisplayName() + " left behind")
            Return -1
        EndIf
        ReferenceAlias al = GetFollowAlias(idx)
        If !al
            Return -1
        EndIf
        al.ForceRefTo(m)
        StorageUtil.SetIntValue(m, "SeverCamp_MusterAlias", idx)
    EndIf
    m.SetPlayerTeammate(true, true)
    If m.Is3DLoaded() && m.GetDistance(akPlayer) <= 4000.0
        ; Close enough to just walk over - the pool package handles it.
        m.EvaluatePackage()
        Return 0
    EndIf
    ; Off-screen or far: they SET OUT instead of teleporting (the
    ; IntelEngine model). The game-time pump completes the ARRIVAL when the
    ; distance-honest ETA elapses - sleeping/waiting fires it immediately
    ; after the skip, so time skips behave.
    Float hrs = SeverActionsNativeExt2.Camp_TravelHoursTo(m)
    StorageUtil.SetFloatValue(m, "SeverCamp_MusterETA", Utility.GetCurrentGameTime() + (hrs / 24.0))
    m.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] Muster: " + m.GetDisplayName() + " sets out - ETA " + hrs + "h")
    Return 1
EndFunction

; ── Camp persistence pool (see the property block up top) ────────────────

Quest Function GetCampPersistQuest()
    {Lazy-resolve the 300-alias persistence quest (the GetFollowQuest
     pattern). None while the ESP predates GenerateCampPersistQuest.pas —
     persistence seating no-ops gracefully; every other camp feature keeps
     working. Retried on each call until it resolves.}
    If _campPersistResolved
        Return _campPersistQuest
    EndIf
    _campPersistQuest = Game.GetFormFromFile(CAMP_PERSIST_QUEST_FORMID, "SeverActions.esp") as Quest
    If !_campPersistQuest
        If !_campPersistMissingWarned
            _campPersistMissingWarned = true
            Debug.Trace("[SeverActions_Follow] CampPersist quest 0x16A793 DID NOT RESOLVE - ESP predates GenerateCampPersistQuest.pas (or wrong ESP is winning). Persistence seating disabled this session.")
        EndIf
        Return None
    EndIf
    ; Belt: the first-cut ESP shipped the aliases without the Optional flag
    ; (FNAM=0), so the Start-Game-Enabled start FAILED (300 unfillable
    ; mandatory aliases) - and a failed SGE start can linger in a save.
    ; With the flags fixed a Start() succeeds; trace either way so the
    ; field log says exactly which world we are in.
    If !_campPersistQuest.IsRunning()
        Bool started = _campPersistQuest.Start()
        Debug.Trace("[SeverActions_Follow] CampPersist quest was not running - Start() -> " + started)
    EndIf
    _campPersistResolved = true
    Return _campPersistQuest
EndFunction

ReferenceAlias Function GetCampPersistAlias(Int aiIndex)
    If aiIndex < 0 || aiIndex >= CAMP_PERSIST_POOL_SIZE
        Return None
    EndIf
    Quest pool = GetCampPersistQuest()
    If !pool
        Return None
    EndIf
    Return pool.GetNthAlias(aiIndex) as ReferenceAlias
EndFunction

Function _UnpersistOne(Actor akMember)
    {Free one member's persistence alias. Native seating owns the FILL side
     now (CampStore::SeatInPersistPool), so freeing finds the slot by
     HOLDER SCAN - no bookkeeping key to trust. Safe on non-holders; also
     unsets the legacy dev96-99 StorageUtil key if one lingers.}
    If !akMember
        Return
    EndIf
    StorageUtil.UnsetIntValue(akMember, "SeverCamp_PersistAlias")
    If GetCampPersistQuest() == None
        Return
    EndIf
    Int s = 0
    While s < CAMP_PERSIST_POOL_SIZE
        ReferenceAlias al = GetCampPersistAlias(s)
        If al && al.GetReference() == akMember
            al.Clear()
            Return
        EndIf
        s += 1
    EndWhile
EndFunction

Function SweepCampPersistPool()
    {Janitor: free every persistence alias whose holder no longer
     qualifies — camp released or no longer sworn, or a CONFIRMED corpse
     (dead only counts when loaded; the lifestate gotcha). Runs on load
     (Maintenance) and on SeverActions_CampReleased.}
    If GetCampPersistQuest() == None
        Return
    EndIf
    Int freed = 0
    Int s = 0
    While s < CAMP_PERSIST_POOL_SIZE
        ReferenceAlias al = GetCampPersistAlias(s)
        If al
            Actor holder = al.GetReference() as Actor
            If holder
                Int cid = SeverActionsNativeExt2.Camp_CampIdOf(holder)
                Bool keep = cid != 0 && SeverActionsNativeExt2.Camp_IsSworn(cid)
                If keep && holder.IsDead() && holder.Is3DLoaded()
                    keep = false
                EndIf
                If !keep
                    StorageUtil.UnsetIntValue(holder, "SeverCamp_PersistAlias")
                    al.Clear()
                    freed += 1
                EndIf
            EndIf
        EndIf
        s += 1
    EndWhile
    If freed > 0
        Debug.Trace("[SeverActions_Follow] CampPersist sweep: freed " + freed + " alias(es)")
    EndIf
EndFunction

; ── Retainer persistence pool (native seats; Papyrus frees) ──────────────
Quest Function GetRetainerPersistQuest()
    {Lazy-resolve the 500-alias retainer persistence quest (the GetCampPersistQuest
     pattern). None until GenerateRetainerPersistQuest.pas has run — freeing then
     no-ops gracefully; native seating is likewise disabled and every other
     retainer feature keeps working.}
    If _retainerPersistResolved
        Return _retainerPersistQuest
    EndIf
    _retainerPersistQuest = Game.GetFormFromFile(RETAINER_PERSIST_QUEST_FORMID, "SeverActions.esp") as Quest
    If !_retainerPersistQuest
        If !_retainerPersistMissingWarned
            _retainerPersistMissingWarned = true
            Debug.Trace("[SeverActions_Follow] RetainerPersist quest 0x16B000 DID NOT RESOLVE - ESP predates GenerateRetainerPersistQuest.pas. Retainer un-persist disabled this session.")
        EndIf
        Return None
    EndIf
    If !_retainerPersistQuest.IsRunning()
        Bool started = _retainerPersistQuest.Start()
        Debug.Trace("[SeverActions_Follow] RetainerPersist quest was not running - Start() -> " + started)
    EndIf
    _retainerPersistResolved = true
    Return _retainerPersistQuest
EndFunction

ReferenceAlias Function GetRetainerPersistAlias(Int aiIndex)
    If aiIndex < 0 || aiIndex >= RETAINER_PERSIST_POOL_SIZE
        Return None
    EndIf
    Quest pool = GetRetainerPersistQuest()
    If !pool
        Return None
    EndIf
    Return pool.GetNthAlias(aiIndex) as ReferenceAlias
EndFunction

Function _UnpersistOneRetainer(Actor akRetainer)
    {Free one retainer's persistence alias by HOLDER SCAN — native seating owns
     the fill side, so there is no bookkeeping key to trust. Safe on non-holders.}
    If !akRetainer || GetRetainerPersistQuest() == None
        Return
    EndIf
    Int s = 0
    While s < RETAINER_PERSIST_POOL_SIZE
        ReferenceAlias al = GetRetainerPersistAlias(s)
        If al && al.GetReference() == akRetainer
            al.Clear()
            Return
        EndIf
        s += 1
    EndWhile
EndFunction

Function SweepRetainerPersistPool()
    {Janitor: free every persistence alias whose holder is no longer an active
     retainer (dismissed/deserted/hostile). Runs on load (the mid-session frees
     ride the SeverActions_RetainerUnpersist ping from the native heartbeat).}
    If GetRetainerPersistQuest() == None
        Return
    EndIf
    Int freed = 0
    Int s = 0
    While s < RETAINER_PERSIST_POOL_SIZE
        ReferenceAlias al = GetRetainerPersistAlias(s)
        If al
            Actor holder = al.GetReference() as Actor
            If holder && !SeverActionsNativeExt2.Venture_IsActiveRetainer(holder)
                al.Clear()
                freed += 1
            EndIf
        EndIf
        s += 1
    EndWhile
    If freed > 0
        Debug.Trace("[SeverActions_Follow] RetainerPersist sweep: freed " + freed + " alias(es)")
    EndIf
EndFunction

Event OnRetainerUnpersist(String eventName, String strArg, Float numArg, Form sender)
    {A retainer left service — free their persistence alias so they can despawn
     /respawn normally again. Native fires this per stale holder off the venture
     heartbeat; freeing is idempotent, so a repeat ping is harmless.}
    _UnpersistOneRetainer(sender as Actor)
EndEvent

Event OnCampMemberSeen(String eventName, String strArg, Float numArg, Form sender)
    {A SWORN camp member just became resolvable (temporary refs leave the
     form-ID map with their detached cell). This listener owns the muster-adopt
     duty: if their camp is mustered, seat the war band a remote muster could not
     reach. (Persistence seating is NATIVE now — CampStore::SeatInPersistPool at
     sweep time — see the inline note below.)}
    Actor m = sender as Actor
    If !m
        Debug.Trace("[SeverActions_Follow] MemberSeen: sender resolved to None - dropped")
        Return
    EndIf
    Int cid = SeverActionsNativeExt2.Camp_CampIdOf(m)
    If cid == 0 || !SeverActionsNativeExt2.Camp_IsSworn(cid)
        Debug.Trace("[SeverActions_Follow] MemberSeen: " + m.GetDisplayName() + " bailed (campId " + cid + ", sworn " + SeverActionsNativeExt2.Camp_IsSworn(cid) + ")")
        Return
    EndIf
    Debug.Trace("[SeverActions_Follow] MemberSeen: " + m.GetDisplayName() + " (camp " + cid + ")")
    ; Persistence seating is NATIVE now (CampStore::SeatInPersistPool at
    ; sweep time - immediate, no VM-thaw race). This listener only owns the
    ; muster-adopt side, where teammate flags + ETAs genuinely live.
    If SeverActionsNativeExt2.Camp_IsMustered(cid)
        If _MusterOne(m, Game.GetPlayer()) >= 0
            RegisterForSingleUpdateGameTime(0.1)
            Debug.Trace("[SeverActions_Follow] Muster adopt: " + m.GetDisplayName() + " joins the war band")
        EndIf
    EndIf
EndEvent

Event OnCampMemberDied(String eventName, String strArg, Float numArg, Form sender)
    {Death sink relay: free the corpse's persistence + muster aliases (a
     corpse pinned persistent forever is save bloat, and freed slots serve
     the living).}
    Actor m = sender as Actor
    If !m
        Return
    EndIf
    _UnpersistOne(m)
    Int held = StorageUtil.GetIntValue(m, "SeverCamp_MusterAlias", -1)
    If held >= 0
        ReferenceAlias al = GetFollowAlias(held)
        If al && al.GetReference() == m
            al.Clear()
        EndIf
        StorageUtil.UnsetIntValue(m, "SeverCamp_MusterAlias")
        StorageUtil.UnsetFloatValue(m, "SeverCamp_MusterETA")
        m.SetPlayerTeammate(false)
    EndIf
EndEvent

Event OnCampReleased(String eventName, String strArg, Float numArg, Form sender)
    {A camp was released or its oath renounced — the janitor frees every
     persistence alias whose holder no longer belongs to a sworn camp.}
    SweepCampPersistPool()
EndEvent

Event OnCasualFollowRecycle(String eventName, String strArg, Float numArg, Form sender)
    {Cell catchup just moved a CASUAL follower to the player. Field-proven
     (two sworn bandits, SkyrimNet debug log): across a load door the
     SkyrimNet FollowPlayer override can remain REGISTERED yet stop being
     served at package evaluation - the actor reverts to their default
     master package and stands there. Re-cycling the registration relinks
     SkyrimNet's hook. Idempotent; casuals only (the catchup gates the
     ping); guarded on the package actually being registered so a stopped
     follow is never resurrected.}
    Actor m = sender as Actor
    If !m || m.IsDead()
        Return
    EndIf
    ; Pool-seated casual: the alias package re-applies natively on cell load
    ; — the catch-up move only needs an eval nudge, no SkyrimNet relink.
    If IsInFollowerSlot(m)
        m.EvaluatePackage()
        Return
    EndIf
    If !SkyrimNetApi.HasPackage(m, "FollowPlayer")
        Return
    EndIf
    SkyrimNetApi.UnregisterPackage(m, "FollowPlayer")
    SkyrimNetApi.RegisterPackage(m, "FollowPlayer", FollowPackagePriority, 0, true)
    m.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] CasualFollowRecycle: relinked FollowPlayer for " + m.GetDisplayName())
EndEvent

Function SendCampHomeById(Int aiCampId)
    {Dismiss the war band: clear the seating and send everyone back to the
     camp's map marker. Also sweeps the pool for muster leftovers the roster
     no longer covers - a member who died mid-raid keeps an alias filled
     with a corpse (the death sink prunes the ROSTER, not the pool).}
    Actor player = Game.GetPlayer()
    ObjectReference home = SeverActionsNativeExt2.Camp_HomeMarker(aiCampId)
    If !home
        Debug.Trace("[SeverActions_Follow] SendCampHomeById " + aiCampId + ": no map marker - band released in place")
    EndIf
    Actor[] members = SeverActionsNativeExt2.Camp_GetMembers(aiCampId)
    Int cleared = 0
    Int i = 0
    While i < members.Length
        cleared += _UnmusterOne(members[i], home)
        i += 1
    EndWhile
    Int s = 0
    While s < FOLLOW_ALIAS_POOL_SIZE
        ReferenceAlias al = GetFollowAlias(s)
        If al
            Actor holder = al.GetReference() as Actor
            If holder && StorageUtil.GetIntValue(holder, "SeverCamp_MusterAlias", -1) == s
                If holder.IsDead() || SeverActionsNativeExt2.Camp_CampIdOf(holder) == aiCampId
                    cleared += _UnmusterOne(holder, home)
                EndIf
            EndIf
        EndIf
        s += 1
    EndWhile
    Debug.Notification("The war band returns to camp")
    Debug.Trace("[SeverActions_Follow] SendCampHomeById " + aiCampId + ": released " + cleared)
    SkyrimNetApi.RegisterEvent("camp_sent_home", "The war band is dismissed and returns to its camp", player, None)
EndFunction

Int Function _UnmusterOne(Actor akMember, ObjectReference akHome)
    {Clear one member's muster seating: alias, teammate flag, and the trip
     home. Idempotent - returns 1 only when there was seating to clear.
     A member still EN ROUTE (unelapsed ETA) never actually left camp
     off-screen, so clearing the ETA IS their trip cancellation; the
     MoveTo(home) is a no-op-scale correction for them.}
    If !akMember
        Return 0
    EndIf
    Int held = StorageUtil.GetIntValue(akMember, "SeverCamp_MusterAlias", -1)
    If held < 0
        Return 0
    EndIf
    ReferenceAlias al = GetFollowAlias(held)
    If al && al.GetReference() == akMember
        al.Clear()
    EndIf
    StorageUtil.UnsetIntValue(akMember, "SeverCamp_MusterAlias")
    StorageUtil.UnsetFloatValue(akMember, "SeverCamp_MusterETA")
    akMember.SetPlayerTeammate(false)
    If !(akMember.IsDead() && akMember.Is3DLoaded())
        If akHome
            akMember.MoveTo(akHome)
        EndIf
        akMember.EvaluatePackage()
    EndIf
    Return 1
EndFunction

; ── Muster pump: arrivals + war-band catch-up ────────────────────────────
; Game-time pump, alive for the muster's WHOLE life (0.1 game hours ≈ 18
; real seconds at timescale 20). Two duties:
;   1. EN ROUTE (unelapsed ETA): complete the off-screen journey when its
;      travel time lapses - the MoveTo is an ARRIVAL, not a snap.
;   2. ARRIVED (no ETA): war-band catch-up. Once a member has fallen in
;      they stay WITH the player like a follower - muster members carry no
;      FollowerDataStore row on purpose (roster-pollution guard), so
;      CellCatchup ignores them and the follow package alone never bridges
;      a fast travel (the "band stayed at Silent Moons" field report).
;      Any arrived member who is UNLOADED while the player has moved on is
;      brought along; loaded members are visibly walking and are never
;      snapped in view.
; Game-time updates FIRE IMMEDIATELY after a skip - and fast travel
; ADVANCES game time - so the band regroups the moment the player lands,
; and "wait 3 hours and they have arrived" works exactly like it reads.

Event OnUpdateGameTime()
    If _PumpMusterArrivals() > 0
        RegisterForSingleUpdateGameTime(0.1)
    EndIf
EndEvent

Int Function _PumpMusterArrivals()
    {Advance every seated muster member: complete elapsed travel ETAs,
     gather separated arrived members back to the player. Returns how many
     LIVING seated members the pump still watches (0 = quiet until the
     next muster or load).}
    Actor player = Game.GetPlayer()
    Float now = Utility.GetCurrentGameTime()
    Int watched = 0
    Int arrived = 0
    Int gathered = 0
    Int s = 0
    While s < FOLLOW_ALIAS_POOL_SIZE
        ReferenceAlias al = GetFollowAlias(s)
        If al
            Actor holder = al.GetReference() as Actor
            If holder && StorageUtil.GetIntValue(holder, "SeverCamp_MusterAlias", -1) == s
                If holder.IsDead() && holder.Is3DLoaded()
                    ; CONFIRMED corpse (dead only counts when loaded - the
                    ; lifestate gotcha) keeps its alias until send-home/
                    ; attrition; just make sure no stale trip survives it.
                    StorageUtil.UnsetFloatValue(holder, "SeverCamp_MusterETA")
                Else
                    watched += 1
                    Float eta = StorageUtil.GetFloatValue(holder, "SeverCamp_MusterETA", 0.0)
                    If eta > 0.0
                        If holder.Is3DLoaded() && holder.GetDistance(player) <= 4000.0
                            ; The player came to them (or they genuinely made
                            ; it) - the trip resolves itself, no placement.
                            StorageUtil.UnsetFloatValue(holder, "SeverCamp_MusterETA")
                            holder.EvaluatePackage()
                        ElseIf now >= eta
                            ; Travel time elapsed off-screen - this MoveTo is
                            ; an ARRIVAL after the journey, not a snap (the
                            ; IntelEngine distinction the field asked for).
                            StorageUtil.UnsetFloatValue(holder, "SeverCamp_MusterETA")
                            holder.MoveTo(player)
                            holder.EvaluatePackage()
                            arrived += 1
                        EndIf
                    ElseIf !holder.Is3DLoaded()
                        ; ARRIVED member left behind (fast travel, a door,
                        ; the player simply outpacing them until they
                        ; unloaded) - they ride with the war band. Silent,
                        ; like a vanilla follower catching up.
                        holder.MoveTo(player)
                        holder.EvaluatePackage()
                        gathered += 1
                    EndIf
                EndIf
            EndIf
        EndIf
        s += 1
    EndWhile
    If arrived == 1
        Debug.Notification("One of your war band arrives")
    ElseIf arrived > 1
        Debug.Notification(arrived + " of your war band arrive")
    EndIf
    If gathered > 0
        Debug.Trace("[SeverActions_Follow] Muster pump: gathered " + gathered + " war-band member(s) back to the player")
    EndIf
    Return watched
EndFunction

; =============================================================================
; SAVE/LOAD PERSISTENCE (Companions only)
; =============================================================================

Function ReapplyFollowTracking(Actor[] followers)
    {Re-apply runtime-only data for companions after save/load.
     The CK alias packages persist natively — this only restores:
     - LinkedRef (now persists via native cosave — auto-restores on game load)
     - Sandbox overrides for waiting companions
     Does NOT register with SkyrimNet — companion eligibility uses faction.}
    Actor player = Game.GetPlayer()
    SeverActions_FollowerManager fmTrk = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    Int i = 0
    While i < followers.Length
        Actor akActor = followers[i]
        Bool skipReapply = false
        If akActor && !akActor.IsDead()
            ; Track-only followers: their external framework owns follow. Never
            ; set the SA LinkedRef / OrphanCleanup entry / hasFollowPkg on them -
            ; the flag alone re-enables FollowDriftMonitor, CellCatchup and
            ; SandboxManager against an actor SA must not drive (the Kaidan
            ; strip/re-assert tug-of-war, audit C1). Also heal a stale flag
            ; written by older builds so cosaves self-repair on load.
            If fmTrk && fmTrk.IsTrackOnlyFollower(akActor)
                skipReapply = true
                SeverActionsNative.Native_SetPackageState(akActor, false, false, false)
                Debug.Trace("[SeverActions_Follow] ReapplyFollowTracking: skipped track-only " + akActor.GetDisplayName() + " (external AI owns follow)")
            ; Mid-travel companions: the trip start deliberately CLEARED the
            ; follow LinkedRef so the travel package can outrank it - re-arming
            ; it here reintroduces the documented leapfrog bug on any save made
            ; mid-journey. Travel's own load recovery owns these actors.
            ElseIf StorageUtil.GetStringValue(akActor, "SeverTravel_State") != ""
                skipReapply = true
                Debug.Trace("[SeverActions_Follow] ReapplyFollowTracking: skipped mid-travel " + akActor.GetDisplayName())
            EndIf
        EndIf
        If akActor && !akActor.IsDead() && !skipReapply
            ; Clean up any stale SkyrimNet FollowPlayer package that may have been
            ; layered on companions from prior versions. Companions use CK alias
            ; packages — a dual FollowPlayer causes AI flicker. Safe no-op if none exists.
            If IsInFollowerSlot(akActor) && SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
                SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
                Debug.Trace("[SeverActions_Follow] Cleaned stale SkyrimNet FollowPlayer from companion: " + akActor.GetDisplayName())
            EndIf

            ; Defensive LinkedRef re-assertion — not just redundant.
            ; The native cosave restores LinkedRefs on kPostLoadGame, but Papyrus
            ; scripts on quest OnInit / alias OnLoad run BEFORE kPostLoadGame and
            ; can cache null GetLinkedRef results if they query during that window.
            ; Re-setting here guarantees the ref is live by the time Maintenance()
            ; completes, even if the cosave was stale, corrupted, or lost.
            ; Also handles cell-transition scenarios where the engine may drop
            ; ExtraLinkedRef from the actor's active extra data.
            If SeverActions_FollowerFollowKW
                SeverActionsNative.LinkedRef_Set(akActor, player, SeverActions_FollowerFollowKW)
                ; Re-register with the native OrphanCleanup scanner. Its in-memory
                ; m_trackedFollowers map is cleared on every kPostLoadGame (see
                ; plugin.cpp), so without this call the scanner flags the companion
                ; as an orphan ~5s after load and OnOrphanCleanup (in FollowerManager)
                ; clears the LinkedRef — breaking follow on every reload.
                SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
            EndIf

            ; WFP alone missed SA's OWN wait when an external AI zeroed the AV
            ; (Serana audit 2026-08-18: her DLC scripts reset WaitingForPlayer,
            ; and this reapply then read waiting=False and force-re-followed a
            ; follower the player had just told to wait). The native sandboxing
            ; flag is SA's own record of an active wait hold and no other
            ; mod's scripts can clear it - trust either signal.
            Bool isWaiting = akActor.GetAV("WaitingForPlayer") > 0 || IsSandboxing(akActor)
            ; If they were waiting/sandboxing, re-apply sandbox package + tracking.
            ; 4th arg 0 = no AI reset — gentler transition; the EvaluatePackage
            ; call below picks up the new override immediately.
            If isWaiting && SandboxPackage
                ActorUtil.AddPackageOverride(akActor, SandboxPackage, SandboxPackagePriority, 0)
                SetSandboxFlag(akActor, true)
            EndIf

            ; Re-apply actively following faction based on current state
            SetActivelyFollowing(akActor, !isWaiting)

            ; Update native follow state for PrismaUI status badge
            SeverActionsNative.Native_SetPackageState(akActor, !isWaiting, false, false)

            akActor.EvaluatePackage()
            Debug.Trace("[SeverActions_Follow] Reapplied companion follow tracking for: " + akActor.GetDisplayName() + " (waiting=" + isWaiting + ")")
        EndIf
        i += 1
    EndWhile
EndFunction

; =============================================================================
; CASUAL FOLLOW — pool-seated (guards, random NPCs, temporary)
; Called by startfollowing.yaml / stopfollowing.yaml
; =============================================================================

SeverActions_Travel Function _GetTravelScript()
    {Resolve the sibling Travel script (same quest). Used to cancel an active
     travel/waiting slot when an actor is pulled back into following.}
    Return (Self as Quest) as SeverActions_Travel
EndFunction

Function SetFollowDistance(Actor akActor, String distance)
    {Per-follower trailing distance. "close"/"near"/"tight" walks them onto
     the SeverActions_FollowPlayerClose alias package (~150-200 units) via
     the CloseFollowFaction gate; anything else ("normal"/"default"/"far")
     returns them to the standard package (~500-600). Both packages sit on
     every FollowerSlot alias — Close first, gated on the faction — so the
     switch is just faction membership + re-evaluate. Faction membership
     persists in the save, so the preference survives reload and
     dismiss/re-recruit. Called by SkyrimNet via setfollowdistance.yaml and
     the Prisma Actions page.}
    if !akActor
        return
    endif
    Faction closeFac = Game.GetFormFromFile(0x16567B, "SeverActions.esp") as Faction
    if !closeFac
        Debug.Trace("[SeverActions_Follow] SetFollowDistance: CloseFollowFaction missing (old ESP?)")
        return
    endif
    String d = SeverActionsNative.StringToLower(distance)
    Bool wantClose = StringUtil.Find(d, "close") >= 0 || StringUtil.Find(d, "near") >= 0 || StringUtil.Find(d, "tight") >= 0
    if wantClose
        if !akActor.IsInFaction(closeFac)
            akActor.AddToFaction(closeFac)
        endif
        SkyrimNetApi.RegisterEvent("follow_distance", \
            akActor.GetDisplayName() + " will now stay close at " + Game.GetPlayer().GetDisplayName() + "'s side while following.", akActor, None)
        Debug.Notification(akActor.GetDisplayName() + " will follow close.")
    else
        if akActor.IsInFaction(closeFac)
            akActor.RemoveFromFaction(closeFac)
        endif
        SkyrimNetApi.RegisterEvent("follow_distance", \
            akActor.GetDisplayName() + " will now follow at a normal distance, giving " + Game.GetPlayer().GetDisplayName() + " room.", akActor, None)
        Debug.Notification(akActor.GetDisplayName() + " will follow at a normal distance.")
    endif
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] SetFollowDistance: " + akActor.GetDisplayName() + " close=" + wantClose)
EndFunction

Function StartFollowing(Actor akActor)
    {Start casual following for any NPC the LLM decides should follow temporarily.
     Rides the SAME 200-alias pool as companion follow: seats a pool slot +
     FollowerFollowKW LinkedRef, NO SkyrimNetApi.RegisterPackage (the pool alias's
     CK packages re-apply natively on cell load). Casual vs companion is
     distinguished by the ROSTER (Native_GetIsFollower), not the follow mechanism.}
    if !akActor || akActor.IsDead()
        return
    endif

    ; The Imperial Final Audit is unrecruitable BY DESIGN (Taxes P2) - same
    ; guard as RegisterFollower's; eligibility already hides the action.
    if SeverActionsNativeExt2.Venture_Audit_IsCollector(akActor)
        SkyrimNetApi.RegisterEvent("follower_recruit_failed",             akActor.GetDisplayName() + " serves the Imperial Treasury alone - the Final Audit follows no one. Whatever business you have with them can be conducted right where they stand.",             akActor, None)
        return
    endif

    ; Track-only follower: their own framework owns following. Mirror
    ; CompanionFollow's track-only branch - clear the vanilla wait flag and let
    ; their mod's packages resume; NEVER register our package or set
    ; hasFollowPkg (that flag re-enables the native follow monitors on an
    ; actor SA must not drive - audit C1's second surface).
    SeverActions_FollowerManager fmTO = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager

    ; STAND DOWN ONLY WHERE SOMEONE ELSE HOLDS THE ACTOR.
    ;
    ; The gate here was FrameworkMode == 1 for one day (2026-08-11) and that was
    ; wrong: it returned early for EVERY actor in Tracking mode, so the wheel's
    ; casual-follow button silently did nothing. An ordinary townsperson is owned
    ; by NOBODY, and "defer to whatever framework owns them" defers to nothing at
    ; all - SA is the only thing that could have made them walk, and it had just
    ; been told not to.
    ;
    ; Tracking mode means DO NOT FIGHT THE FRAMEWORK THAT OWNS THIS ACTOR. It
    ; does not mean do nothing for actors nobody owns. So the test is ownership,
    ; not mode: IsTrackOnlyFollower is Native_GetFollowerOwner reporting NFF,
    ; DLC or CustomAI. That still honours the original report (SA grabbing NPCs
    ; NFF wanted to manage) because an NFF follower answers TRUE here in either
    ; mode - and it is deliberately mode-independent, since driving someone
    ; else's follower is just as wrong in SeverActions mode.
    If fmTO && fmTO.IsTrackOnlyFollower(akActor)
        ; TAKE NO OWNERSHIP - but still RELEASE what we already hold. Returning
        ; bare left SA's own sandbox overrides (home 100 / play 105 /
        ; safe-interior 100 / furniture 80) and the waiting faction in place,
        ; all of which outrank the owning framework's follow package, so the
        ; NPC just stayed put. ClearWaitingFaction's own docstring records the
        ; field-proven version of this: casual followers frozen at load doors
        ; carrying waitfaction rank -1.
        fmTO.StripSandboxesForFollow(akActor)
        fmTO.ClearWorkSandboxForFollow(akActor)
        ClearWaitingFaction(akActor)
        SeverActions_Travel travelTrk = fmTO.GetTravelScript()
        If travelTrk
            travelTrk.CancelTravel(akActor, False)
        EndIf
        If fmTO.NFFResume(akActor)
            ; NFF owns them and has its own wait state - release it there, or a
            ; follower the player parked through us could never be un-parked.
            Debug.Trace("[SeverActions_Follow] StartFollowing: released " + akActor.GetDisplayName() + " through NFF")
        Else
            akActor.SetAV("WaitingForPlayer", 0)
            akActor.EvaluatePackage()
            Debug.Trace("[SeverActions_Follow] StartFollowing: " + akActor.GetDisplayName() + " is track-only - deferred to their own framework")
        EndIf
        Return
    EndIf

    ; Notify downstream listeners that the player has called this actor to
    ; their side. SeversHearth's camp sandbox layer registers for this and
    ; uses it to release a camp-pinned follower so they actually walk over
    ; instead of staying at the fire. strArg = "follow" so handlers can
    ; differentiate from "recruit" / "wait" if the action verb matters.
    ; The handler signature is (string eventName, string strArg, float numArg,
    ; Form sender). This engine's ModEvent passes EXACTLY the pushed args (no
    ; auto eventName), so push all FOUR in order: eventName, strArg(verb), numArg,
    ; sender(actor). (Earlier 2- and 3-push versions errored "Expected 4, got
    ; 2/3", so the camp release never fired.)
    int followEvt = ModEvent.Create("SeverActions_FollowerCalledByPlayer")
    if followEvt
        ModEvent.PushString(followEvt, "SeverActions_FollowerCalledByPlayer")
        ModEvent.PushString(followEvt, "follow")
        ModEvent.PushFloat(followEvt, 0.0)
        ModEvent.PushForm(followEvt, akActor)
        ModEvent.Send(followEvt)
    endif

    ; Tear down any active travel/waiting slot so a camp/waiting arrival package
    ; override (e.g. SeversHearth's CampSandboxPackage, applied at travel-package
    ; priority) is removed and can't out-prioritize the follow package we register
    ; below. restoreFollower=false — we apply follow ourselves. No-op if not traveling.
    SeverActions_Travel travelSys = _GetTravelScript()
    if travelSys
        travelSys.CancelTravel(akActor, false)
    endif

    ; Clear waiting state FIRST — prevents the engine from creating an FF-prefix
    ; runtime sandbox in the gap between sandbox removal and follow package registration.
    akActor.SetAV("WaitingForPlayer", 0)

    ; Break out of a safe-interior auto-sandbox (priority 100 — outranks the
    ; follow pool's quest priority 95). Self-gates on the InSafeInteriorSandbox
    ; flag, so it's a no-op for anyone not relaxing indoors; teleports the actor
    ; to the player so they don't have to path out of the house on their own.
    ExitSafeInteriorSandbox(akActor)

    ; Now safe to remove sandbox — follow package registration below will take over.
    ; Don't gate on IsSandboxing — if tracking was lost (save/load, timing),
    ; the PO3 override would stay forever. These are all safe no-ops if nothing is active.
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Drop any work-sandbox override (priority 110) so the pool follow package
    ; (quest priority 95) applied below isn't outranked — mirrors what recruit
    ; does for companions. The work ASSIGNMENT is preserved; StopFollowing
    ; removes the ActivelyFollowing faction, so the schedule re-applies work
    ; once they stop.
    SeverActions_FollowerManager fmWork = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    if fmWork
        fmWork.ClearWorkSandboxForFollow(akActor)
        ; Home (100) / play (105) / furniture (80) outrank casual follow (50)
        ; as well — strip them so the follow package registered below takes
        ; over. Safe-interior was handled above (it lives on this quest).
        fmWork.StripSandboxesForFollow(akActor)
    endif

    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Casual follow rides the SAME 200-alias pool as companion follow now.
    ; The old SkyrimNet FollowPlayer override was the documented 3D-unload
    ; hole: across a load door it stays REGISTERED yet stops being served at
    ; package evaluation (OnCasualFollowRecycle's field report) — the NPC
    ; walks back to their prior cell and only reattaches when the player
    ; returns (Irileth report, 2026-08-09). The pool alias's CK packages
    ; re-apply NATIVELY on cell load, so a casual follower walks through
    ; doors like a companion. No SkyrimNetApi.RegisterPackage — exactly ONE
    ; mechanism drives follow (the AI-flicker lesson). Casual vs companion
    ; is still distinguished by the ROSTER (Native_GetIsFollower), not by
    ; the follow mechanism.
    If SeverActions_FollowerFollowKW
        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
    Else
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerFollowKW not set!")
    EndIf
    AssignFollowerSlot(akActor)
    ; OrphanCleanup must know about the LinkedRef or it strips the anchor
    ; ~5s after the next load (registry is cleared at kPostLoadGame; the
    ; load sweep in VerifyCasualFollowPackages re-registers seated casuals).
    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
    SeverActionsNative.Native_SetPackageState(akActor, true, false, false)
    akActor.EvaluatePackage()

    ; Mark as actively following for ENGAGED tag in prompts
    SetActivelyFollowing(akActor, true)

    Debug.Notification(akActor.GetDisplayName() + " is now following you.")
EndFunction

Function StopFollowing(Actor akActor)
    {Stop casual following — frees the pool seat and follow LinkedRef (and
     unregisters any legacy SkyrimNet FollowPlayer registration on old saves).}
    if !akActor
        return
    endif

    ; Always clean up sandbox state unconditionally (defensive)
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Free the pool seat + follow LinkedRef (the casual mechanism since the
    ; pool migration) — but NEVER touch a registered companion's seat: their
    ; follow lifecycle belongs to CompanionStopFollowing, and this verb can
    ; be LLM-fired at anyone.
    If !SeverActionsNativeExt.Native_GetIsFollower(akActor)
        ClearFollowerSlot(akActor)
        SeverActionsNative.OrphanCleanup_UnregisterFollower(akActor)
        If SeverActions_FollowerFollowKW
            SeverActionsNative.LinkedRef_Clear(akActor, SeverActions_FollowerFollowKW)
        EndIf
    EndIf
    ; Legacy saves may still carry a SkyrimNet FollowPlayer registration
    ; instead — unregister that too (harmless no-op otherwise; the queue
    ; handles removal + EvaluatePackage internally, 0.15.4+).
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)

    ; Remove actively following state
    SetActivelyFollowing(akActor, false)

    ; Schedule alias pools: casual follow ended — refill the NPC's schedule
    ; alias if they're dismissed/homed (no-op if they immediately re-follow).
    SeverActions_FollowerManager fmStop = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmStop
        fmStop.RefillSchedAliasesAfterStop(akActor)
    EndIf

    Debug.Notification(akActor.GetDisplayName() + " stopped following you.")
    ; Same follow_state key. This is the MECHANICAL follow-stop - it fires on
    ; every relax/sandbox transition, not just a real parting - so it belongs
    ; with the rest of the state, not in the permanent record. A companion
    ; genuinely walking out is followerleaves.yaml -> follower_left_voluntarily,
    ; which stays persistent because it actually happened once and matters.
    RegisterFollowStateEvent(akActor, "follower_left", \
        akActor.GetDisplayName() + " stopped following " + Game.GetPlayer().GetDisplayName())
EndFunction

; =============================================================================
; COMPANION FOLLOW — CK alias-based package (formal companions only)
; Called internally by FollowerManager.RegisterFollower / UnregisterFollower
; =============================================================================

Function CompanionStartFollowing(Actor akActor)
    {Start companion following via our CK alias-based follow package.
     Assigns alias slot (auto-applies CK package) + sets LinkedRef to player.
     Only for formal companions recruited through SetCompanion.}
    if !akActor || akActor.IsDead()
        return
    endif

    ; Clear waiting state FIRST — so the CK alias follow package condition
    ; (WaitingForPlayer == 0) becomes valid BEFORE we remove the sandbox override.
    ; This prevents the engine from creating an FF-prefix runtime sandbox in the
    ; gap between sandbox removal and follow package activation.
    akActor.SetAV("WaitingForPlayer", 0)
    ; Resume must also drop the waiting-state faction Sandbox() added - it
    ; leaked on the standard wait->follow cycle, leaving the follower flagged
    ; 'waiting' to prompt selectors while actively following (audit).
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Now safe to remove sandbox — CK follow package is already eligible
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Also clean up any stale casual FollowPlayer package (shouldn't be here
    ; for companions, but defensive cleanup in case of prior bugs)
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

    ; Set linked ref to player (so CK follow package knows who to follow)
    If SeverActions_FollowerFollowKW
        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
    Else
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerFollowKW not set!")
    EndIf

    ; Schedule alias pools: a companion under direct follow control holds no
    ; schedule aliases — empty them before the CK follow package takes over.
    ; (No-op pre-migration; the work/home/play strips happened above.)
    SeverActions_FollowerManager fmSched = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSched
        fmSched.EmptySchedAliasesForFollow(akActor)
    EndIf

    ; Assign to alias slot — CK package auto-applies (persists across save/load)
    AssignFollowerSlot(akActor)

    ; No SkyrimNetApi.RegisterPackage — our CK alias package handles the AI.
    ; Companion eligibility uses SeverActions_FollowerFaction, not HasPackage.

    ; Mark as actively following for SkyrimNet prompt integration
    SetActivelyFollowing(akActor, true)

    ; Update native follow state for PrismaUI status badge
    SeverActionsNative.Native_SetPackageState(akActor, true, false, false)

    ; Register with native orphan cleanup so stale follow packages get detected
    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)

    akActor.EvaluatePackage()
EndFunction

Function CompanionStopFollowing(Actor akActor, Bool evaluateAfter = true)
    {Stop companion following — clears alias slot (auto-removes CK package) and LinkedRef.
     Pass evaluateAfter=false when the caller will apply a new package immediately after
     (e.g., dismiss→SendHome), to avoid a zero-package EvaluatePackage gap that creates
     an FF-prefix fallback package.}
    if !akActor
        return
    endif

    ; Always clean up sandbox state unconditionally (defensive)
    SetSandboxFlag(akActor, false)
    SeverActionsNative.UnregisterSandboxUser(akActor)
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Clear alias slot — CK package auto-removes
    ClearFollowerSlot(akActor)

    ; Unregister from orphan cleanup tracking
    SeverActionsNative.OrphanCleanup_UnregisterFollower(akActor)

    ; Clear ALL tracked LinkedRefs — not just our follow keyword.
    ; If the actor had active travel, furniture, or arrest LinkedRefs when dismissed,
    ; per-keyword Clear only removes the follow entry. ClearAll catches everything,
    ; preventing stale LinkedRefs from persisting in the cosave and restoring on load.
    ; Each subsystem still clears its own keyword on normal completion — this is the
    ; belt-and-suspenders final sweep for crash/interrupt scenarios.
    SeverActionsNative.LinkedRef_ClearAll(akActor)
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Also unregister from SkyrimNet in case they had a casual follow registered too
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

    ; No longer actively following
    SetActivelyFollowing(akActor, false)

    ; Update native follow state for PrismaUI status badge
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)

    ; Schedule alias pools: companion follow ended — refill the NPC's schedule
    ; alias if they're dismissed/homed (no-op when the caller immediately
    ; re-follows or waits them; Reconcile's guards handle those).
    SeverActions_FollowerManager fmSchedStop = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedStop
        fmSchedStop.RefillSchedAliasesAfterStop(akActor)
    EndIf

    If evaluateAfter
        akActor.EvaluatePackage()
    EndIf
EndFunction

; =============================================================================
; SHARED FUNCTIONS — Work for both casual and companion follow
; =============================================================================

Function WaitHere(Actor akActor)
    if !akActor
        return
    endif

    ; Set waiting state - package condition will make them stop following
    akActor.SetAV("WaitingForPlayer", 1)

    ; Schedule alias pools: an explicit player 'wait here' must release any
    ; schedule aliases so the next reconcile can't convert the wait into a
    ; work shift (the WFP==1 guard in Reconcile/Fill mirrors the legacy rule).
    SeverActions_FollowerManager fmSchedWait = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedWait
        fmSchedWait.EmptySchedAliasesForFollow(akActor)
    EndIf

    ; No longer actively following (waiting in place)
    SetActivelyFollowing(akActor, false)

    ; Clear hasFollowPkg in the native data store. Without this, the
    ; FollowerTeleportDistance system in SandboxManager still sees the
    ; actor as "actively following" and will yank them across cells the
    ; next time the player gets ~2000 units away — exactly the
    ; "waiting follower keeps teleporting" complaint.
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)

    akActor.EvaluatePackage()

    Debug.Notification(akActor.GetDisplayName() + " is waiting here.")
    ; Short-lived and keyed on the SAME follow_state_<fid> id FollowerManager
    ; uses, deliberately: CompanionWait calls through here, so the persistent
    ; version logged this line AND companion_waiting for one act. Sharing the
    ; key means the pair collapses to a single up-to-date line per companion.
    RegisterFollowStateEvent(akActor, "follower_waiting", \
        akActor.GetDisplayName() + " is waiting for " + Game.GetPlayer().GetDisplayName())
EndFunction

Function Sandbox(Actor akActor)
    if !akActor || akActor.IsDead()
        return
    endif

    if !SandboxPackage
        Debug.Trace("[SeverActions_Follow] Sandbox: No SandboxPackage assigned!")
        return
    endif

    ; Apply sandbox package FIRST so there's always a valid high-priority package
    ; on the actor. If we set WaitingForPlayer before this, the CK alias follow
    ; package drops and the engine creates a fallback runtime sandbox (FF-prefix)
    ; in the gap before our override is applied.
    ; Priority 100 (was 55) wins decisively against typical follower-framework
    ; overrides; 4th arg 0 (was 1) skips the AI reset for a gentler transition.
    ActorUtil.AddPackageOverride(akActor, SandboxPackage, SandboxPackagePriority, 0)

    ; NOW safe to disable the CK follow package — sandbox is already covering
    SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")
    akActor.SetAV("WaitingForPlayer", 1)

    ; Force immediate AI re-evaluation so the transition happens now, not on
    ; the next vanilla tick (which can be many seconds away). Matches the
    ; Sever's Hearth camp-sandbox path — the missing EvaluatePackage here
    ; was the root cause of "I told them to wait but they're still trailing me"
    ; reports.
    akActor.EvaluatePackage()

    ; Note: do NOT call Native_SetPackageState(false) here. StopSandbox
    ; below reads Native_GetHasFollowPkg to detect "SA-managed" vs
    ; "track-only" — clearing hasFollowPkg would break the resume path.
    ; SandboxManager's teleport gate already skips this actor via the
    ; isSandboxing flag set by SetSandboxFlag() below.

    ; Track sandbox state via the native FollowerDataStore flag (reliable, immediate).
    ; We skip SkyrimNet's RegisterPackage("Sandbox") entirely — "Sandbox" isn't in
    ; PackageFormCache so it always fails. Our native isSandboxing flag replaces it.
    SetSandboxFlag(akActor, true)

    ; Schedule alias pools: manual sandbox is direct player control — release
    ; any schedule aliases so the schedule can't pull them off mid-relax.
    SeverActions_FollowerManager fmSchedSbx = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedSbx
        fmSchedSbx.EmptySchedAliasesForFollow(akActor)
    EndIf

    ; No SandboxManager registration — the wait action means "stay here" permanently.
    ; Player manually resumes via StopSandbox/hotkey when they want the NPC back.

    ; No longer actively following (relaxing in place)
    SetActivelyFollowing(akActor, false)

    ; Add waiting faction so other mods (e.g., IntelEngine) can blacklist waiting NPCs
    If SeverActions_WaitingFaction
        akActor.AddToFaction(SeverActions_WaitingFaction)
    EndIf
    ; No EvaluatePackage — faction add doesn't need forced eval, AI picks it up naturally

    RegisterFollowStateEvent(akActor, "follower_relaxing", akActor.GetDisplayName() + " decides to relax and wander around the area.")
EndFunction

Function StopSandbox(Actor akActor)
    if !akActor
        return
    endif

    ; Snapshot whether the actor was actually relaxing before we tear down. The
    ; notification + persistent event below are only meaningful when this call
    ; actually ended a sandbox session — CompanionWait's track-only recovery
    ; path calls StopSandbox defensively even when nothing was active, and that
    ; would otherwise produce a misleading "<name> stopped relaxing." message
    ; followed immediately by "<name> is waiting here for you."
    Bool wasSandboxing = IsSandboxing(akActor)

    ; Clear waiting state FIRST — so the CK alias follow package condition
    ; (WaitingForPlayer == 0) becomes valid BEFORE we remove the sandbox override.
    ; For casual followers, this ensures SkyrimNet's FollowPlayer (re-registered below)
    ; isn't competing with an FF-prefix runtime sandbox the engine creates in the gap.
    akActor.SetAV("WaitingForPlayer", 0)

    ; Clear sandbox state
    SetSandboxFlag(akActor, false)

    ; Remove waiting faction
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    ; Unregister from native SandboxManager
    SeverActionsNative.UnregisterSandboxUser(akActor)

    ; Now safe to remove sandbox override — follow package is already eligible
    if SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    endif

    ; Re-apply follow package only for casual followers SA actually manages.
    ;
    ; Three populations come through here:
    ;   1. SA companions (IsInFollowerSlot=true) — use the CK alias package, which
    ;      auto-reasserts when WaitingForPlayer clears. Registering SkyrimNet's
    ;      FollowPlayer on top creates dual-package AI flicker.
    ;   2. Casual SA followers on LEGACY saves / pool overflow — hasFollowPkg=true,
    ;      not pool-seated. These want SkyrimNet's FollowPlayer back. (Post-pool-
    ;      migration casuals are pool-seated by StartFollowing and fall into
    ;      population 1, correctly skipping the FollowPlayer re-register.)
    ;   3. Track-only followers (Inigo, Lucien, Kaidan, Daegon-keyword, etc.) being
    ;      defensively cleaned by CompanionWait's recovery path — they're not in
    ;      our slot AND hasFollowPkg=false because SA has never put a follow
    ;      package on them. Their own mods drive AI. Registering FollowPlayer here
    ;      was the previous bug: it stuck a stray SkyrimNet_FollowPlayerPackage
    ;      on them that the WaitingForPlayer flag immediately gated off, leaving
    ;      them standing in place with no active package and the wrong mod's
    ;      package suppressed.
    Bool isSAManaged = SeverActionsNative.Native_GetHasFollowPkg(akActor)
    If !IsInFollowerSlot(akActor) && isSAManaged
        SkyrimNetApi.RegisterPackage(akActor, "FollowPlayer", FollowPackagePriority, 0, true)
    EndIf

    ; Always force immediate AI re-evaluation so the transition happens now,
    ; not on the next vanilla tick. Mirrors the EvaluatePackage call in
    ; Sandbox() above. The casual SA-managed branch also benefits — SkyrimNet
    ; RegisterPackage queues async, so an explicit eval here closes the
    ; window where the actor could still be sitting on the removed sandbox
    ; override's previous tick.
    akActor.EvaluatePackage()

    ; Back to actively following — only when a follow actually exists to resume
    ; (dismissed/homed NPCs get no follow package; a stale flag silently freezes
    ; their work schedule — issue #14 regression).
    If IsInFollowerSlot(akActor) || SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
        SetActivelyFollowing(akActor, true)
    EndIf

    ; Schedule alias pools: sandbox control ended — refill the NPC's schedule
    ; alias if they're dismissed/homed (no-op when follow resumed above).
    SeverActions_FollowerManager fmSchedStopSbx = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmSchedStopSbx
        fmSchedStopSbx.RefillSchedAliasesAfterStop(akActor)
    EndIf

    ; Only surface the "stopped relaxing" feedback when there was actually a
    ; sandbox session to stop. See wasSandboxing snapshot at the top of the
    ; function for context.
    If wasSandboxing
        Debug.Notification(akActor.GetDisplayName() + " stopped relaxing.")
        RegisterFollowStateEvent(akActor, "follower_relax_stopped", akActor.GetDisplayName() + " stops relaxing and is ready to move.")
    EndIf
EndFunction

; =============================================================================
; GLOBAL API FOR ACTIONS
; =============================================================================

; --- StartFollowing Action (Casual) ---
; StartFollowing_IsEligible is reused as a shared eligibility helper by
; SeverActions_WheelMenu and SeverActions_Hotkeys. Actions bind member
; functions directly via executionFunctionName — no per-action global wrappers.

Bool Function StartFollowing_IsEligible(Actor akActor) Global
    if !akActor || akActor.IsDead() || akActor.IsInCombat()
        return false
    endif

    ; Don't allow vanilla followers
    Faction factionCompanion = Game.GetFormFromFile(0x084D1B, "Skyrim.esm") as Faction
    if factionCompanion && akActor.IsInFaction(factionCompanion)
        return false
    endif

    ; Check both casual (SkyrimNet package) and companion (alias slot) follow state.
    ; Resolve via the single SeverActions quest (0x000D62) -- the old 0x000800
    ; FormID resolved to nothing, so the isCompanion branch below never ran and
    ; actively-following companions stayed eligible for StartFollowing.
    Bool hasPackage = SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
    SeverActions_Follow instance = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_Follow
    Bool isCompanion = instance && instance.IsInFollowerSlot(akActor)
    Bool isWaiting = akActor.GetAV("WaitingForPlayer") > 0
    Bool isSandboxing = SeverActionsNativeExt.Native_GetSandboxing(akActor)

    ; Companions who are waiting/sandboxing — eligible (will route to CompanionStartFollowing)
    If isCompanion
        return isWaiting || isSandboxing
    EndIf

    ; Casual followers already actively following — not eligible
    if hasPackage && !isWaiting && !isSandboxing
        return false
    endif

    return true
EndFunction

Event OnExternalWaitAdopt(String eventName, String strArg, Float numArg, Form sender)
    {A third-party follower-command mod (Swiftly Order Squad class) parked one
     of OUR companions with a bare SetAV(WaitingForPlayer, 1). Vanilla
     followers have a wait package behind that flag; SA companions don't -
     they'd drop to default AI and walk home. Adopt the intent: apply the
     real SA wait (sandbox package + waiting faction + flags). Native side
     confirms over two scans and cools 60s per actor; re-validate here since
     Papyrus may have acted in between.}
    Actor akActor = sender as Actor
    If !akActor || akActor.IsDead()
        Return
    EndIf
    If akActor.GetAV("WaitingForPlayer") != 1.0
        Return
    EndIf
    If IsSandboxing(akActor)
        Return
    EndIf
    Debug.Trace("[SeverActions_Follow] Adopting external wait on " + akActor.GetDisplayName() + " (third-party WaitingForPlayer=1)")
    Sandbox(akActor)
EndEvent

; ============================================================================
; SCENE EVENTS
; ============================================================================

Int Property FollowStateTTLMs = 300000 Auto
{How long a follow-state line stays in scene context (ms).}

Function RegisterFollowStateEvent(Actor akActor, String asType, String asText)
    {Following / waiting / relaxing is STATE, not history.

     A companion is in exactly one of these at a time, and the mechanics flip
     between them constantly - the sandbox system alone starts and stops relax
     on its own schedule. As persistent events that meant a permanent line per
     transition per companion, which is what buried users running a large
     retinue in -decides to relax and wander around the area-.

     Every state line shares ONE eventId per actor - follow_state_<fid> -
     because the id is SkyrimNet's REPLACE key: only the newest event under an
     id survives, so each companion occupies a single line saying what they
     are doing NOW, instead of a log of everything they have ever done.
     SeverActions_FollowerManager keys its wait/resume pair the same way on
     purpose: CompanionWait calls through this script, so the two used to log
     the same act twice.

     Genuine one-off history stays on RegisterEvent /
     RegisterPersistentEvent - a companion actually walking out, an arrest, a
     debt. Those happened once and are worth remembering.}

    If akActor == None
        Return
    EndIf
    SkyrimNetApi.RegisterShortLivedEvent("follow_state_" + akActor.GetFormID(), \
        asType, asText, "", FollowStateTTLMs, akActor, Game.GetPlayer())
EndFunction
