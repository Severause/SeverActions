; =============================================================================
; HELPER - Check if actor has follow package
; =============================================================================

Bool Function HasFollowPackage(Actor akActor)
    {True while akActor actively follows: IsInFollowerSlot (pool seat, legacy
     slot or overflow) or a legacy SkyrimNet FollowPlayer registration.
     Mechanism-based on purpose: do NOT test the
     ActivelyFollowing faction, whose membership has survived removal and
     wedged the hotkey/wheel follow toggle. It is a prompt tag, not state.}
    if !akActor
        return false
    endif
    If IsInFollowerSlot(akActor)
        return true
    EndIf
    return SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
EndFunction

; =============================================================================
; ACTIVELY FOLLOWING FACTION — dynamic state for SkyrimNet prompt integration
; =============================================================================

Function SetActivelyFollowing(Actor akActor, Bool active)
    {Add or remove the SeverActions_ActivelyFollowing faction on every follow
     state change.}
    If !SeverActions_ActivelyFollowing || !akActor
        Return
    EndIf
    If active
        akActor.AddToFaction(SeverActions_ActivelyFollowing)
    Else
        ; TRUE removal (RemoveFromFaction leaves rank -1 residue; see
        ; ClearWaitingFaction). removedClean goes in the warning below.
        Bool removedClean = SeverActionsNativeExt2.Faction_RemoveClean(akActor, SeverActions_ActivelyFollowing)
        ; A membership has survived RemoveClean (issue #437): on a real survivor
        ; (rank >= 0; a non-member reads -1) log loudly and fall back to
        ; RemoveFromFaction. Its -1 residue is acceptable: follow detection reads
        ; the pool seat and SkyrimNet readers test get_faction_rank >= 0.
        Int survivedRank = akActor.GetFactionRank(SeverActions_ActivelyFollowing)
        If survivedRank >= 0
            Debug.Trace("[SeverActions_Follow] WARNING: ActivelyFollowing survived Faction_RemoveClean on " + akActor.GetDisplayName() + " (rank " + survivedRank + ", removedClean=" + removedClean + ") - RemoveFromFaction fallback applied")
            akActor.RemoveFromFaction(SeverActions_ActivelyFollowing)
        EndIf
    EndIf
EndFunction

Function ClearWaitingFaction(Actor akActor)
    {TRUE removal of the waiting faction. RemoveFromFaction only writes rank
     -1, which rank-blind readers (IsInFaction, GetInFaction package
     conditions, IntelEngine's wait check) still read as WAITING - casual
     followers froze at load doors that way.}
    If !akActor || !SeverActions_WaitingFaction
        Return
    EndIf
    SeverActionsNativeExt2.Faction_RemoveClean(akActor, SeverActions_WaitingFaction)
EndFunction

; =============================================================================
; FOLLOW ALIAS POOL
; =============================================================================

Quest Function GetFollowQuest()
    {The 200-alias follow quest, resolved by FormID (never an ESP property)
     and cached once found. None on an ESP without the pool (AssignFollowerSlot
     then uses the legacy slots); retried each call until it resolves.}
    If _followQuestResolved
        Return _followQuest
    EndIf
    _followQuest = Game.GetFormFromFile(FOLLOW_QUEST_FORMID, "SeverActions.esp") as Quest
    If !_followQuest
        Debug.Trace("[SeverActions_Follow] FOLLOW ALIAS POOL UNAVAILABLE — SeverActions_FollowQuest failed to resolve from SeverActions.esp (outdated ESP?). Pool seating disabled; legacy 21-slot + overflow follow remains active.")
        Return None
    EndIf
    _followQuestResolved = true
    Return _followQuest
EndFunction

ReferenceAlias Function GetFollowAlias(Int aiIndex)
    If aiIndex < 0 || aiIndex >= FOLLOW_ALIAS_POOL_SIZE
        Return None
    EndIf
    Quest pool = GetFollowQuest()
    If !pool
        Return None
    EndIf
    Return pool.GetNthAlias(aiIndex) as ReferenceAlias
EndFunction

Function AssignFollowerSlot(Actor akActor)
    {Seat the actor in the follow pool (the alias packages apply on ForceRefTo
     and re-apply on cell load). A legacy slot or overflow pair is stripped
     first so one mechanism drives follow; overflow is only the >200 fallback.}
    If !akActor
        Return
    EndIf
    Quest pool = GetFollowQuest()
    If pool
        ; Already-seated fast path: the cosaved index names an alias that
        ; still points at this actor.
        Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
        If held >= 0
            ReferenceAlias heldAl = GetFollowAlias(held)
            If heldAl && heldAl.GetReference() == akActor
                Return
            EndIf
            ; Stale index (alias repurposed): drop it; SweepFollowAliasesOnLoad
            ; checks the pool side.
            SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, -1)
        EndIf
        ; A pre-pool save can hold a legacy slot or the overflow pair; two
        ; stacked mechanisms flicker the AI.
        _ClearLegacyFollowerSlot(akActor)
        If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
            RemoveOverflowFollow(akActor)
        EndIf
        ; The pool's claim (plan M-W, P2-09): a free alias, or the one this actor
        ; already fills; the fill itself stays here (F19).
        Int idx = SeverActionsNativeExt2.FollowPool_Claim(akActor, "follow")
        If idx >= 0
            ReferenceAlias al = GetFollowAlias(idx)
            If al
                al.ForceRefTo(akActor)
                SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, idx)
                If StorageUtil.GetIntValue(akActor, "SeverCamp_MusterAlias", -1) == idx
                    ; A mustered camp member recruited: the claim is now "follow", so
                    ; drop the muster keys (a send-home must not clear this seat).
                    StorageUtil.UnsetIntValue(akActor, "SeverCamp_MusterAlias")
                    StorageUtil.UnsetFloatValue(akActor, "SeverCamp_MusterETA")
                EndIf
                Debug.Trace("[SeverActions_Follow] Seated " + akActor.GetDisplayName() + " in follow alias " + idx)
                Return
            EndIf
            SeverActionsNativeExt2.FollowPool_Release(idx)   ; no alias object behind the index: the claim goes back
        EndIf
        ; Pool full (>200 followers): the override pair.
        ApplyOverflowFollow(akActor)
        Return
    EndIf
    ; ESP without the pool: legacy slots.
    _AssignLegacyFollowerSlot(akActor)
EndFunction

Function _AssignLegacyFollowerSlot(Actor akActor)
    {Pre-pool ESP only: the 21 CK slots, then overflow. Never fill a legacy
     slot otherwise.}
    If !FollowerSlots
        Debug.Trace("[SeverActions_Follow] WARNING: FollowerSlots array not set - alias follow disabled")
        Return
    EndIf

    ; Check if actor is already in a slot (avoid duplicates)
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            Debug.Trace("[SeverActions_Follow] " + akActor.GetDisplayName() + " already in FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile

    ; Find first empty slot
    i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && !FollowerSlots[i].GetActorRef()
            ; Strip overflow overrides first, or the alias package and the PO3
            ; pair run together (AI flicker).
            If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
                RemoveOverflowFollow(akActor)
            EndIf
            FollowerSlots[i].ForceRefTo(akActor)
            Debug.Trace("[SeverActions_Follow] Assigned " + akActor.GetDisplayName() + " to FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile

    ; All 21 slots taken: ride the same packages as PO3 overrides (appending
    ; aliases to this quest hangs the engine). Their own conditions still gate
    ; them (Close on CloseFollowFaction, both on WaitingForPlayer == 0), and
    ; FollowDriftMonitor re-asserts drift.
    ApplyOverflowFollow(akActor)
EndFunction

Function _ClearLegacyFollowerSlot(Actor akActor)
    {Clear the actor's legacy CK slot if held (usually a no-op).}
    If !FollowerSlots
        Return
    EndIf
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            FollowerSlots[i].Clear()
            Debug.Trace("[SeverActions_Follow] Cleared " + akActor.GetDisplayName() + " from FollowerSlot" + i)
            Return
        EndIf
        i += 1
    EndWhile
EndFunction

Function ApplyOverflowFollow(Actor akActor)
    {Follow via package override for followers beyond the alias pool. Close
     (faction-gated, prio 55) above V2 (prio 50) — both below the sandbox/
     wait overrides (100+) so Wait/relax still wins.}
    Package closePkg = Game.GetFormFromFile(0x0016567C, "SeverActions.esp") as Package
    Package v2Pkg = Game.GetFormFromFile(0x00155C93, "SeverActions.esp") as Package
    If closePkg
        ActorUtil.AddPackageOverride(akActor, closePkg, 55, 1)
    EndIf
    If v2Pkg
        ActorUtil.AddPackageOverride(akActor, v2Pkg, 50, 1)
    EndIf
    StorageUtil.SetIntValue(akActor, "SeverFollow_Overflow", 1)
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] OVERFLOW follow (no free alias slot) applied to " + akActor.GetDisplayName())
EndFunction

Function RemoveOverflowFollow(Actor akActor)
    {Strip the overflow follow overrides. Safe no-op when never applied.}
    If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) != 1
        Return
    EndIf
    Package closePkg = Game.GetFormFromFile(0x0016567C, "SeverActions.esp") as Package
    Package v2Pkg = Game.GetFormFromFile(0x00155C93, "SeverActions.esp") as Package
    If closePkg
        ActorUtil.RemovePackageOverride(akActor, closePkg)
    EndIf
    If v2Pkg
        ActorUtil.RemovePackageOverride(akActor, v2Pkg)
    EndIf
    StorageUtil.UnsetIntValue(akActor, "SeverFollow_Overflow")
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] Overflow follow removed from " + akActor.GetDisplayName())
EndFunction

Function ClearFollowerSlot(Actor akActor)
    {Release the actor's follow alias (which drops its packages), plus any
     legacy slot or overflow pair.}
    If !akActor
        Return
    EndIf
    RemoveOverflowFollow(akActor)
    Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
    If held >= 0
        ReferenceAlias heldAl = GetFollowAlias(held)
        If heldAl && heldAl.GetReference() == akActor
            heldAl.Clear()
            SeverActionsNativeExt2.FollowPool_Release(held)
        ElseIf heldAl && heldAl.GetReference() == None
            SeverActionsNativeExt2.FollowPool_Release(held)   ; the alias is empty: whatever claim sat on it is stale
        EndIf
        ; Drop the index either way; SweepFollowAliasesOnLoad checks the pool side.
        SeverActionsNativeExt.Native_SetFollowAliasIndex(akActor, -1)
        Debug.Trace("[SeverActions_Follow] Freed follow alias " + held + " for " + akActor.GetDisplayName())
    Else
        ; No index (e.g. ClearFollowerData ran first on a dismiss): scan the
        ; pool so the alias can't leak filled and keep them following.
        Int scan = 0
        While scan < FOLLOW_ALIAS_POOL_SIZE
            ReferenceAlias scanAl = GetFollowAlias(scan)
            If scanAl && scanAl.GetReference() == akActor
                scanAl.Clear()
                SeverActionsNativeExt2.FollowPool_Release(scan)
                Debug.Trace("[SeverActions_Follow] Freed follow alias " + scan + " for " + akActor.GetDisplayName() + " (pool scan fallback)")
            EndIf
            scan += 1
        EndWhile
    EndIf
    _ClearLegacyFollowerSlot(akActor)
EndFunction

Bool Function IsInFollowerSlot(Actor akActor)
    {True when the actor's follow is driven by the pool (cosaved index +
     alias content), a legacy CK slot or the overflow pair. Pool-seated
     casuals count too: the roster (Native_GetIsFollower), not this, tells
     companions from casuals.}
    If !akActor
        Return false
    EndIf
    Int held = SeverActionsNativeExt.Native_GetFollowAliasIndex(akActor)
    If held >= 0
        ReferenceAlias heldAl = GetFollowAlias(held)
        If heldAl && heldAl.GetReference() == akActor
            Return true
        EndIf
    EndIf
    If StorageUtil.GetIntValue(akActor, "SeverFollow_Overflow", 0) == 1
        Return true
    EndIf
    If !FollowerSlots
        Return false
    EndIf
    Int i = 0
    While i < FollowerSlots.Length
        If FollowerSlots[i] && FollowerSlots[i].GetActorRef() == akActor
            Return true
        EndIf
        i += 1
    EndWhile
    Return false
EndFunction

; =============================================================================
; FOLLOW POOL — load-time adoption + reconciliation sweep
; =============================================================================

Function SweepFollowAliasesOnLoad(Actor[] followers)
    {Load-time follow-pool reconciliation (FollowerManager.RunDeferredMaintenance,
     before ReapplyFollowTracking so that pass sees pool state).
     Migration (one-shot, sentinel SeverActions_FollowPoolMigDone): adopt
     followers from legacy CK slots or the overflow pair into the pool.
     Verify (every load): empty aliases holding deleted/disabled actors or
     non-followers (a seat Enterprises' war-band record names excepted), resolve duplicates
     to the recorded index, adopt unrecorded fills, release claims on empty
     aliases, drop stale roster indices.}
    Quest pool = GetFollowQuest()
    If !pool
        Return
    EndIf
    SeverActions_FollowerManager fmSwp = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager

    ; ── Migration half (one-shot) ──
    If StorageUtil.GetIntValue(None, "SeverActions_FollowPoolMigDone", 0) == 0
        Int mi = 0
        While mi < followers.Length
            Actor mf = followers[mi]
            If mf && !mf.IsDead()
                ; Same skips as ReapplyFollowTracking: hands-off actors, and
                ; mid-travel companions (seated when the trip ends).
                Bool migSkip = false
                If SeverActions_ModuleBase.IsFollowHandsOff(mf)
                    migSkip = true
                ElseIf SeverActionsNativeExt2.Native_GetTravelState(mf) != ""
                    migSkip = true
                EndIf
                If !migSkip
                    Bool adopted = false
                    If FollowerSlots
                        Int si = 0
                        While si < FollowerSlots.Length
                            If FollowerSlots[si] && FollowerSlots[si].GetActorRef() == mf
                                FollowerSlots[si].Clear()
                                adopted = true
                                Debug.Trace("[SeverActions_Follow] FollowPool migration: " + mf.GetDisplayName() + " adopted from legacy FollowerSlot" + si)
                            EndIf
                            si += 1
                        EndWhile
                    EndIf
                    If StorageUtil.GetIntValue(mf, "SeverFollow_Overflow", 0) == 1
                        RemoveOverflowFollow(mf)
                        adopted = true
                        Debug.Trace("[SeverActions_Follow] FollowPool migration: " + mf.GetDisplayName() + " adopted from overflow overrides")
                    EndIf
                    If adopted
                        AssignFollowerSlot(mf)
                    EndIf
                EndIf
            EndIf
            mi += 1
        EndWhile
        StorageUtil.SetIntValue(None, "SeverActions_FollowPoolMigDone", 1)
        Debug.Trace("[SeverActions_Follow] FollowPool migration pass complete (sentinel set)")
    EndIf

    ; ── Verify half (every load) ──
    ; Pool side: empty orphans; resolve duplicates to the recorded index;
    ; adopt content where the index is missing/stale.
    Int i = 0
    While i < FOLLOW_ALIAS_POOL_SIZE
        ReferenceAlias al = pool.GetNthAlias(i) as ReferenceAlias
        If al
            Actor a = al.GetReference() as Actor
            If a
                If a.IsDeleted() || a.IsDisabled()
                    al.Clear()
                    SeverActionsNativeExt2.FollowPool_Release(i)
                    Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied alias " + i + " (deleted/disabled holder)")
                ElseIf (!fmSwp || !fmSwp.IsRegisteredFollower(a)) && !SeverActionsNative.Native_GetHasFollowPkg(a)
                    ; Neither a registered companion nor a casual (a pool-seated
                    ; casual has hasFollowPkg and no roster row): the seat and SA's
                    ; follow LinkedRef go, unless Enterprises' war-band record names it.
                    If !_IsWarBandSeat(a, i)
                        al.Clear()
                        SeverActionsNativeExt2.FollowPool_Release(i)
                        If SeverActions_FollowerFollowKW && a.GetLinkedRef(SeverActions_FollowerFollowKW) != None
                            SeverActionsNative.LinkedRef_Clear(a, SeverActions_FollowerFollowKW)
                        EndIf
                        Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied alias " + i + " (holder neither companion nor casual)")
                    EndIf
                Else
                    Int claimed = SeverActionsNativeExt.Native_GetFollowAliasIndex(a)
                    If claimed != i
                        If claimed >= 0
                            ReferenceAlias other = GetFollowAlias(claimed)
                            If other && other.GetReference() == a
                                al.Clear()   ; duplicate fill — the recorded one wins
                                SeverActionsNativeExt2.FollowPool_Release(i)
                                Debug.Trace("[SeverActions_Follow] FollowPool sweep: emptied duplicate alias " + i + " for " + a.GetDisplayName())
                            Else
                                SeverActionsNativeExt.Native_SetFollowAliasIndex(a, i)   ; recorded index was stale — adopt
                                SeverActionsNativeExt2.FollowPool_Claim(a, "follow")   ; adopts alias i (filled by a)
                            EndIf
                        Else
                            SeverActionsNativeExt.Native_SetFollowAliasIndex(a, i)   ; adopt
                            SeverActionsNativeExt2.FollowPool_Claim(a, "follow")   ; adopts alias i (filled by a)
                        EndIf
                    EndIf
                EndIf
            ElseIf SeverActionsNativeExt2.FollowPool_OwnerOf(i) != ""
                ; An empty alias keeps no claim (its holder deleted, a fill lost to
                ; the stale alias table); the sweep runs before any seating, so no
                ; claim here is mid-seat.
                SeverActionsNativeExt2.FollowPool_Release(i)
            EndIf
        EndIf
        i += 1
    EndWhile
    ; Roster side: drop recorded indices whose alias no longer points at
    ; the follower (the next AssignFollowerSlot re-seats them).
    Int ri = 0
    While ri < followers.Length
        Actor rf = followers[ri]
        If rf
            Int rIdx = SeverActionsNativeExt.Native_GetFollowAliasIndex(rf)
            If rIdx >= 0
                ReferenceAlias ral = GetFollowAlias(rIdx)
                If !ral || ral.GetReference() != rf
                    If ral && ral.GetReference() == None
                        SeverActionsNativeExt2.FollowPool_Release(rIdx)   ; the empty alias keeps no claim
                    EndIf
                    SeverActionsNativeExt.Native_SetFollowAliasIndex(rf, -1)
                    Debug.Trace("[SeverActions_Follow] FollowPool sweep: dropped stale index " + rIdx + " for " + rf.GetDisplayName())
                EndIf
            EndIf
        EndIf
        ri += 1
    EndWhile
    Debug.Trace("[SeverActions_Follow] FollowPool load sweep complete")
EndFunction

Bool Function _IsWarBandSeat(Actor akHolder, Int aiIndex)
    {True when alias aiIndex is a war-band member's seat by SeverActions_Enterprises' own record
     (SeverCamp_MusterAlias: set at muster, cleared by every send-home, unmuster, death relay and
     recruit), so a seat the record no longer names still goes at load. Never for a follower
     another framework owns, a loaded corpse, nor without the enterprises module.}
    If !SeverActionsNativeExt2.Module_IsUsable("enterprises") || SeverActionsNativeExt2.Native_IsTrackOnlyFollower(akHolder)
        Return false
    EndIf
    ; IsDead can misread an unloaded living actor at load; the death relay clears a real corpse's
    ; record anyway.
    If akHolder.IsDead() && akHolder.Is3DLoaded()
        Return false
    EndIf
    ; The record, not a camp lookup: it is what every send-home and unmuster frees the seat by.
    Return StorageUtil.GetIntValue(akHolder, "SeverCamp_MusterAlias", -1) == aiIndex
EndFunction

