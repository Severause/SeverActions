Scriptname SeverActions_Follow extends Quest
{Follow system. Both modes ride the 200-alias follow pool + a LinkedRef:
 casual follow (StartFollowing/StopFollowing: guards, random NPCs, no roster
 entry) and companion follow (CompanionStartFollowing/CompanionStopFollowing:
 SetCompanion recruits, plus roster, relationships and schedules). Casual vs
 companion is the ROSTER (Native_GetIsFollower), never the follow mechanism.
 Legacy SkyrimNet-driven casuals migrate to the pool in the load sweep.}

; =============================================================================
; PROPERTIES
; =============================================================================

int Property FollowPackagePriority = 50 AutoReadOnly
{Priority of a SkyrimNet FollowPlayer registration (legacy casuals only).
Kept low so it doesn't overtake other mods' packages; the pool's alias
packages don't use it.}

ReferenceAlias[] Property FollowerSlots Auto
{Legacy: 21 CK alias slots carrying SeverActions_FollowPlayerPackage.
Superseded by the 200-alias pool (FLWD v18): a held slot is a transitional
state to strip, filled only on an ESP that predates the pool.}

; ── 200-alias follow pool (FLWD v18) ──
; Every follower rides an alias of SeverActions_FollowQuest, whose CK packages
; (Close above V2) re-apply natively on cell load; PO3 overrides drop on 3D
; unload and nothing re-heals them mid-session. The override pair survives
; only as the >200 fallback.
Int Property FOLLOW_QUEST_FORMID    = 0x0016A78D AutoReadOnly
{SeverActions_FollowQuest — 200-slot ReferenceAlias pool (Follower_000..199),
 each carrying SeverActions_FollowPlayerClose above SeverActions_FollowPlayerPackageV2.
 Generated by xEdit Scripts/GenerateFollowQuest.pas.}
Int Property FOLLOW_ALIAS_POOL_SIZE = 200 AutoReadOnly

; ── Camp persistence pool ──
; SeverActions_CampPersist: 300 package-free aliases keeping sworn camp members
; persistent (resolvable anywhere, immune to the leveled-actor re-roll).
Int Property CAMP_PERSIST_QUEST_FORMID = 0x16A793 AutoReadOnly
Int Property CAMP_PERSIST_POOL_SIZE = 300 AutoReadOnly

; ── Retainer persistence pool ──
; SeverActions_RetainerPersist: 500 package-free aliases keeping every active
; retainer persistent (native seats them, VentureMonitor::SeatInPersistPool).
Int Property RETAINER_PERSIST_QUEST_FORMID = 0x16B000 AutoReadOnly
Int Property RETAINER_PERSIST_POOL_SIZE = 500 AutoReadOnly
; Both pools and the camp muster are SeverActions_Enterprises' since P9-03. These
; four constants and the seven _campPersist* / _retainerPersist* variables below
; are unused here but stay: an old suspended frame's saved bytecode names them (F7).
Quest _followQuest = None
Bool _followQuestResolved = false
Quest _campPersistQuest = None
Bool _campPersistResolved = false
Bool _campPersistMissingWarned = false
Int _campPersistCursor = 0
Quest _retainerPersistQuest = None
Bool _retainerPersistResolved = false
Bool _retainerPersistMissingWarned = false

Keyword Property SeverActions_FollowerFollowKW Auto
{SA's follow LinkedRef: on a follower SA leads, pointing at the player. No
package reads it (the follow packages target the player directly); only the
orphan scanner's follow check keys on it. SA clears it when it releases them, a
rostered follower's by the next load at the latest.}

Faction Property SeverActions_ActivelyFollowing Auto
{Held while a follower actively follows; removed on wait, sandbox, stop or
dismiss. A prompt tag (SkyrimNet's target selector lets engaged companions
speak more readily), not a state source - see HasFollowPackage.}

Faction Property SeverActions_WaitingFaction Auto
{Held while an NPC is told to wait. Interop signal: other mods (IntelEngine)
read it to leave waiting NPCs alone. Remove with ClearWaitingFaction.}

Package Property SandboxPackage Auto
{Manual sandbox package (wait/sandbox action) for relaxing in place — NPC wanders
and interacts with nearby furniture.}

Package Property SafeInteriorSandboxPackage Auto
{Package for the AUTO safe-interior sandbox (inns, homes...), distinct from
SandboxPackage so the two flows can be told apart. Falls back to
SandboxPackage when unset.}

int Property SandboxPackagePriority = 100 AutoReadOnly
{100 (Hearth's camp sandbox uses the same) wins against typical
 follower-framework overrides. It is added before FollowPlayer is cleared
 (SkyrimNet's UnregisterPackage is async), and every exit path
 (StopSandbox, OnNativeSandboxCleanup, StartFollowing,
 CompanionStartFollowing) removes it explicitly.}

int Property SafeInteriorSandboxPriority = 100 AutoReadOnly
{Same priority as regular sandbox — overrides follow package.}

; =============================================================================
; INIT
; =============================================================================

Event OnInit()
    Debug.Trace("[SeverActions_Follow] Initialized")
    RegisterForModEvent("SeverActionsNative_SandboxCleanup", "OnNativeSandboxCleanup")
    RegisterForModEvent("SeverActions_SafeInteriorReEval", "OnSafeInteriorReEval")
    RegisterForModEvent("SeverActions_SafeInteriorReassert", "OnSafeInteriorReassert")
    RegisterForModEvent("SeverActions_SafeInteriorRelease", "OnSafeInteriorRelease")
    RegisterForModEvent("SeverActions_CasualFollowRecycle", "OnCasualFollowRecycle")
EndEvent

; The auto safe-interior package (see SafeInteriorSandboxPackage).
Package Function GetSafeInteriorPackage()
    If SafeInteriorSandboxPackage
        Return SafeInteriorSandboxPackage
    EndIf
    Return SandboxPackage
EndFunction

; ── Wait In Place (Settings > Followers > Movement) ──
; A manual wait uses SandboxPackage (LeisureSandbox 0BDDFF, r1200: they mill
; around). Wait In Place swaps in SeverActions_WaitPackage 05DA58, a HOLD
; POSITION at package start, r0 (vanilla's own wait); a Sandbox at r0 still
; shuffles. It must be an override: SA's follow packages have no wait branch and
; gate on WaitingForPlayer == 0, so the flag alone drops them to base AI. The
; record's location TYPE must stay NEAR PACKAGE START (xEdit
; Scripts/FixWaitPackage.pas). Resolved by FormID: runtime EditorIDs are
; stripped without po3 Tweaks (none on VR).
Int Property WAIT_IN_PLACE_PKG_FORMID = 0x05DA58 AutoReadOnly
Package _waitInPlacePkg = None       ; lazy cache
Bool _waitInPlacePkgWarned = False

Package Function ResolveWaitInPlacePackage()
    {05DA58, cached after the first resolve (it runs inside teardown loops).
     Logs once on failure: callers fall back to the wide package, and a
     silent fallback would hide a broken ESP record.}
    If !_waitInPlacePkg
        _waitInPlacePkg = Game.GetFormFromFile(WAIT_IN_PLACE_PKG_FORMID, "SeverActions.esp") as Package
        If !_waitInPlacePkg && !_waitInPlacePkgWarned
            _waitInPlacePkgWarned = True
            Debug.Trace("[SeverActions_Follow] WARNING: SeverActions_WaitPackage 0x05DA58 did not resolve - Wait In Place falls back to the 1200u LeisureSandbox")
        EndIf
    EndIf
    Return _waitInPlacePkg
EndFunction

Package Function GetWaitSandboxPackage()
    {The package a MANUAL wait applies: the wide LeisureSandbox, or the r0
     hold with Wait In Place on. Any failure falls back to the wide package,
     so a waiting follower always has one.}
    SeverActions_FollowerManager fmWaitPk = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If !fmWaitPk || !SeverActionsNativeExt2.Settings_GetBool("waitInPlace")
        Return SandboxPackage
    EndIf
    Package tightPkg = ResolveWaitInPlacePackage()
    If tightPkg
        Return tightPkg
    EndIf
    Return SandboxPackage
EndFunction

Function RemoveWaitSandboxPackages(Actor akActor)
    {Strip BOTH manual-wait packages: the toggle can flip mid-wait, and the
     one the current setting doesn't name would stay a live priority-100
     override. Removing a package the actor never had is a no-op.}
    If !akActor
        Return
    EndIf
    If SandboxPackage
        ActorUtil.RemovePackageOverride(akActor, SandboxPackage)
    EndIf
    Package tightPkg = ResolveWaitInPlacePackage()
    If tightPkg
        ActorUtil.RemovePackageOverride(akActor, tightPkg)
    EndIf
EndFunction

Event OnSkyrimNetPackageRemoved(Form akSender, Form akPackage)
    {SkyrimNet removed a package from an actor. Re-verify with HasPackage
     rather than comparing the passed form, which would mean resolving
     SkyrimNet's FollowPlayer package by EditorID.}
    Actor akActor = akSender as Actor
    If !akActor
        Return
    EndIf
    VerifyCasualFollowPackage(akActor)
EndEvent

Bool Function VerifyCasualFollowPackage(Actor akActor)
    {Clear a legacy casual's hasFollowPkg and follow LinkedRef when SkyrimNet no
     longer holds its FollowPlayer package. Returns true if the flag was stale and
     cleared. Never touches registered followers (the roster owns their follow;
     track-only ones have no SkyrimNet package) or pool-seated casuals.}
    If !akActor
        Return false
    EndIf
    If SeverActionsNativeExt.Native_GetIsFollower(akActor)
        Return false
    EndIf
    If !SeverActionsNative.Native_GetHasFollowPkg(akActor)
        Return false
    EndIf
    ; Pool-seated casual: the alias package needs no SkyrimNet registration.
    If IsInFollowerSlot(akActor)
        Return false
    EndIf
    If SkyrimNetApi.HasPackage(akActor, "FollowPlayer") > 0
        Return false
    EndIf
    SeverActionsNative.Native_SetPackageState(akActor, false, false, false)
    If SeverActions_FollowerFollowKW
        SeverActionsNative.LinkedRef_Clear(akActor, SeverActions_FollowerFollowKW)
    EndIf
    Debug.Trace("[SeverActions_Follow] Cleared stale follow flag on " + akActor.GetDisplayName()         + " - SkyrimNet has no FollowPlayer package; they will no longer be pulled through load doors")
    Return true
EndFunction

Int Function VerifyCasualFollowPackages()
    {Load sweep over casual followers: clear stale follow flags (heals what
     the OnPackageRemoved listener never saw), re-register pool-seated ones
     with OrphanCleanup, migrate legacy SkyrimNet casuals onto the pool and
     erase waiting-faction residue. Returns how many flags were cleared.}
    Actor[] casuals = SeverActionsNativeExt.Native_GetCasualFollowers()
    If !casuals || casuals.Length == 0
        Return 0
    EndIf
    Int cleared = 0
    Int i = 0
    Int residue = 0
    While i < casuals.Length
        If VerifyCasualFollowPackage(casuals[i])
            cleared += 1
        ElseIf casuals[i] && !SeverActionsNativeExt.Native_GetIsFollower(casuals[i])
            If IsInFollowerSlot(casuals[i])
                ; OrphanCleanup's registry is cleared at kPostLoadGame: re-register,
                ; or with the scanner on (orphanCleanupEnabled) the follow LinkedRef
                ; is stripped ~5s in.
                SeverActionsNative.OrphanCleanup_RegisterFollower(casuals[i])
            ElseIf SkyrimNetApi.HasPackage(casuals[i], "FollowPlayer") > 0
                ; Legacy casual on the SkyrimNet override (drops at load doors):
                ; migrate onto the pool, one mechanism only.
                If SeverActions_FollowerFollowKW
                    SeverActionsNative.LinkedRef_Set(casuals[i], Game.GetPlayer(), SeverActions_FollowerFollowKW)
                EndIf
                AssignFollowerSlot(casuals[i])
                SeverActionsNative.OrphanCleanup_RegisterFollower(casuals[i])
                SkyrimNetApi.UnregisterPackage(casuals[i], "FollowPlayer")
                casuals[i].EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Migrated casual follower " + casuals[i].GetDisplayName() + " onto the follow pool")
            EndIf
        EndIf
        ; Rank -1 is RemoveFromFaction residue that rank-blind checks read as
        ; WAITING (a real wait is rank 0). A non-member also reads -1, but
        ; Faction_RemoveClean is a no-op then.
        If SeverActions_WaitingFaction && casuals[i] && casuals[i].GetFactionRank(SeverActions_WaitingFaction) == -1
            SeverActionsNativeExt2.Faction_RemoveClean(casuals[i], SeverActions_WaitingFaction)
            residue += 1
        EndIf
        i += 1
    EndWhile
    If residue > 0
        Debug.Trace("[SeverActions_Follow] VerifyCasualFollowPackages: erased " + residue + " stale waiting-faction residue(s)")
    EndIf
    If cleared > 0
        Debug.Trace("[SeverActions_Follow] VerifyCasualFollowPackages: cleared " + cleared             + " stale follow flag(s) of " + casuals.Length + " casual follower(s)")
    EndIf
    Return cleared
EndFunction

; Load recovery (SeverActions_Mod_Followers stage 1, before FollowerManager.Maintenance):
; re-registers events and restores state.
Function Maintenance()
    RegisterForModEvent("SeverActionsNative_SandboxCleanup", "OnNativeSandboxCleanup")
    RegisterForModEvent("SeverActions_ExternalWaitAdopt", "OnExternalWaitAdopt")
    RegisterForModEvent("SeverActions_SafeInteriorChanged", "OnSafeInteriorChanged")
    RegisterForModEvent("SeverActions_SafeInteriorToggle", "OnSafeInteriorToggle")
    RegisterForModEvent("SeverActions_PauseOnOpenToggle",  "OnPauseOnOpenToggle")
    RegisterForModEvent("SeverActions_TravelPopupToggle",  "OnTravelPopupToggle")
    RegisterForModEvent("SeverActions_TravelPopupFollowersOnly", "OnTravelPopupFollowersOnly")
    RegisterForModEvent("SeverActions_LLMTrespassToggle",  "OnLLMTrespassToggle")
    RegisterForModEvent("SeverActions_FriendlyFireToggle", "OnFriendlyFireToggle")
    RegisterForModEvent("SeverActions_YieldPromptToggle",  "OnYieldPromptToggle")
    ; Safe-interior heals (see each handler).
    RegisterForModEvent("SeverActions_SafeInteriorReEval", "OnSafeInteriorReEval")
    RegisterForModEvent("SeverActions_SafeInteriorReassert", "OnSafeInteriorReassert")
    RegisterForModEvent("SeverActions_SafeInteriorRelease", "OnSafeInteriorRelease")
    ; A package removed by any route but ours would leave a legacy casual's
    ; hasFollowPkg set, and cell catch-up would keep dragging them around.
    RegisterForModEvent("SkyrimNet_OnPackageRemoved", "OnSkyrimNetPackageRemoved")
    ; The camp muster and the persistence pools register in
    ; SeverActions_Enterprises.Maintenance (P9-03).
    RegisterForModEvent("SeverActions_CasualFollowRecycle", "OnCasualFollowRecycle")

    ; Heal flags that are already stale; the listener above only stops new drift.
    VerifyCasualFollowPackages()

    ; The seven global toggles. The global settings file wins when it holds the
    ; key: this restore and the native replay run in no fixed order, so
    ; ResolveGlobalToggle takes the file's value (mirrored into StorageUtil,
    ; which the 0160 prompt and FollowerManager read). The per-save copy answers
    ; only for keys the file never recorded.
    Quest SeverActionsQuest = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as Quest
    If SeverActionsQuest
        ; Default OFF: the feature races door-transition timing (FF fallback
        ; packages, sticky exits). Opt-in via PrismaUI.
        Bool savedEnabled = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_SafeInteriorEnabled", "safeInteriorSandbox", 0)
        SeverActionsNativeExt.SituationMonitor_SetSafeInteriorEnabled(savedEnabled)
        Debug.Trace("[SeverActions_Follow] Restored safe interior sandbox: " + savedEnabled)

        ; Menu pause-on-open. Default 1 (paused).
        Bool savedPauseOnOpen = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_PauseOnOpen", "pauseOnOpen", 1)
        SeverActionsNative.Magelight_SetPauseOnOpen(savedPauseOnOpen)
        Debug.Trace("[SeverActions_Follow] Restored menu pause on open: " + savedPauseOnOpen)

        ; Travel-destination popup. Default 1 (shown).
        Bool savedTravelPopup = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_TravelPopupEnabled", "travelPopupEnabled", 1)
        SeverActionsNative.Magelight_SetTravelPopupEnabled(savedTravelPopup)
        Debug.Trace("[SeverActions_Follow] Restored travel popup enabled: " + savedTravelPopup)

        ; Popup scope. Default 0 (every traveler).
        Bool savedPopupScope = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_TravelPopupFollowersOnly", "travelPopupFollowersOnly", 0)
        SeverActionsNative.Magelight_SetTravelPopupFollowersOnly(savedPopupScope)
        Debug.Trace("[SeverActions_Follow] Restored travel popup followers-only: " + savedPopupScope)

        ; LLM-driven trespass. Default 1: suppress the vanilla warn-follow loop
        ; and let the confrontation play out in dialogue.
        Bool savedLLMTrespass = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_LLMTrespassEnabled", "llmTrespassEnabled", 1)
        SeverActionsNativeExt.Native_Trespass_SetLLMMode(savedLLMTrespass)
        Debug.Trace("[SeverActions_Follow] Restored LLM trespass mode: " + savedLLMTrespass)

        ; Yield/surrender prompt exposure. Default 1. Held on None: the 0160
        ; combat prompt reads it via papyrus_util GetIntValue with actor 0.
        Bool savedYieldPrompt = ResolveGlobalToggle(None, "SeverActions_YieldPromptEnabled", "yieldPromptEnabled", 1)
        SeverActionsNative.Magelight_SetYieldPromptEnabled(savedYieldPrompt)
        Debug.Trace("[SeverActions_Follow] Restored yield prompt exposure: " + savedYieldPrompt)

        ; Follower friendly-fire prevention. Default 1. The monitor also sets the
        ; ally-hit game settings, which do not ride the save.
        Bool savedFriendlyFire = ResolveGlobalToggle(SeverActionsQuest, "SeverActions_PreventFollowerFF", "preventFollowerFF", 1)
        SeverActionsNative.FriendlyFireMonitor_SetEnabled(savedFriendlyFire)
        Debug.Trace("[SeverActions_Follow] Restored follower friendly-fire prevention: " + savedFriendlyFire)
    EndIf

    ; The safe-interior override and its InSafeInteriorSandbox flag persist in
    ; the save but SituationMonitor's inSafeInterior state does not, so no exit
    ; would ever fire for a follower sandboxing at save time (or when the feature
    ; was turned off). Force the exit; ExitSafeInteriorSandbox no-ops unflagged.
    Actor[] reconFollowers = SeverActionsNative.Native_GetAllTrackedFollowers()
    Int reconIdx = 0
    While reconIdx < reconFollowers.Length
        ExitSafeInteriorSandbox(reconFollowers[reconIdx])
        reconIdx += 1
    EndWhile
EndFunction

Bool Function ResolveGlobalToggle(Form akHolder, String asStorageKey, String asSettingsKey, Int aiDefault)
    {The value a load-time restore applies for one global toggle: the global
     settings file's (true or 1, as the settings handler parses it), mirrored
     into the per-save StorageUtil copy; else (no record, or a DLL without
     the native) the per-save copy.}
    String globalValue = SeverActionsNativeExt2.Native_SettingsGetValue(asSettingsKey, "")
    If globalValue != ""
        Bool enabled = globalValue == "true" || globalValue == "1"
        StorageUtil.SetIntValue(akHolder, asStorageKey, enabled as Int)
        Return enabled
    EndIf
    Return StorageUtil.GetIntValue(akHolder, asStorageKey, aiDefault) == 1
EndFunction

; =============================================================================
; SANDBOX STATE HELPERS
; Native FollowerDataStore.isSandboxing is the source of truth. Never
; SkyrimNetApi.HasPackage("Sandbox"): "Sandbox" isn't in SkyrimNet's
; PackageFormCache, so it always answers false.
; =============================================================================

Bool Function IsSandboxing(Actor akActor)
    {True while SA holds akActor in a manual-wait or safe-interior sandbox.}
    return akActor && SeverActionsNativeExt.Native_GetSandboxing(akActor)
EndFunction

Function SetSandboxFlag(Actor akActor, Bool active)
    If akActor
        SeverActionsNative.Native_SetSandboxing(akActor, active)
    EndIf
EndFunction

; =============================================================================
; NATIVE SANDBOX CLEANUP EVENT HANDLER
; Called by native SandboxManager when player changes cells or moves too far
; =============================================================================

Event OnNativeSandboxCleanup(string eventName, string strArg, float numArg, Form sender)
    Actor akActor = sender as Actor
    if !akActor
        akActor = Game.GetFormEx(numArg as int) as Actor
    endif

    if !akActor
        return
    endif

    ; Only handle actors that are sandboxing through our system
    if !IsSandboxing(akActor)
        return
    endif

    Debug.Trace("[SeverActions_Follow] Native sandbox cleanup for: " + akActor.GetDisplayName())

    ; Clear waiting FIRST so the follow package is eligible before the sandbox
    ; override goes, avoiding an FF-prefix runtime sandbox.
    akActor.SetAV("WaitingForPlayer", 0)
    If SeverActions_WaitingFaction
        ClearWaitingFaction(akActor)
    EndIf

    SetSandboxFlag(akActor, false)

    RemoveWaitSandboxPackages(akActor)

    ; No forced eval: AI resumes follow by itself. Tag only when a follow exists:
    ; a stale tag on a dismissed/homed NPC freezes their work schedule (the
    ; schedule guards read this faction).
    If IsInFollowerSlot(akActor) || SkyrimNetApi.HasPackage(akActor, "FollowPlayer")
        SetActivelyFollowing(akActor, true)
    EndIf

    ; Refill the schedule alias of a dismissed/homed NPC (no-op when follow
    ; just resumed above).
    SeverActions_FollowerManager fmCleanup = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
    If fmCleanup
        fmCleanup.RefillSchedAliasesAfterStop(akActor)
    EndIf

    Debug.Notification(SeverActionsNativeExt2.Native_L10nFmt("follow.stoppedRelaxing", ("" + akActor.GetDisplayName())))
    RegisterFollowStateEvent(akActor, "follower_relax_stopped", akActor.GetDisplayName() + " stops relaxing and catches up with " + Game.GetPlayer().GetDisplayName() + ".")
EndEvent

; =============================================================================
; SAFE INTERIOR AUTO-SANDBOX
; Fired by native SituationMonitor when a following companion enters/exits
; a safe interior (inn, home, shop, temple, town interior).
; =============================================================================

Event OnSafeInteriorChanged(String eventName, String strArg, Float numArg, Form sender)
    ; strArg format: "enter|0xFormID" or "exit|0xFormID"
    Int pipePos = StringUtil.Find(strArg, "|")
    If pipePos < 0
        Return
    EndIf

    String changeType = StringUtil.Substring(strArg, 0, pipePos)
    ; The actor comes from sender: Game.GetForm fails past 0x7FFFFFFF (signed
    ; Int), so the hex strArg is only a Game.GetFormEx fallback.
    Actor akActor = sender as Actor
    If !akActor
        String formIdStr = StringUtil.Substring(strArg, pipePos + 1)
        akActor = Game.GetFormEx(SeverActionsNative.HexToInt(formIdStr)) as Actor
    EndIf
    If !akActor
        Return
    EndIf

    ; A manual wait wins, and a journey refuses a new relax (its exit still runs, to take
    ; a relax under way off a traveler). The monitor has just claimed them on an enter:
    ; yield the claim, or its exit and rescues would move them. Never over our own live
    ; relax (flagged), whose claim it is.
    If akActor.GetAV("WaitingForPlayer") > 0 || (changeType == "enter" && SeverActionsNativeExt2.Travel_GetPhaseByActor(akActor) > 0)
        If changeType == "enter" && StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
            SeverActionsNativeExt2.SituationMonitor_YieldSafeInterior(akActor)
        EndIf
        Return
    EndIf
    ; Leave a dismissed NPC's home sandbox alone; followers with a home still
    ; get the safe-interior sandbox.
    If SeverActionsNative.Native_GetHomeMarkerSlot(akActor) >= 0
        SeverActions_FollowerManager fm = Game.GetFormFromFile(0x000D62, "SeverActions.esp") as SeverActions_FollowerManager
        If fm && !fm.IsRegisteredFollower(akActor)
            Return
        EndIf
    EndIf

    If changeType == "enter"
        ; Track-only followers may sandbox too: the enter only lays a temporary
        ; override the exit removes. Re-driving them on the way out would fight
        ; their framework; ExitSafeInteriorSandbox branches on that.
        Package interiorPkg = GetSafeInteriorPackage()
        If interiorPkg && !IsSandboxing(akActor)
            ; Override FIRST, so a valid high-priority package is always there
            ; (SkyrimNet's FollowPlayer hook ignores PO3 priority and races a door
            ; transition into the FE/FF fallback). 4th arg 0 = no AI reset: the
            ; EvaluatePackage below picks it up without the churn flag 1 causes.
            ActorUtil.AddPackageOverride(akActor, interiorPkg, SafeInteriorSandboxPriority, 0)

            ; Drop a legacy SkyrimNet casual's registration (no-op for everyone else).
            SkyrimNetApi.UnregisterPackage(akActor, "FollowPlayer")

            ; WaitingForPlayer = 1 makes SA's alias follow ineligible (it gates on
            ; WFP == 0). Skip it for hands-off followers (track-only, or anyone in
            ; Tracking mode, D45): their framework's follow gates on WFP too, so if
            ; our override lost to a framework re-asserting its package they would
            ; drop to a pinning FF/FE fallback instead of framework follow. The
            ; relax comes from the override, not from WFP.
            If !SeverActions_ModuleBase.IsFollowHandsOff(akActor)
                akActor.SetAV("WaitingForPlayer", 1)
                StorageUtil.UnsetIntValue(akActor, "SeverActions_SafeInteriorNoWfp")
            Else
                ; A WaitingForPlayer above 0 at the exit is then their framework's wait
                ; (ExitSafeInteriorSandbox).
                StorageUtil.SetIntValue(akActor, "SeverActions_SafeInteriorNoWfp", 1)
            EndIf

            SetSandboxFlag(akActor, true)
            StorageUtil.SetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 1)
            SeverActionsNative.Native_SetSandboxing(akActor, true)
            SetActivelyFollowing(akActor, false)

            ; Same external signal as a manual wait.
            If SeverActions_WaitingFaction
                akActor.AddToFaction(SeverActions_WaitingFaction)
            EndIf

            akActor.EvaluatePackage()
            Debug.Trace("[SeverActions_Follow] Safe interior sandbox: " + akActor.GetDisplayName() + " is relaxing")
        ElseIf IsSandboxing(akActor) && StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
            ; A manual wait whose WaitingForPlayer another script zeroed: the same yield.
            SeverActionsNativeExt2.SituationMonitor_YieldSafeInterior(akActor)
        EndIf
    ElseIf changeType == "exit"
        ExitSafeInteriorSandbox(akActor)
    EndIf
EndEvent

Function ExitSafeInteriorSandbox(Actor akActor)
    {Tear down an active safe-interior auto-sandbox: remove the overrides,
    restore follow, teleport to the player and re-evaluate. No-op unless
    flagged SeverActions_InSafeInteriorSandbox, so safe to call speculatively.
    A relax that wrote no WaitingForPlayer and finds one above 0 was taken over
    by their framework's own wait: only the relax is removed, and they stay.
    A companion Walk With Me leads is released where they stand, not re-driven or moved.}
    If akActor
        If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) == 1
            Bool ownWait = StorageUtil.GetIntValue(akActor, "SeverActions_SafeInteriorNoWfp", 0) == 1 && akActor.GetAV("WaitingForPlayer") > 0
            StorageUtil.UnsetIntValue(akActor, "SeverActions_InSafeInteriorSandbox")
            StorageUtil.UnsetIntValue(akActor, "SeverActions_SafeInteriorNoWfp")
            SetSandboxFlag(akActor, false)
            SeverActionsNative.Native_SetSandboxing(akActor, false)

            ; A traveler: the journey owns them. Only the relax's own package comes off (the wait
            ; packages include the shared 0BDDFF, a waiting traveler's arrival sandbox): no follow
            ; re-driven and no move to the player; the trip's end restores the follower.
            If SeverActionsNativeExt2.Travel_GetPhaseByActor(akActor) > 0
                Package relaxPkg = GetSafeInteriorPackage()
                Bool sharedWithArrival = relaxPkg == SandboxPackage && SeverActionsNativeExt2.Travel_GetPhaseByActor(akActor) == 2
                Int travelIter = 0
                While travelIter < 5 && relaxPkg && !sharedWithArrival
                    ActorUtil.RemovePackageOverride(akActor, relaxPkg)
                    travelIter += 1
                EndWhile
                If !ownWait
                    akActor.SetAV("WaitingForPlayer", 0)
                EndIf
                If SeverActions_WaitingFaction
                    ClearWaitingFaction(akActor)
                EndIf
                akActor.EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended: " + akActor.GetDisplayName() + " is traveling, left to the journey")
                Return
            EndIf

            ; Remove repeatedly: one RemovePackageOverride has left the override
            ; on (a flapping enter can stack it) and resetai walked them back
            ; inside. Extra calls are no-ops.
            Int removeIter = 0
            While removeIter < 5
                If SafeInteriorSandboxPackage
                    ActorUtil.RemovePackageOverride(akActor, SafeInteriorSandboxPackage)
                EndIf
                RemoveWaitSandboxPackages(akActor)
                removeIter += 1
            EndWhile

            If ownWait
                If SeverActions_WaitingFaction
                    ClearWaitingFaction(akActor)
                EndIf
                akActor.EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended: " + akActor.GetDisplayName() + " left to their own wait")
                Return
            EndIf

            ; Clear WaitingForPlayer before re-driving follow, so the alias
            ; follow is eligible and no engine fallback fills the gap.
            akActor.SetAV("WaitingForPlayer", 0)

            If SeverActions_WaitingFaction
                ClearWaitingFaction(akActor)
            EndIf

            ; Walk With Me leads them: its packages take over where they stand, so no follow
            ; re-driven, no move and no AI reset.
            If SeverActionsNativeExt2.WalkWithMe_Leads(akActor)
                If !SeverActions_ModuleBase.IsFollowHandsOff(akActor)
                    SetActivelyFollowing(akActor, true)
                EndIf
                akActor.EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended: " + akActor.GetDisplayName() + " is led by Walk With Me")
                Return
            EndIf

            ; Hands-off followers are never re-driven by SA: release only (done
            ; above), bring them out and re-evaluate so their own follow resumes.
            If SeverActions_ModuleBase.IsFollowHandsOff(akActor)
                akActor.MoveTo(Game.GetPlayer())
                akActor.EvaluatePackage()
                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended (hands-off release): " + akActor.GetDisplayName() + " — override removed, their own follow resumes")
            Else
                ; Not seated: a legacy SkyrimNet casual, re-register FollowPlayer.
                If !IsInFollowerSlot(akActor)
                    SkyrimNetApi.RegisterPackage(akActor, "FollowPlayer", FollowPackagePriority, 0, true)
                Else
                    ; Re-set SA's follow LinkedRef and OrphanCleanup entry, as
                    ; CompanionStartFollowing does.
                    If SeverActions_FollowerFollowKW
                        SeverActionsNative.LinkedRef_Set(akActor, Game.GetPlayer(), SeverActions_FollowerFollowKW)
                    EndIf
                    SeverActionsNative.OrphanCleanup_RegisterFollower(akActor)
                EndIf

                SetActivelyFollowing(akActor, true)
                ; Teleport to player so they don't get stuck inside the house
                akActor.MoveTo(Game.GetPlayer())

                ; Immediate + 500ms re-eval + resetAI at 1000ms (1500 elsewhere;
                ; they are local). resetAI is harmless here: beside the player,
                ; not in combat.
                SeverActionsNative.EscalatedReEvaluate(akActor, 1000)

                Debug.Trace("[SeverActions_Follow] Safe interior sandbox ended: " + akActor.GetDisplayName() + " teleported to player and resumes following")
            EndIf
        EndIf
    EndIf
EndFunction

Function StripSafeInteriorForFollow(Actor akActor)
    {Light safe-interior teardown for follow-start paths (via
     FollowerManager.StripSandboxesForFollow): drops the overrides and, when
     flagged, the flag and waiting state. Unlike ExitSafeInteriorSandbox it
     neither teleports nor re-drives follow; the caller does that.}
    If !akActor
        Return
    EndIf
    Bool wasFlagged = StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) == 1

    ; Remove the override UNCONDITIONALLY: if the flag desyncs from it, a
    ; flag-gated strip leaves a priority-100 override outranking follow (95) and
    ; no entry point can pull them out. Repeated as in ExitSafeInteriorSandbox.
    ; Home / work / furniture sandboxes use other packages and are untouched.
    Int removeIter = 0
    While removeIter < 5
        If SafeInteriorSandboxPackage
            ActorUtil.RemovePackageOverride(akActor, SafeInteriorSandboxPackage)
        EndIf
        RemoveWaitSandboxPackages(akActor)
        removeIter += 1
    EndWhile

    ; State cleanup only when we were actually flagged relaxing.
    If wasFlagged
        StorageUtil.UnsetIntValue(akActor, "SeverActions_InSafeInteriorSandbox")
        StorageUtil.UnsetIntValue(akActor, "SeverActions_SafeInteriorNoWfp")
        SetSandboxFlag(akActor, false)
        SeverActionsNative.Native_SetSandboxing(akActor, false)
        akActor.SetAV("WaitingForPlayer", 0)
        If SeverActions_WaitingFaction
            ClearWaitingFaction(akActor)
        EndIf
        Debug.Trace("[SeverActions_Follow] Safe interior sandbox stripped for follow start: " + akActor.GetDisplayName())
    EndIf

    ; Re-evaluate even unflagged (the desync case), or the stale override stays
    ; selected until the next tick. Runs per follow command, never per tick.
    akActor.EvaluatePackage()
EndFunction

Bool Function YieldSafeInteriorToWait(Actor akActor, Package akWaitPackage)
    {A wait takes over from the safe-interior relax: drop the relax override (unless it
     is akWaitPackage, the package the wait itself holds; None when SA holds none) and
     its flag, and yield SituationMonitor's claim, so neither the claim's exit nor a
     rescue moves the waiter. Writes no WaitingForPlayer, sandbox flag or faction.
     True when the relax flag was set.}
    If !akActor
        Return False
    EndIf
    Bool wasFlagged = StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) == 1
    ; The relax can ride SandboxPackage (GetSafeInteriorPackage's fallback), the wide
    ; wait's own package, which must stay when the wait holds it. Repeated as in
    ; ExitSafeInteriorSandbox.
    Package relaxPkg = GetSafeInteriorPackage()
    If relaxPkg && relaxPkg != akWaitPackage
        Int removeIter = 0
        While removeIter < 5
            ActorUtil.RemovePackageOverride(akActor, relaxPkg)
            removeIter += 1
        EndWhile
    EndIf
    If wasFlagged
        StorageUtil.UnsetIntValue(akActor, "SeverActions_InSafeInteriorSandbox")
        StorageUtil.UnsetIntValue(akActor, "SeverActions_SafeInteriorNoWfp")
    EndIf
    SeverActionsNativeExt2.SituationMonitor_YieldSafeInterior(akActor)
    Return wasFlagged
EndFunction

; SituationMonitor fires this ~500ms after the enter, in case the first
; EvaluatePackage raced a cell transition.
Event OnSafeInteriorReEval(String eventName, String strArg, Float numArg, Form sender)
    ; sender always carries the actor (the three safe-interior heals share this);
    ; numArg is 0 - a float FormID corrupts above 2^24.
    Actor akActor = sender as Actor
    If !akActor
        Return
    EndIf
    ; Still flagged? The player may have left during the delay (mid-exit).
    If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
        Return
    EndIf
    akActor.EvaluatePackage()
    Debug.Trace("[SeverActions_Follow] Safe interior deferred re-eval: " + akActor.GetDisplayName())
EndEvent

Event OnSafeInteriorReassert(String eventName, String strArg, Float numArg, Form sender)
    {A follower flagged safe-interior sandboxing was found on a runtime FF/FE
     fallback (the override lost selection, or a transition or load knocked it
     off). Re-ADD the override: a bare EvaluatePackage does not recover them.}
    Actor akActor = sender as Actor
    If !akActor || akActor.IsDead()
        Return
    EndIf
    ; Same gate as OnSafeInteriorReEval.
    If StorageUtil.GetIntValue(akActor, "SeverActions_InSafeInteriorSandbox", 0) != 1
        Return
    EndIf
    Package interiorPkg = GetSafeInteriorPackage()
    If interiorPkg
        ; WaitingForPlayer / faction / flags from the enter are still right.
        ; 4th arg 0 = no AI reset, as on enter.
        ActorUtil.AddPackageOverride(akActor, interiorPkg, SafeInteriorSandboxPriority, 0)
        akActor.EvaluatePackage()
        Debug.Trace("[SeverActions_Follow] Safe interior sandbox RE-ASSERTED off FF fallback: " + akActor.GetDisplayName())
    EndIf
EndEvent

Event OnSafeInteriorRelease(String eventName, String strArg, Float numArg, Form sender)
    {The mirror of OnSafeInteriorReassert: SandboxHealTick found this TRACK-ONLY
     follower driven by her own framework's follow, so let go. Native already
     cleared our native flags; strip the lingering override without
     teleporting or re-driving her.}
    Actor akActor = sender as Actor
    If !akActor
        Return
    EndIf
    StripSafeInteriorForFollow(akActor)
EndEvent

