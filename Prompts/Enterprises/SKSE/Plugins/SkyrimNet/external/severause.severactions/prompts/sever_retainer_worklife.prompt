{% if npcUUID and npcUUID != 0 %}
{% set npc = decnpc(npcUUID) %}

## Whose Journal
{{ npc.name }} ({{ npc.race }}{% if npc.gender %}, {{ npc.gender }}{% endif %}{% if npc.class != "" and npc.class != "unknown" %}, {{ npc.class }}{% endif %})
{# Who they are, their old life and their voice: the backdrop. The single-block pulls base 7050 uses, not the whole "thoughts" profile, whose SA sections (shop stock, gold figures) do not belong in a journal task. #}
{{ render_character_profile("bio_summary", npcUUID) }}
