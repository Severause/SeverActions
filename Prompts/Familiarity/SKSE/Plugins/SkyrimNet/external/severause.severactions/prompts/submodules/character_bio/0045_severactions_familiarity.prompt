{% if render_mode == "full" or render_mode == "thoughts" or render_mode == "transform" %}
{# What this NPC knows of the player: the impression sever_reputation_assess writes from their own memories (sever_reputation_blurb), #}
{# plus what a stored text cannot know (player_familiarity, game state): a marriage, that they do not know the name yet, how long ago they #}
{# last spoke. Nothing renders until one of those, or the intimate persona lines, has something to say. 0130 prints world knowledge. #}
{% if not is_follower(actorUUID) and is_sever_follower(actorUUID) == "" and not is_player(actorUUID) and not exists("stealthHiddenPlayer") %}
{% set familiarity = player_familiarity(actorUUID) %}
{# section is the npcFamiliarityEnabled switch. A DLL from before the key has no switch, so an absent key reads as on. #}
{% set section_on = isObject(familiarity) %}
{% if section_on and existsIn(familiarity, "section") %}{% set section_on = familiarity.section %}{% endif %}
{% if section_on %}
{# Rank 4 is the Lover rank, which romance and lover mods set without a wedding; only rank 4 AND PlayerMarriedFaction #}
{# (Skyrim.esm 0x0C6472 = 812146, which the vanilla wedding adds; get_faction_rank >= 0, ai_docs/PROMPTS.md) is a marriage. #}
{# 0046 and the two assessments test it the same way. Rank needs the actor record, so the native tier cannot see it. #}
{% set tier = familiarity.tier %}
{% set lover = get_relationship_rank(actorUUID, player.UUID) >= 4 %}
{% set married = lover and get_faction_rank(actorUUID, 812146) >= 0 %}

{# The name: theirs first-hand once it was said between them (nameKnown, kept for good) or they have talked properly; #}
{# otherwise it may have reached them through world knowledge (a substring test on the per-NPC text), or their impression uses it. #}
{% set told_name = lover or tier == "met_once" or tier == "acquainted" or tier == "familiar" %}
{% if not told_name and existsIn(familiarity, "nameKnown") %}{% set told_name = familiarity.nameKnown %}{% endif %}
{% set wk_text = get_world_knowledge(actorUUID) %}
{% set heard_name = wk_text != "" and contains(" " + replace(wk_text, "\n", " "), " " + player.name) %}
{% set rep_blurb = sever_reputation_blurb(actorUUID) %}
{% set has_blurb = rep_blurb != "" %}
{% set knows_name = told_name or heard_name or (has_blurb and contains(rep_blurb, player.name)) %}
{# The guard is for someone they have no memory of by name: talk from before the lines were counted leaves memories and no count. #}
{% set mem_names = false %}
{% if existsIn(familiarity, "playerMemories") %}{% set mem_names = familiarity.playerMemories > 0 %}{% endif %}
{% set name_guard = not knows_name and not mem_names %}

{% set days_ago = default(familiarity.lastSeenDaysAgo, 0) %}
{% set time_desc = "" %}
{% if days_ago and days_ago >= 1 %}
{% if days_ago > 30 %}{% set time_desc = "many weeks" %}
{% elif days_ago > 14 %}{% set time_desc = "a few weeks" %}
{% elif days_ago > 7 %}{% set time_desc = "about a week" %}
{% elif days_ago > 3 %}{% set time_desc = "several days" %}
{% else %}{% set time_desc = "a day or two" %}
{% endif %}
{% endif %}

{# An NPC with sexual-preference bio blocks or a courtesan-type trade. sever_intimate_persona's content is printed by 0040 #}
{# (a flag here); sever_intimate_trade is printed here since nothing else renders it. #}
{% set persona_flag = sever_intimate_persona(actorUUID) %}
{% set persona_trade = sever_intimate_trade(actorUUID) %}
{% set has_persona = (persona_flag and persona_flag != "") or (persona_trade and persona_trade != "") %}

{% if lover or has_blurb or time_desc != "" or has_persona or name_guard %}
{% if knows_name %}## What You Know About {{ player.name }}{% else %}## What You Know About This Person{% endif %}
{# The impression is the section: it is written from this NPC's own memories. Add no line here that says how much they #}
{# have talked or how to treat the player: a general line in the bio outranks the NPC's memories in practice. The persona #}
{# lines at the end are the one exception, and belong to the intimacy feature. #}
{% if married %}- You are married to {{ player.name }}.
{% elif lover %}- You and {{ player.name }} are lovers.
{% endif %}
{% if has_blurb %}{{ rep_blurb }}
{% endif %}
{% if name_guard %}- Unless your memories or background say otherwise, you do not know the name of this {{ player.race }}. Until you learn it, address them by what you can see: bearing, gear, role.
{% endif %}
{% if time_desc != "" %}- It has been {{ time_desc }} since you last spoke.
{% endif %}
{% if has_blurb or time_desc != "" %}- Never state or imply a number of times you have met or spoken with them.
{% endif %}
{% if has_persona %}
{% if persona_trade and persona_trade != "" %}

{{ persona_trade }}
{% endif %}
{% if persona_flag and persona_flag != "" and persona_trade and persona_trade != "" %}
- Let your inclinations (in your profile above) and your trade color how you read this person: a courtesan appraises openly and professionally, a libertine warms quickly, a chaste temperament stays guarded. They shape your manner; never recite them aloud.
{% elif persona_flag and persona_flag != "" %}
- Your inclinations are written in your profile above — they are part of who you are. Let them color how you read this person: a courtesan appraises openly and professionally, a libertine warms quickly, a chaste temperament stays guarded. They shape your manner; never recite them aloud.
{% else %}
- Let your trade color how you read this person: a courtesan appraises openly and professionally, and warmth is part of the work, not a confession. Never recite its terms unprompted.
{% endif %}
{% endif %}
{% endif %}{# end something to say #}

{% endif %}{# end section_on #}
{% endif %}{# end not follower, not player #}
{% endif %}{# end render_mode #}
