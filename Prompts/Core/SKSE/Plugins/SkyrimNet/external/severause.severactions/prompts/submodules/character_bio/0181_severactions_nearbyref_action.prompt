{% if render_mode == "action" %}
{# The drill-down's copy of 0180 (keep the two loops in sync), adding container contents so an item can
   be named out of a chest; the furniture RefIDs are what SitOrLayDown and TieCaptiveToFurniture take.
   Skipped while the speaker is in a SexLab/OStim scene. #}
{% if actorUUID and actorUUID != 0 %}
{% if sever_in_scene(actorUUID) == "" %}
{% if actorUUID and isValidActor(actorUUID) %}
{% set nearby_refs = get_nearby_references_for_entity(actorUUID, 1000) %}
{% else %}
{% set nearby_refs = get_nearby_references(1000) %}
{% endif %}
{% set excluded_subtypes = ["clutter", "misc"] %}
{% set user_excluded_raw = papyrus_util("GetStringValue", "", "SeverActions_NearbyExcluded", "") %}
{% set user_excluded = "," + user_excluded_raw + "," %}
{% set furniture_taken = sever_furniture_taken(actorUUID) %}
{% set max_items = 20 %}
{% set items = [] %}
{% set seen_refids = [] %}
{% set item_names = [] %}
{% for ref in nearby_refs %}
{% set ref_tag = "," + ref.type + ":" + ref.subtype + "," %}
{% if ref.name != "" and not (ref.subtype in excluded_subtypes) and not contains(user_excluded, ref_tag) %}
{% set refid_str = to_string(ref.formID) %}
{% if not (ref.type == "furniture" and (ref.position.meters == 0.0 or contains(furniture_taken, "," + refid_str + ","))) %}
{% set refid_count = count(seen_refids, refid_str) %}
{% if refid_count < 3 or ref.type == "item" %}
{# Same-name loose items stack into one line with a count; furniture and containers keep a line each,
   because which chair or chest it is matters. #}
{% if ref.type == "item" and (ref.name in item_names) %}
{% set item_names = append(item_names, ref.name) %}
{% set seen_refids = append(seen_refids, refid_str) %}
{% elif length(items) < max_items %}
{% set items = append(items, ref) %}
{% set seen_refids = append(seen_refids, refid_str) %}
{% if ref.type == "item" %}
{% set item_names = append(item_names, ref.name) %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% if length(items) > 0 %}
## Nearby Objects
{% set grouped_items = group_by(items, "type") %}
{% for type_name, type_items in grouped_items %}
### {{ type_name | capitalize }}
{% for ref in type_items %}
{% set stack = 1 %}
{% if ref.type == "item" %}{% set stack = count(item_names, ref.name) %}{% endif %}
- {{ ref.name }}{% if stack > 1 %} x{{ stack }}{% endif %} ({{ ref.position.meters }}m){% if ref.type == "furniture" %} RefID: {{ ref.formID }}{% endif %}{% if ref.type == "container" and ref.locked %} [locked]{% endif %}{% if ref.type == "furniture" and contains(furniture_taken, "~" + to_string(ref.formID) + ",") %} [in use by you]{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{# Contents of the three nearest containers only: this block renders in every category's drill-down. #}
{% set listed_containers = [] %}
{% for ref in items %}
{% if ref.type == "container" %}
{% set contents = get_container_contents(ref.formID) %}
{% if contents.itemCount > 0 and contents.itemCount <= 30 and length(listed_containers) < 3 %}
{% set listed_containers = append(listed_containers, ref) %}
{% endif %}
{% endif %}
{% endfor %}
{% if length(listed_containers) > 0 %}
## Container Contents
{% for ref in listed_containers %}
{% set contents = get_container_contents(ref.formID) %}
**{{ contents.name }}** ({{ ref.position.meters }}m):{% if ref.locked %} [locked]{% endif %}
{% for item in contents.items %}
{% if item.name and length(item.name) > 0 %}
- {{ item.name }}{% if item.count > 1 %} x{{ item.count }}{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}