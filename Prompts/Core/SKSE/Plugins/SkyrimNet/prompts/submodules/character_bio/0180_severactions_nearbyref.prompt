{% if render_mode == "full" %}
{# Renders in "full" and "static" only — render_mode gate kept inside the
   first 5 lines per SkyrimNet prompt best practice. "action" render mode
   is handled by sibling 0181_severactions_nearbyref_action.prompt, which
   ALSO lists container contents for the action-selection drill-down. We
   deliberately omit container contents here to keep the dialogue and
   general-context payload bounded. Skip during SexLab/OStim — saves tokens. #}
{% if actorUUID and actorUUID != 0 %}
{% set _in_sexlab = get_faction_rank(actorUUID, "SexLabAnimatingFaction") >= 0 %}
{% set _in_ostim = get_faction_rank(actorUUID, "OStimExcitementFaction") >= 0 %}
{% if not _in_sexlab and not _in_ostim %}
## Nearby Objects
{% if actorUUID and isValidActor(actorUUID) %}
{% set nearby_refs = get_nearby_references_for_entity(actorUUID, 1000) %}
{% else %}
{% set nearby_refs = get_nearby_references(1000) %}
{% endif %}
{% set excluded_subtypes = ["clutter", "misc"] %}
{# User-configured exclusions from PrismaUI Settings → Prompt Filters.
   Mirrored from SeverActions_FollowerManager.NearbyExcludedTags property to
   StorageUtil(None, "SeverActions_NearbyExcluded") on init/load. Format is
   comma-separated "type:subtype" tags, e.g. "furniture:bed,item:weapon".
   Wrap with sentinel commas so substring match catches exact tags only. #}
{% set user_excluded_raw = papyrus_util("GetStringValue", "", "SeverActions_NearbyExcluded", "") %}
{% set user_excluded = "," + user_excluded_raw + "," %}
{% set max_items = 20 %}
{% set items = [] %}
{% set seen_refids = [] %}
{% set item_names = [] %}
{% for ref in nearby_refs %}
{% set ref_tag = "," + ref.type + ":" + ref.subtype + "," %}
{% if ref.name != "" and not (ref.subtype in excluded_subtypes) and not contains(user_excluded, ref_tag) %}
{% if not (ref.type == "furniture" and ref.position.meters == 0.0) %}
{% set refid_str = to_string(ref.formID) %}
{% set refid_count = count(seen_refids, refid_str) %}
{% if refid_count < 3 %}
{# Same-name LOOSE ITEMS stack into one line ("Carrot x6") instead of
   crowding out the max_items budget — the listed RefID is the nearest
   one, which is all a pickup action needs (any of the six will do).
   Applies to type "item" ONLY: furniture/containers/doors keep one
   line each (which chair or chest matters; which carrot does not). #}
{% if ref.type == "item" and (ref.name in item_names) %}
{% set item_names = append(item_names, ref.name) %}
{% set seen_refids = append(seen_refids, refid_str) %}
{% elif length(items) < max_items %}
{% set items = append(items, ref) %}
{% set seen_refids = append(seen_refids, refid_str) %}
{% if ref.type == "item" %}
{% set item_names = append(item_names, ref.name) %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% if length(items) > 0 %}
{% set grouped_items = group_by(items, "type") %}
{% for type_name, type_items in grouped_items %}
### {{ type_name | capitalize }}
{% for ref in type_items %}
{% set stack = 1 %}
{% if ref.type == "item" %}{% set stack = count(item_names, ref.name) %}{% endif %}
- {{ ref.name }}{% if stack > 1 %} x{{ stack }}{% endif %} ({{ ref.position.meters }}m) RefID: {{ ref.formID }}{% if ref.type == "container" and ref.locked %} [locked]{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endif %}